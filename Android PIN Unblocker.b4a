Private Sub btnHash_LongClick(HashType As String)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[Main-${LogContextId}] btnHash_LongClick: Sub entry (HashType = ${HashType})"$, Colors.Blue)
	LogColor($"[Main-${LogContextId}] btnHash_LongClick: Now the Admin Key field will be permanently hidden for this App lifecycle"$, Colors.Blue)
	
	LogColor($"[Main-${LogContextId}] btnHash_LongClick: Calling LockdownAdminKeyField to make the Admin Key unrevealable"$, Colors.Blue)
	LockdownAdminKeyField
	
	LogColor($"[Main-${LogContextId}] btnHash_LongClick: Calling btnHash_Click("${HashType}")"$, Colors.Blue)
	btnHash_Click(HashType)
	
	LogColor($"[Main-${LogContextId}] btnHash_LongClick: Sub return"$, Colors.Blue)
End Sub

Private Sub btnHash_Click(HashType As String)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: Sub entry (HashType = ${HashType})"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: Fetching the text to hash from the Admin Key field (sensitive value)"$, Colors.Blue)
	Dim Text As String = edtAdminKey.Text
	
	LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: Hashing the fetched Admin Key text (sensitive value) with ${HashType}"$, Colors.Blue)
	Dim TextHash As String
	
	Try
		TextHash = Cryptography.HashText(Text, HashType)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: No problem found while hashing text with ${HashType}"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: Setting the Admin Key field .Text content with the generated ${HashType} (sensitive value)"$, Colors.Blue)
		edtAdminKey.Text = TextHash
		
	Catch
		LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: There was a problem while hashing text with ${HashType}"$, Colors.Red)
		
		'Don't clear the Admin key text input on failure
		'because it would be a bit harsh to do that
		'just show an exception text in a toast message
		LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: Don't clear the Admin Key field .Text because it would be too harsh (even for showing an exception message)"$, Colors.Red)
		LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: Displaying an exception message in a toast notification instead"$, Colors.Red)
		ToastMessageShow($"Failed to generate ${HashType}"$, Constants.TOAST_DURATION_SHORT)
		
	End Try
	
	'Request running the garbage collector as soon as possible
	'This way old values will be soon cleared from the App's memory
	LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: Requesting a JVM garbage collection as soon as possible to discard this function's old text-related variable contents"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: We do the JVM garbage collection call even if the text hashing was unsuccessful, because atleast the Text variable must be discarded as soon as possible"$, Colors.Blue)
	Security.TriggerJvmGarbageCollection
	
	LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: Now closing the text hashing options menu"$, Colors.Blue)
	btnHashMenu.Checked = False
	
	'Visually bring attention to the Admin key field
	LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: Setting current focused element to the Admin Key field to bring visual attention to it"$, Colors.Blue)
	edtAdminKey.RequestFocus
	
	LogColor($"[${ActivityName}-${LogContextId}] btnHash_Click: Sub return"$, Colors.Blue)
End Sub
'----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- -----
Private Sub btnGenerate_Click
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Sub entry"$, Colors.Blue)
	
	'Reset the Response Code label before generating a new Response Code
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Resetting the Response code label before generating a new Response code"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: If a correct challenge-response algorithm is not found, then this default value stays"$, Colors.Blue)
	lblResponse.Text = "Response:"
	
	'Reset the Response Code field before generating a new Response Code
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Resetting the Response code field .Text before generating a new Response code"$, Colors.Blue)
	edtResponse.Text = ""
	
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Fetching the Challenge code & Admin Key .Text values for sanitization (sensitive values)"$, Colors.Blue)
	Dim SanitizedUserInputs() As String = GetSanitizedUserInputs(edtChallenge.Text, edtAdminKey.Text)
	
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Checking whether the Challenge code & Admin Key values were valid and sanitized"$, Colors.Blue)
	If SanitizedUserInputs(0) == False Then
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The Challenge code and/or Admin Key value(s) were invalid and therefore not returned sanitized"$, Colors.Magenta)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Set the Response code field .Hint value to the reason for why the input(s) were invalid"$, Colors.Magenta)
		edtResponse.Hint = SanitizedUserInputs(1)
		
		'Unfocus the Admin key field when the user clicks Generate (if it was focused)
		'
		'This helps makes the Admin key cursor position Timer run less often,
		'especially useful since after generating the Response codes,
		'the user might take some while to read & copy it on their computer
		'
		'Focus instead on the Response code field (bring visual attention to it)
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Setting the focus on the Response code field to bring visual attention to it"$, Colors.Magenta)
		edtResponse.RequestFocus
		
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Sub return"$, Colors.Magenta)
		Return
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Both the Challenge code & Admin Key values were verified as correct and matching a supported algorithm"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Fetching the sanitized Challenge code & Admin Key values from the return of GetSanitizedUserInputs (sensitive values)"$, Colors.Blue)
	Dim SanitizedChallenge, SanitizedAdminKey As String
	SanitizedChallenge = SanitizedUserInputs(1)
	SanitizedAdminKey  = SanitizedUserInputs(2)
	
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Now we need to determine which challenge-response algorithm to use, running DetectChallengeAlgorithm (sensitive parameters)"$, Colors.Blue)
	Dim DetectedAlgorithm As String = DetectChallengeAlgorithm(SanitizedChallenge, SanitizedAdminKey)
	
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Setting the initial Response code value to empty"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: If generating a response code fails, then this allows displaying the Response code field's .Hint value (where the exception messages are displayed)"$, Colors.Blue)
	Dim ResponseCode As String = ""
	
	Dim SuccessfulOperation As Boolean = True
	
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Checking what was the detected algorithm to use"$, Colors.Blue)
	If DetectedAlgorithm == Cryptography.ALGORITHM_3DES _
	Or DetectedAlgorithm == Cryptography.ALGORITHM_2DES Then
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The detected algorithm is ${DetectedAlgorithm}"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Running the TripleDesEncrypt function for ${DetectedAlgorithm}"$, Colors.Blue)
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The TripleDesEncrypt function supports both 2DES & 3DES"$, Colors.Blue)
		Try
			ResponseCode = Cryptography.TripleDesEncrypt(SanitizedChallenge, SanitizedAdminKey)
		Catch
			SuccessfulOperation = False
		End Try
		
	Else If DetectedAlgorithm == Cryptography.ALGORITHM_AES128 _
	     Or DetectedAlgorithm == Cryptography.ALGORITHM_AES256 Then
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The detected algorithm is ${DetectedAlgorithm}"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Running the AesEncrypt function for ${DetectedAlgorithm}"$, Colors.Blue)
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The AesEncrypt function supports both AES-128 & AES-256"$, Colors.Blue)
		Try
			ResponseCode = Cryptography.AesEncrypt(SanitizedChallenge, SanitizedAdminKey)
		Catch
			SuccessfulOperation = False
		End Try
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: No known algorithm could be detected ${DetectedAlgorithm}"$, Colors.Magenta)
		SuccessfulOperation = False
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Checking if the generated Response code is valid"$, Colors.Blue)
	If Not(SuccessfulOperation) Then
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The generated Response code is invalid"$, Colors.Red)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The Response code field .Text value stays the initial one we have set before at the start of this function"$, Colors.Red)
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Setting the Response code field .Hint value to let the user know about the error"$, Colors.Red)
		edtResponse.Hint = "Failed to compute"
		
		'Unfocus the Admin key field when the user clicks Generate (if it was focused)
		'
		'This helps makes the Admin key cursor position Timer run less often,
		'especially useful since after generating the Response codes,
		'the user might take some while to read & copy it on their computer
		'
		'Focus instead on the Response code field (bring visual attention to it)
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Setting the focus on the Response code field to bring visual attention to it"$, Colors.Red)
		edtResponse.RequestFocus
		
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Sub return"$, Colors.Red)
		Return
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The generated Response code is valid, we can proceed further"$, Colors.Blue)
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Checking if a correct algorithm was detected"$, Colors.Blue)
	If DetectedAlgorithm <> Cryptography.ALGORITHM_UNKNOWN Then
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: A correct algorithm detected"$, Colors.Blue)
		
		'Notice the space between the Response code label
		'and the detected algorithm
		'
		'Otherwise it would give a result such as:
		' - "Response:3DES (DES-EDE3)"
		'
		'What we instead want is a result such as:
		' - "Response: 3DES (DES-EDE3)"
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Updating the Response code label with the detected algorithm ${DetectedAlgorithm}"$, Colors.Blue)
		lblResponse.Text = $"${lblResponse.Text} ${DetectedAlgorithm}"$
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: No correct algorithm was detected"$, Colors.Magenta)
		LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The Response code label .Text value stays the initial one we have set before at the start of this function"$, Colors.Magenta)
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Checking the exact length of the generated Response code"$, Colors.Blue)
	Select ResponseCode.Length
		Case 16
			LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The response code length is 16 chars, setting 4x 4-chars separation on it"$, Colors.Blue)
			ResponseCode =	Regex.Replace2("^([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})$", _
								Regex.CASE_INSENSITIVE, ResponseCode, "$1 $2 $3 $4")
		Case 32
			LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The response code length is 32 chars, setting 8x 4-chars separation on it"$, Colors.Blue)
			ResponseCode =	Regex.Replace2("^([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})$", _
								Regex.CASE_INSENSITIVE, ResponseCode, "$1 $2 $3 $4 $5 $6 $7 $8")
		Case 64
			LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The response code length is 32 chars, setting 16x 4-chars separation on it"$, Colors.Blue)
			
			'First part of the AES-256 response code:
			'Match from the beginning without the end ('$' character)
			'Also add a trailing space to separate the two response code parts
			ResponseCode =	Regex.Replace2("^([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})", _
								Regex.CASE_INSENSITIVE, ResponseCode, "$1 $2 $3 $4 $5 $6 $7 $8 ")
			
			'Second part of the AES-256 response code:
			'Here for the second part match it from the end (no '^' character at the beginning)
			ResponseCode =	Regex.Replace2("([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})$", _
								Regex.CASE_INSENSITIVE, ResponseCode, "$1 $2 $3 $4 $5 $6 $7 $8")
			
		Case Else
			LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: The response code length is not a length supported for setting separation on it yet"$, Colors.Magenta)
			LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Not setting any separation on it, leaving it as-is"$, Colors.Magenta)
			
	End Select
	
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Setting the Response code field .Text value to the generated Response code"$, Colors.Blue)
	edtResponse.Text = ResponseCode
	
	'Unfocus the Admin key field when the user clicks Generate (if it was focused)
	'
	'This helps makes the Admin key cursor position Timer run less often,
	'especially useful since after generating the Response codes,
	'the user might take some while to read & copy it on their computer
	'
	'Focus instead on the Response code field (bring visual attention to it)
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Setting the focus on the Response code field to bring visual attention to it"$, Colors.Blue)
	edtResponse.RequestFocus
	
	LogColor($"[${ActivityName}-${LogContextId}] btnGenerate_Click: Sub return"$, Colors.Blue)
End Sub

'If the inputs are valid then the return is:
'
'String Array = ReturnValue(0) = (Boolean) IsValidInput = True
'               ReturnValue(1) = (String)  SanitizedChallenge
'               ReturnValue(2) = (String)  SanitizedAdminKey
'
'If the inputs are invalid then the return is:
'
'String Array = ReturnValue(0) = (Boolean) IsValidInput = False
'               ReturnValue(1) = (String)  ReasonForWhyInputsAreInvalid
'               <there's no index 2 returned if inputs are invalid>
'
Private Sub GetSanitizedUserInputs(ChallengeCode As String, AdminKey As String) As String()
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Sub entry (sensitive parameters)"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Trimming space and hyphen separators from the Challenge code & Admin Key if any"$, Colors.Blue)
	Dim SanitizedChallenge	As String = ChallengeCode.Replace(" ", "").Replace("-", "")
	Dim SanitizedAdminKey	As String = AdminKey     .Replace(" ", "").Replace("-", "")
	
	'The Admin Key field supports line breaks,
	'so we should also automatically trim them
	'
	'It supports line breaks because it's also
	'used for generating text hashes
	'
	'Some people also write their 3DES Admin Key
	'as 3 separate lines for each DES key too
	LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Trimming line breaks from the Admin Key if any"$, Colors.Blue)
	SanitizedAdminKey = SanitizedAdminKey.Replace(CRLF, "")
	
	LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Checking if any of the trimmed input values are now empty"$, Colors.Blue)
	If SanitizedChallenge == "" Or SanitizedAdminKey == "" Then
		LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Atleast one of the inputs is now empty, returning False validity status & the appropriate invalidity reason"$, Colors.Magenta)
		Return Array As String(False, "Some input(s) are empty")
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Both inputs have been verified as not being empty, verifying if they are valid strings representing Hex bytes"$, Colors.Blue)
	If	Not(Cryptography.IsTextHexBytes(SanitizedChallenge))     _
		Or Not(Cryptography.IsTextHexBytes(SanitizedAdminKey))   _
	Then
		LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Atleast one of the inputs is not a correct string representing Hex bytes, returning False validity status & the appropriate invalidity reason"$, Colors.Magenta)
		Return Array As String(False, "Input(s) must be Hex bytes")
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Both inputs have been verified as being valid strings representing Hex bytes, verifying if they are of correct supported lengths each"$, Colors.Blue)
	'Challenge codes can currently only ever be 16, 32 or 64 chars
	Dim KnownChallengeLength As Boolean =	SanitizedChallenge.Length == 16 Or _
											SanitizedChallenge.Length == 32 Or _
											SanitizedChallenge.Length == 64
	
	'Admin Keys can currenly only ever be 32, 48 or 64 chars
	Dim KnownAdminKeyLength  As Boolean =	SanitizedAdminKey.Length == 32 Or _
											SanitizedAdminKey.Length == 48 Or _
											SanitizedAdminKey.Length == 64
	'Now do the actual verification (much cleaner with two Booleans)
	If Not(KnownChallengeLength) Or Not(KnownAdminKeyLength) Then
		LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Atleast one of the inputs does not have a correct supported length, returning False validity status & the appropriate invalidity reason"$, Colors.Magenta)
		Return Array As String(False, "Unsupported input length(s)")
		
	End If
	
	'Identify Algorithm mismatches between Challenges & Admin keys
	'
	'If using DES-EDE2 the Admin Key will be 32 chars and the challenge 16 chars
	'If using DES-EDE3 the Admin Key will be 48 chars and the challenge 16 chars
	'If using AES-128  the Admin Key and challenge code will be 32 chars each
	'If using AES-256  the Admin Key and challenge code will be 64 chars each
	LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Both inputs have been verified to have correct supported lengths, now checking for Challenge vs. Admin Key algorithm mismatches"$, Colors.Blue)
	'AES-128
	If	SanitizedChallenge.Length == 32 And _		'AES-128 challenge
		SanitizedAdminKey.Length  <> 32 Then		'Not AES-128 Admin Key
		LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Algorithm mismatch detected because the Challenge needs an AES-128 Admin Key but the provided one isn't, returning False validity status & the appropriate invalidity reason"$, Colors.Magenta)
		Return Array As String(False, "Code needs AES-128 key")
		
		'DES-EDE3 / DES-EDE2
	Else If	SanitizedChallenge.Length == 16 And _	'DES-EDE2 or DES-EDE3 challenge
			SanitizedAdminKey.Length  <> 32 And _	'Not DES-EDE2 Admin Key (2DES)
			SanitizedAdminKey.Length  <> 48 Then	'Not DES-EDE3 Admin Key (3DES)
		LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Algorithm mismatch detected because the Challenge needs a 2DES or 3DES Admin Key but the provided one is neither, returning False validity status & the appropriate invalidity reason"$, Colors.Magenta)
		Return Array As String(False, "Code needs 2/3DES key")
		
		'AES-256
	Else If	SanitizedChallenge.Length == 64 And _	'AES-256 challenge
			SanitizedAdminKey.Length  <> 64 Then	'Not AES-256 Admin Key
		LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Algorithm mismatch detected because the Challenge needs an AES-256 Admin Key but the provided one isn't, returning False validity status & the appropriate invalidity reason"$, Colors.Magenta)
		Return Array As String(False, "Code needs AES-256 key")
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: Both inputs have been verified not to be empty, to have correct supported lengths, and no algorithm mismatches"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] GetSanitizedUserInputs: We can return the sanitized Admin Key and Challenge code values now (sensitive values)"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Sub return (returning String(True, <the sanitized Challenge code>, <the sanitized Admin Key>))"$, Colors.Blue)
	Return Array As String(True, SanitizedChallenge, SanitizedAdminKey)
	
End Sub

Private Sub DetectChallengeAlgorithm(SanitizedChallenge As String, SanitizedAdminKey As String) As String
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Sub entry (sensitive parameters)"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: This function takes already sanitized parameters"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Set initial detected algorithm to ${Cryptography.ALGORITHM_UNKNOWN}"$, Colors.Blue)
	Dim DetectedAlgorithm As String = Cryptography.ALGORITHM_UNKNOWN
	
	LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Checking the sanitized Admin Key and Challenge code lengths to determine the correct algorithm"$, Colors.Blue)
	If	SanitizedAdminKey.Length == 48 And SanitizedChallenge.Length == 16 Then
		LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Sanitized Admin Key and Challenge codes are 48 and 16 chars respectively"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Setting the detected algorithm value to ${Cryptography.ALGORITHM_3DES}"$, Colors.Blue)
		DetectedAlgorithm = Cryptography.ALGORITHM_3DES
		
	Else If	SanitizedAdminKey.Length == 32 And SanitizedChallenge.Length == 16 Then
		LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Sanitized Admin Key and Challenge codes are 32 and 16 chars respectively"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Setting the detected algorithm value to ${Cryptography.ALGORITHM_2DES}"$, Colors.Blue)
		DetectedAlgorithm = Cryptography.ALGORITHM_2DES
		
	Else If	SanitizedAdminKey.Length == 32 And SanitizedChallenge.Length == 32 Then
		LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Sanitized Admin Key and Challenge codes are 32 and 32 chars respectively"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Setting the detected algorithm value to ${Cryptography.ALGORITHM_AES128}"$, Colors.Blue)
		DetectedAlgorithm = Cryptography.ALGORITHM_AES128
		
	Else If	SanitizedAdminKey.Length == 64 And SanitizedChallenge.Length == 64 Then
		LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Sanitized Admin Key and Challenge codes are 64 and 64 chars respectively"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Setting the detected algorithm value to ${Cryptography.ALGORITHM_AES256}"$, Colors.Blue)
		DetectedAlgorithm = Cryptography.ALGORITHM_AES256
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Sanitized Admin Key and Challenge code lengths are ${SanitizedAdminKey.Length} and ${SanitizedChallenge.Length} chars respectively"$, Colors.Magenta)
		
		LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Could not detect any suitable challenge-response algorithm"$, Colors.Magenta)
		LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: The detected algorithm value stays the initial value ${DetectedAlgorithm}"$, Colors.Magenta)
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] DetectChallengeAlgorithm: Sub return (returning ${DetectedAlgorithm})"$, Colors.Blue)
	Return DetectedAlgorithm
End Sub

Private Sub edtResponse_FocusChanged(HasFocus As Boolean)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] edtResponse_FocusChanged: Sub entry (HasFocus = ${HasFocus})"$, Colors.Blue)
	
	If HasFocus Then
		LogColor($"[${ActivityName}-${LogContextId}] edtResponse_FocusChanged: HasFocus is True"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] edtResponse_FocusChanged: Set ViewState last focused element to "edtResponse""$, Colors.Blue)
		ViewState_LastFocusedElement = "edtResponse"
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] edtResponse_FocusChanged: HasFocus is False"$, Colors.Blue)
		
		'Android doesn't reset the selection information of
		'EditText fields when the focus is lost
		'
		'So the EditText selection timers call their respective
		'EditText_ShowSelectionInfo method but these functions
		'think that the their EditText selection didn't change
		'
		'To fix this, I just forewarn that the last focused
		'element is "undetermined" and the EditTexts'
		'respective EditText_ShowSelectionInfo methods will
		'verify that their element still has the focus
		'thanks to this forewarning being done in advance
		LogColor($"[${ActivityName}-${LogContextId}] edtResponse_FocusChanged: Set ViewState last focused element to "undetermined" (will be set again properly by the next focused element)"$, Colors.Blue)
		ViewState_LastFocusedElement = "undetermined"
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] edtResponse_FocusChanged: Update neat borders for this EditText field (according to the state of HasFocus = ${HasFocus})"$, Colors.Blue)
	AddBordersToEditText(edtResponse, HasFocus)
	
	'Scroll just a bit (atleast 32dip) below the edtResponse field:
	' - Just so that we get a prettier scroll effect
	' - Don't forget to multiply by the loaded layout's scale too
	LogColor($"[${ActivityName}-${LogContextId}] edtResponse_FocusChanged: Correct the scroll position to be better than Android's default scrolling to focused elements"$, Colors.Blue)
	scvActivity.ScrollPosition = edtResponse.Top + edtResponse.Height + (32dip * LoadedLayout.Scale)
	
	LogColor($"[${ActivityName}-${LogContextId}] edtResponse_FocusChanged: Sub return"$, Colors.Blue)
End Sub

Private Sub btnShareTo_Click
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] btnShareTo_Click: Sub entry"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] btnShareTo_Click: Preparing a Share To Intent for sharing the Response code"$, Colors.Blue)
	Dim ShareIntent As Intent
	ShareIntent.Initialize(ShareIntent.ACTION_SEND, Constants.INTENT_NO_SPECIFIC_TARGET)
	
	ShareIntent.SetType("text/plain")
	ShareIntent.PutExtra("android.intent.extra.TEXT", edtResponse.Text)
	
	ShareIntent.WrapAsIntentChooser("Share the Response code")
	
	LogColor($"[${ActivityName}-${LogContextId}] btnShareTo_Click: Starting the previously prepared Share To Intent to share the Response code"$, Colors.Blue)
	StartActivity(ShareIntent)
	
	LogColor($"[${ActivityName}-${LogContextId}] btnShareTo_Click: Sub return"$, Colors.Blue)
End Sub


