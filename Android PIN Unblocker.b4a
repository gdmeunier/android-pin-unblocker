'
'Custom method for receiving Share To Intents in this Activity
'

#If Java
import android.content.Intent;
import anywheresoftware.b4a.BA;
import anywheresoftware.b4a.objects.IntentWrapper;
import android.content.Context;
import android.app.Activity;
import anywheresoftware.b4a.objects.ActivityWrapper;
public void _onNewIntent(Intent newIntent)
{
	BA.LogInfo("** Activity ("+activityName+") New Intent **");
	BA.LogInfo("["+activityName+"] _onNewIntent: Function entry");
	
	try
	{
		/* The Basic-code Sub "Activity_NewIntent(NewIntent As Intent)"
		 * actually takes an IntentWrapper object, not an Intent one
		 *
		 * This code below is how Basic4Android's core library creates
		 * an IntentWrapper object when you make one in Basic-code
		 */
		IntentWrapper wrappedNewIntent = new IntentWrapper();
		wrappedNewIntent.setObject(newIntent);
		
		// Now we can send this wrapped Intent to our Activity_NewIntent function
		BA.LogInfo("["+activityName+"] _onNewIntent: Calling the custom Activity_NewIntent event Sub");
		
		/*                    Activity,       DontIgnoreIfPaused, EventName,            ThrowErrorIfMissingSub, ParametersObjectArray */
		processBA.raiseEvent2(this._activity, true,               "activity_newintent", false,                  new Object[]{ wrappedNewIntent });
	}
	catch (Exception e)
	{
		/* Nothing to do here */
	}
	
	BA.LogInfo("["+activityName+"] _onNewIntent: Function return");
}
#End If

'
'Commonly used type of inline _onCreate Java code
'
#If Java
import anywheresoftware.b4a.BA;
import android.content.Context;
import android.app.Activity;
#End If
'Hackish method for conditional compile-time Java code
'Only for the special-purpose NO_FLAG_SECURE builds
#If NO_FLAG_SECURE
#If Java
import android.os.Build;
import android.os.CountDownTimer;
import android.content.Intent;
#End If
#End If
#If Java
import android.content.Intent;
import android.content.BroadcastReceiver;
import anywheresoftware.b4a.objects.ActivityWrapper;
import android.content.IntentFilter;
public void _onCreate()
{
	BA.LogInfo("["+activityName+"] _onCreate: Function entry");
	
	// Disable the Activity TitleBar & ActionBar if needed
	BA.LogInfo("["+activityName+"] _onCreate: Checking device display scale...");
	if ( myadvancedInstance.jGetDisplayScale(this) < 1.0 )
	{
		BA.LogInfo("["+activityName+"] _onCreate: Display scale is too small, freeing up some visual space");
		
		BA.LogInfo("["+activityName+"] _onCreate: Disabling the Activity's TitleBar");
		myadvancedInstance.jDisableActivityTitleBar(this);
		
		BA.LogInfo("["+activityName+"] _onCreate: Disabling the Activity's ActionBar (if Android 3.0+)");
		myadvancedInstance.jDisableActivityActionBar(this);
	}
	else
	{
		BA.LogInfo("["+activityName+"] _onCreate: Display scale is OK, no Activity tweaks are necessary");
	}
	
	// Disable the Android 8.0+ Autofill service for security reasons
	myadvancedInstance.jDisableAndroidAutofillService(this);
	
#End If
#If NO_FLAG_SECURE
#If Java
	/* Check if the application was started with a Share To Intent
	 * This guesses whether an Admin key text was shared to this application
	 *
	 * It's currently only used with NO_FLAG_SECURE special-purpose builds
	 */
	boolean isStartedFromShareToIntent = false;
	
	/* We currently only use the isStartedFromShareToIntent check for
	 * displaying security toast notifications in the NO_FLAG_SECURE build,
	 * so no need to run any of the code below if the application was
	 * compiled with FLAG_SECURE (default build):
	 *
	 *  - FLAG_SECURE is the default build configuration and also
	 *    the configuration used for all pre-compiled APK files on
	 *    the GitHub releases page
	 *
	 * And because the security toast notifications that use this
	 * this Share To Intent detection only show during the first Activity launch,
	 * no need to run it more than once per application launch / lifecycle either
	if ( isFirst ) /* Undocumented Basic4Android variable */
	{
		try
		{
			Intent  launchIntent = this.getIntent();
			String  launchAction = launchIntent.getAction();
			boolean hasTextExtra = launchIntent.hasExtra(Intent.EXTRA_TEXT);
			
			if ( launchAction == Intent.ACTION_SEND && hasTextExtra )
			{
				isStartedFromShareToIntent = true;
			}
		}
		catch (Exception e)
		{
			/* Incase we have a botched value */
			isStartedFromShareToIntent = false;
		}
	}
	
	// Check if the application was compiled without FLAG_SECURE and
	// if this is the first-time Activity launch
	if ( isFirst ) /* Undocumented Basic4Android variable */
	{
		/* Warn about the risks of using the NO_FLAG_SECURE build
		 * on Android versions where it's a security risk
		 * 
		 * Don't warn yet on versions where it might not actually be
		 * a problem for the user:
		 *  - API levels 33 and higher (Android 13+ and newer)
		 *  - API levels 14 and lower  (Android 4.0.2 and older)
		 * 
		 * Only the below versions have no other way of disabling
		 * the Recent Apps thumbnails other than using the
		 * FLAG_SECURE window attribute:
		 *  - API levels 15+ up to API level 32 (Android 4.0.3 up to Android 12)
		 */
		if ( Build.VERSION.SDK_INT >= 15 && Build.VERSION.SDK_INT < 33 )
		{
			/* Notify the user about the risks of running a version of
			 * this application without FLAG_SECURE
			 *
			 * If user cannot be warned then exit the application,
			 * better to be safe than sorry (if the toast notification fails)
			 *
			 * Basically the toast notifications must show correctly,
			 * otherwise we exit the application
			 */
			
			/* By default no wait time for the first toast notification,
			 * and only a short wait time for the second one
			 *
			 * Note: The Share To toast notifications are always
			 *       short-lengths notifications,
			 *       so it's OK to just simply add a short duration length
			 */
			int waitTimeForFirstToast  = 0;
			int waitTimeForSecondToast = myadvanced.TOAST_SHORT_DURATION_LENGTH;
			
			/* Do note that we wait a bit before showing the first toast notification,
			 * that's because if the user shares an invalid Admin key text to the application,
			 * the function responsible for handling it will also show a toast notification
			 * 
			 * Then both toasts show at the same time, but most of the time it's
			 * the "Shared Admin key text is invalid" toast notification that wins and
			 * shows ontop of this more important one
			 * 
			 * So we wait until any potential Basic-code toast notification has been
			 * shown on startup before showing the first security-related one
			 */
			if ( isStartedFromShareToIntent )
			{
				/* If started from a Share To Intent with a shared Admin key text inside,
				 * then the wait times are not the same
				 *
				 * Now the first toast notification needs to wait for any
				 * Basic-code toast to finish showing first,
				 * and the second one waits accordingly more too
				 *
				 * Note: The Share To toast notifications are always short-lengths notifications,
				 *       so it's OK to just simply add a short duration length
				 */
				waitTimeForFirstToast  = waitTimeForFirstToast + myadvanced.TOAST_SHORT_DURATION_LENGTH;
				
				// And the second toast notification waits 2x more
				waitTimeForSecondToast = waitTimeForSecondToast + myadvanced.TOAST_SHORT_DURATION_LENGTH;
			}
			
			/* Transfer current context for the onFinish function
			 *
			 * We need not to use the "this" keyword inside the CountDownTimer functions
			 * since it would just be the context of the onFinish function itself
			 */
			Activity ctx = this;
			
			/* The user runs the NO_FLAG_SECURE build of this application
			 * 
			 * The user deserves to be warned about this issue to avoid
			 * any potential trouble with forensic leaks on their device
			 *
			 * Note: If the toast cannot be shown, then the user cannot be warned,
			 *       so we just exit the caller Activity instead for safety reasons
			 */
			new CountDownTimer(waitTimeForFirstToast, 500)
			{
				@Override
				public void onTick(long millisUntilFinished) { }
				
				@Override
				public void onFinish()
				{
					if ( !myadvancedInstance.jToastMessageShow(ctx, "This build of the app is insecure", myadvanced.TOAST_SHORT_DURATION_LENGTH) )
					{
						ctx.finish();
					}
				}
			}.start();
			/*
			 * Wait until the first toast disappears before showing another one
			 *
			 * Note: the 500 number corresponds to a 500ms tick rate,
			 *       which neatly aligns with available toast display durations:
			 *        - 2000ms (short one) and 3500ms (long one)
			 */
			new CountDownTimer(waitTimeForSecondToast, 500)
			{
				@Override
				public void onTick(long millisUntilFinished) { }
				
				@Override
				public void onFinish()
				{
					if ( !myadvancedInstance.jToastMessageShow(ctx, "Admin keys might leak in this build", myadvanced.TOAST_LONG_DURATION_LENGTH) )
					{
						ctx.finish();
					}
				}
			}.start();
		}
	}
#End If
#End If
#If Java
	
	// Make this application Activity secure
	BA.LogInfo("["+activityName+"] _onCreate: Securing this application Activity");
	myadvancedInstance.jSecureActivityOnCreate(this, isFirst);
	
	/* Below is for detecting device idle state, when the display is no longer 'interactive'
	 *  - Display off, screen locked, screensaver, inactivity [...]
	 *
	 * The "_activity" field (of type ActivityWrapper) is not a public field,
	 * so we have to explicitly give an handle to it for our DeviceIdleReceiver
	 *
	 * "DeviceIdleReceiver" is also a class so you must access the
	 * "myadvanced" package (class) directly to get it,
	 * not by accessing the current "myadvancedInstance" of it
	 *
	 * Notice the difference between "myadvanced" & "myadvancedInstance"
	 *  - "myadvanced"         = The class / package itself
	 *  - "myadvancedInstance" = The instance of it that we initialized in this Activity
	 */
	BA.LogInfo("["+activityName+"] _onCreate: Registering the DeviceIdleReceiver");
	this.DeviceIdleDetectionReceiver = new myadvanced.DeviceIdleReceiver(this.processBA, this._activity);
	this.registerReceiver(DeviceIdleDetectionReceiver, myadvancedInstance.jGetDeviceIdleIntentFilter());
	
	BA.LogInfo("["+activityName+"] _onCreate: Function return");
}
#End If

'----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- -----

'
'Basic application code
'

Sub Process_Globals
	'These global variables will be declared once when the application starts
	'These variables can be accessed from all modules
	
	'This Activity's name (class name)
	Dim ActivityName As String = Regex.Replace2("^class .+\.([^\.]+?)$", Regex.CASE_INSENSITIVE, Me.As(String), "$1")
	
	'These constants exist to save space in the source code,
	'so that we don't write these entire texts multiple times
	Private Const DEFAULT_BULLETS_ADMIN_KEY As String = "••••••••••••••••••••••••••••••••••••••••••••••••" 'U+2022
	Private Const DEFAULT_ZEROES_ADMIN_KEY  As String = DEFAULT_BULLETS_ADMIN_KEY.Replace("•", "0")
	
	'
	'ViewState variables
	'
	
	Private ViewState_mnuDirectUnblock_Visible As Boolean
	Private ViewState_mnuAbout_Visible         As Boolean
	
	Private ViewState_edtChallenge_Text            As String
	Private ViewState_edtChallenge_SelectionStart  As Int
	Private ViewState_edtChallenge_SelectionLength As Int
	
	'The Admin Key label is always dynamically updated so it
	'doesn't need to be saved and restored,
	'it will always be up-to-date later anyway with a Timer
	
	Private ViewState_edtAdminKey_Text            As String
	Private ViewState_edtAdminKey_SelectionStart  As Int
	Private ViewState_edtAdminKey_SelectionLength As Int
	
	Private ViewState_chkHideAdminKey_Checked As Boolean
	Private ViewState_chkHideAdminKey_Enabled As Boolean = True 'Sensitive flag
	
	Private ViewState_btnHashMenu_Checked As Boolean
	
	Private ViewState_lblResponse_Text As String
	
	Private ViewState_edtResponse_Text            As String
	Private ViewState_edtResponse_SelectionStart  As Int
	Private ViewState_edtResponse_SelectionLength As Int
	
	Private ViewState_LastFocusedElement As String
	Private ViewState_LastScrollPosition As Int
	
	'
	'General-use process globals
	'
	
	'Convenience constants stored inside this class
	Private Constants As MyConstants
	
	'Better method of managing the App's security
	Private Security As MySecurity
	
	'For getting Phone library functions without bundling the big Phone library
	Private Common As MyCommon
	
	'For generating text hashes & encryption (response codes)
	Private Cryptography As MyCryptography
	
	'Admin Key selection information in Admin Key label
	Private SelectionTimer_edtAdminKey As Timer
	
	'For advanced Java functions that require context
	Private joActivity As JavaObject
	
	'For foreground device rotation detection & misc
	Private LifecycleTracking As MyLifecycleTracking
	
	'For sharing Admin key texts to the application:
	' - (prevent Android from repeatedly re-send its Share To Intents)
	'
	Private PreviousSharedTextTruncatedRehash As String = "" 'Must be Null by default
	
	Private IsFirstApplicationResume As Boolean = True 'True by default
	
	'For the QR code scanner module
	Public Shared_AllowEmptyQRCodeContent As Boolean 'Whether the QR code content was literally empty
	Public Shared_DetectedQRCodeContents  As String
	
End Sub

Sub Globals
	'These global variables will be redeclared each time the activity is created
	
	'Just so that we don't write many Dim statements to declare
	'this variable multiple times in the LoadActivityLayout Sub etc
	Private LoadedLayout As LayoutValues
	
	'For being able to scroll vertically
	Private scvActivity As ScrollView
	
	Private lblChallenge As Label 'For getting its properties to fix btnHashMenuBg's
	Private edtChallenge As EditText
	
	Private lblAdminKey As Label
	Private edtAdminKey As EditText
	
	'For hiding the Admin Key field with explanations about
	'why it's hidden during application pause events
	Private edtDecoyKey As EditText 'It's always visible by default initially
	
	Private chkHideAdminKey As CheckBox
	Private btnHashMenu     As ToggleButton
	
	Private btnHashMenuBg As Button
	Private btnSha256     As Button
	Private btnSha512     As Button
	
	Private lblResponse As Label
	Private edtResponse As EditText
	
End Sub

'----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- -----

'
'Activity events
'

'For detecting screen off / screen locked / sleep mode
'
'On legacy devices such as those running Android 2.3, the application's Activities
'are not paused on e.g. screen lock, so it doesn't fire a resume event either
'
'On such old legacy devices, this function is considered as very important because
'it's their only way of breaking the Activity lifecycle tracking
'and e.g. hiding the Admin key on device screen off then unlock / screen on
Sub Activity_Idle
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Idle: Sub entry"$, Colors.Black)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Idle: This event was fired, so the device is idle (non-interactive UI state)"$, Colors.Black)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Idle: Setting the Hide Admin Key checkbox's ViewState to Checked and resetting the Activity Lifecycle tracking"$, Colors.Black)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Idle: This will make it even quicker to securely hide the Admin Key on slow devices during application resume"$, Colors.Black)
	ViewState_chkHideAdminKey_Checked = True
	LifecycleTracking.ActivityLifecycle = ""
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Idle: Sub return"$, Colors.Black)
End Sub

Sub Activity_Stop()
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Stop: Sub entry"$, Colors.Black)
	
	'Non-standard hack-ish Activity event Subs like this one
	'cannot even use Process_Globals in some cases, and they
	'most of the time cannot access the Activity's local Globals
	'
	'In such non-standard event Subs like this one,
	'always verify everything you fetch from the
	'Process_Globals & Activity Globals to make sure
	'that they are not Null, because they can very well be
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Stop: Checking if this Activity's Lifecycle tracking is initialized..."$, Colors.Black)
	If LifecycleTracking == Null Or Not(LifecycleTracking.IsInitialized) Then
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Stop: This Activity's Lifecycle tracking is NOT initialized"$, Colors.Black)
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Stop: No need to proceed further"$, Colors.Black)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Stop: Sub return"$, Colors.Black)
		Return
		
	End If
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Stop: This Activity's Lifecycle tracking is initialized, alright"$, Colors.Black)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Stop: Now we can proceed further"$, Colors.Black)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Stop: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Black)
	LifecycleTracking.ActivityLifecycle = LifecycleTracking.ActivityLifecycle & LifecycleTracking.STOP
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Stop: New Activity lifecycle tracking value: "$&LifecycleTracking.ActivityLifecycle, Colors.Black)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Stop: Sub return"$, Colors.Black)
End Sub

Sub Activity_Destroy(IsFinishing As Boolean, IsChangingConfigurations As Boolean)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: Sub entry (IsFinishing = ${IsFinishing}, IsChangingConfigurations = ${IsChangingConfigurations})"$, Colors.Black)
	
	If IsFinishing Then
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: Because the Activity is finishing, reset the scroll position to 0dip"$, Colors.Black)
		
		'Reset the ViewState last scroll position on Activity_Destroy,
		'because we cannot do it in Activity_Pause as otherwise
		'it doesn't know how to differenciate whether the pause event
		'is due to a screen rotation or whether it's just a normal one
		'from background app pause & resume
		'
		'Activity_Pause also doesn't know how to identify
		'the Activities' *foreground* app & resumes,
		'as they behave exactly like a normal app pause
		'if it tries to check its UserClosed parameter
		'
		'So this cans only be done in Activity_Destroy,
		'where we 100% confirm that the Activity is being
		'actually destroyed then re-created
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: Resetting the ViewState's last scroll position"$, Colors.Black)
		ViewState_LastScrollPosition = 0dip
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: Checking if this Activity's Lifecycle tracking is initialized..."$, Colors.Black)
	If LifecycleTracking == Null Or Not(LifecycleTracking.IsInitialized) Then
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: This Activity's Lifecycle tracking is NOT initialized"$, Colors.Black)
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: No need to proceed further"$, Colors.Black)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: Sub return"$, Colors.Black)
		Return
		
	End If
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: This Activity's Lifecycle tracking is initialized, alright"$, Colors.Black)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: Now we can proceed further"$, Colors.Black)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: Checking if the Activity is finishing for real..."$, Colors.Black)
	If IsFinishing And Not(IsChangingConfigurations) Then
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: The Activity is finishing for real, no need to update this Activity's Lifecycle tracking"$, Colors.Black)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: Resetting this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Black)
		LifecycleTracking.ActivityLifecycle = ""
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: New Activity lifecycle tracking value: "$&LifecycleTracking.ActivityLifecycle, Colors.Black)
		
		'Don't fully kill the app here because that's how
		'Android works when you share an Admin Key text to
		'the app while it's running
		'
		'Basically Android will kill the previous instance
		'of the app before firing Activity_NewIntent
		'
		'Otherwise if you e.g. write something in the
		'Response code field and want to share that
		'to the app while it's running, the app would
		'fully close itself (app exit)
		'
		'This was the proper way of doing things but
		'Android unfortunately doesn't like this way
		'of doing things, so we don't fully kill
		'the app here; we let Activity_Pause do it
		'when it's appropriate (UserClosed == True)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: Sub return"$, Colors.Black)
		Return
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: The Activity is not finishing for real, alright"$, Colors.Black)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Black)
		LifecycleTracking.ActivityLifecycle = LifecycleTracking.ActivityLifecycle & LifecycleTracking.DESTROY
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: New Activity lifecycle tracking value: "$&LifecycleTracking.ActivityLifecycle, Colors.Black)
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Destroy: Sub return"$, Colors.Black)
End Sub

Sub Activity_Restart()
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Restart: Sub entry"$, Colors.Black)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Restart: Checking if this Activity's Lifecycle tracking is initialized..."$, Colors.Black)
	If LifecycleTracking == Null Or Not(LifecycleTracking.IsInitialized) Then
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Restart: This Activity's Lifecycle tracking is NOT initialized"$, Colors.Black)
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Restart: No need to proceed further"$, Colors.Black)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Restart: Sub return"$, Colors.Black)
		Return
		
	End If
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Restart: This Activity's Lifecycle tracking is initialized, alright"$, Colors.Black)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Restart: Now we can proceed further"$, Colors.Black)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Restart: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Black)
	LifecycleTracking.ActivityLifecycle = LifecycleTracking.ActivityLifecycle & LifecycleTracking.RESTART
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Restart: New Activity lifecycle tracking value: "$&LifecycleTracking.ActivityLifecycle, Colors.Black)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Restart: Sub return"$, Colors.Black)
End Sub

Sub Activity_Start()
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Start: Sub entry"$, Colors.Black)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Start: Checking if this Activity's Lifecycle tracking is initialized..."$, Colors.Black)
	If LifecycleTracking == Null Or Not(LifecycleTracking.IsInitialized) Then
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Start: This Activity's Lifecycle tracking is NOT initialized"$, Colors.Black)
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Start: No need to proceed further"$, Colors.Black)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Start: Sub return"$, Colors.Black)
		Return
		
	End If
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Start: This Activity's Lifecycle tracking is initialized, alright"$, Colors.Black)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Start: Now we can proceed further"$, Colors.Black)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Start: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Black)
	LifecycleTracking.ActivityLifecycle = LifecycleTracking.ActivityLifecycle & LifecycleTracking.START
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Start: New Activity lifecycle tracking value: "$&LifecycleTracking.ActivityLifecycle, Colors.Black)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Start: Sub return"$, Colors.Black)
End Sub

Sub Activity_Create(FirstTime As Boolean)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Sub entry (FirstTime = ${FirstTime})"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Initializing this Activity's Lifecycle tracking if FirstTime..."$, Colors.Blue)
	If FirstTime Then
		LifecycleTracking.Initialize
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Blue)
	LifecycleTracking.ActivityLifecycle = LifecycleTracking.ActivityLifecycle & LifecycleTracking.CREATE
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: New Activity lifecycle tracking value: "$&LifecycleTracking.ActivityLifecycle, Colors.Blue)
	
	'Disabling the Activity TitleBar & ActionBar
	'must be done before adding content to the
	'Activity, so before loading the layout file
	'
	'So the only way to do that properly is to
	'use Java native code & the _onCreate hook
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Load Activity layout"$, Colors.Blue)
	LoadActivityLayout
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Check if it's the FirstTime Activity launch"$, Colors.Blue)
	If FirstTime Then
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: It's the FirstTime Activity launch"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Disable the Admin Key selection timer so that it doesn't tick upon initialization"$, Colors.Blue)
		SelectionTimer_edtAdminKey.Enabled = False
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Initialize the Admin Key selection timer at a tick rate of 100ms"$, Colors.Blue)
		SelectionTimer_edtAdminKey.Initialize("SelectionTimer_edtAdminKey", 100)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Get an initial ViewState with default UI element values by resetting the ViewState"$, Colors.Blue)
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: The layout files don't always contain default UI element values"$, Colors.Blue)
		ResetViewState
		
		'On the first-time Activity create, the default Admin key is not
		'hidden, because hiding the default 48-zeroes key is unnecessary
		'
		'Remember that ResetViewState actually resets the Admin Key field's
		'text content to be 48-zeroes too
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Becausse this is the first-time Activity create, we alter the ViewState of the Hide Admin Key checkbox to be Checked = False"$, Colors.Blue)
		ViewState_chkHideAdminKey_Checked = False
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Initialize the Constants Class (MyConstants class)"$, Colors.Blue)
		Constants.Initialize
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Initialize the Security Class (MySecurity class)"$, Colors.Blue)
		Security.Initialize
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Initialize the Common Class (MyCommon class)"$, Colors.Blue)
		Common.Initialize
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Initialize the Cryptography Class (MyCryptography class)"$, Colors.Blue)
		Cryptography.Initialize
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: It's not the FirstTime Activity launch"$, Colors.Blue)
		
	End If
	
	'The Activity context must always be fresh,
	'so always re-initialize the joActivity JavaObject
	'on every Activity create (not just on FirstTime)
	'
	'This is mandatory for context-dependent functions
	'that receive the Activity context, because they
	'must always have a fresh Activity context handle!
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Initialize the joActivity JavaObject always (not just on FirstTime launch)"$, Colors.Blue)
	joActivity.InitializeContext
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Check if the Android version is 3.0 or newer and if the device display scale is 1.0 or higher"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: If the Android version is 3.0 or newer then it has ActionBar support"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: If the device display scale is 1.0 or higher then it cans display the ActionBar (not hidden)"$, Colors.Blue)
	If Common.GetAndroidApiLevel >= 11 And 1.0 <= joActivity.RunMethod("jGetDisplayScale", Null) Then
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: The device is Android version is 3.0 or newer and the device display scale is 1.0 or higher"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Adding the Direct Unblock menu as icon in the ActionBar"$, Colors.Blue)
		Activity.AddMenuItem3("Direct Unblock", "mnuDirectUnblock", LoadBitmap(File.DirAssets, "USB.png"), True)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Adding the About menu as icon in the ActionBar"$, Colors.Blue)
		Activity.AddMenuItem3("About", "mnuAbout", LoadBitmap(File.DirAssets, "About.png"), True)
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: The device is Android version is older than 3.0 or the device display scale is lower than 1.0"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Adding the Direct Unblock menu as Activity options menu item"$, Colors.Blue)
		Activity.AddMenuItem("Direct Unblock", "mnuDirectUnblock")
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Adding the About menu as Activity options menu item"$, Colors.Blue)
		Activity.AddMenuItem("About", "mnuAbout")
		
	End If
	
	'TEST
	Activity.AddMenuItem("Test Smartcard Service", "mnuTestSmartcardService")
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Calling InitializeActivityLayout to initialize the loaded layout..."$, Colors.Blue)
	InitializeActivityLayout
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Create: Sub return"$, Colors.Blue)
End Sub

Private Sub mnuTestSmartcardService_Click
	
	If Not(joActivity.RunMethod("jDeviceHasUsbOtgSupport", Null)) Then
		Msgbox2Async($"Your phone does not have USB-OTG support:
Not possible to proceed further without USB host-mode / OTG support on your phone"$, "Test Smartcard Service", "", "Cancel", "", Application.Icon, True)
		Return
		
	End If
	
	'CallerBundle(0) = Caller       - Object
	'CallerBundle(1) = SubName      - String
	'CallerBundle(2) = Parameters() - Object()
	Dim CallerBundle() As Object = Array As Object( _
		Me, _
		"mnuTestSmartcardService", _
		Array As Object() _
	)
	
	CallSubDelayed3(Smartcard, "Service_Message", Smartcard.DO_CCID_DIAGNOSTICS, CallerBundle)
	Wait For Smartcard_mnuTestSmartcardService_Completed(IsSucessful As Boolean, ResponseBundle() As Object)
	
	Msgbox2Async($"Here's what I received about CCID diagnostics from the Smartcard Service:
----- Reply success status is: -----
${IsSucessful}

----- Response data is: -----
${ResponseBundle(0)}"$, "Test Smartcard Service", "Try Sending APDU", "Cancel", "", Application.Icon, True)
	Wait For Msgbox_Result(Result As Int)
	
	If Result <> DialogResponse.POSITIVE Then
		Return
	End If
	
	'
	'Now try sending an APDU to the card
	'
	
	'Test applet selection APDU just to see if sending APDUs works
	CallerBundle = Array As Object( _
		Me, _
		"mnuTestSmartcardService", _
		Array As Object( _
			"00 A4 04 00 07 A0 00 00 00 03 00 00 00" _
		) _
	)
	
	CallSubDelayed3(Smartcard, "Service_Message", Smartcard.SEND_APDU, CallerBundle)
	Wait For Smartcard_mnuTestSmartcardService_Completed(IsSucessful As Boolean, ResponseBundle() As Object)
	
	Msgbox2Async($"Here's what I received about sending an APDU from the Smartcard Service:
----- APDU I sent to the card: -----
00 A4 04 00 07 A0 00 00 00 03 00 00 00

----- Reply success status is: -----
${IsSucessful}

----- Response data is: -----
${ResponseBundle(0)}"$, "Test Smartcard Service", "Close", "", "", Application.Icon, True)
	Wait For Msgbox_Result(Result As Int)
	
	StopService(Smartcard)
	
End Sub

Private Sub LoadActivityLayout
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Sub entry"$, Colors.Blue)
	
	'Note: you cannot use any of this Activity's
	'helper classes here
	'
	'Its classes have not been initialized yet
	'when this function is called by Activity_Create
	'
	'However you can create your own temporary ones
	
	'Load the base layout (contains a ScrollView)
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Loading the base Activity layout which contains a ScrollView only..."$, Colors.Blue)
	Activity.LoadLayout("Base")
	
	'Initialize the ScrollView
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Initializing the Activity's ScrollView"$, Colors.Blue)
	scvActivity.Initialize(Activity.Height) 'Default initial height for its Panel
	scvActivity.Height = Activity.Height    'Must set an explit height on the ScrollView
	scvActivity.Width  = Activity.Width     'Must set an explit width on the ScrollView
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: scvActivity height = ${scvActivity.Height} & width = ${scvActivity.Width}"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Activity height = ${Activity.Height} & width = ${Activity.Width}"$, Colors.Blue)
	
	'Initialize the ScrollView panel
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Initializing the Activity ScrollView's inner panel"$, Colors.Blue)
	scvActivity.Panel.Initialize("scvActivityPanel")
	scvActivity.Panel.Height = scvActivity.Height 'Must set an height before loading layouts
	scvActivity.Panel.Width  = scvActivity.Width  'Must set a width before loading layouts
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: scvActivity Panel height = ${scvActivity.Panel.Height} & width = ${scvActivity.Panel.Width}"$, Colors.Blue)
	
	'Load the Activity layout into the ScrollView's panel
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Loading the Main Activity layout into **the ScrollView's inner panel**"$, Colors.Blue)
	LoadedLayout = scvActivity.Panel.LoadLayout("Main")
	
	'Check which layout was loaded (which layout variant)
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: The loaded layout variant is ${LoadedLayout.Width}x${LoadedLayout.Height}, scale = ${LoadedLayout.Scale}"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Applying variant-specific layout fixes and tweaks to this Activity layout..."$, Colors.Blue)
	
	Dim LeftMargin, TopMargin, RightMargin, BottomMargin As Int
	Dim ActivityMargins() As Int
	
	If LoadedLayout.Width == 320 And LoadedLayout.Height == 480 And LoadedLayout.Scale == 1 Then
		'320x480, scale = 1 (160dpi)
		
		'Each layout variant declares its own Activity margins
		LeftMargin   = 16dip * LoadedLayout.Scale
		TopMargin    = 16dip * LoadedLayout.Scale
		RightMargin  = 16dip * LoadedLayout.Scale
		BottomMargin = 32dip * LoadedLayout.Scale
		
		'[0] Left, [1] Top, [2] Right, [3] Bottom
		LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Setting Activity margins to left(${(LeftMargin / 1dip).As(Int)}dip), top(${(TopMargin / 1dip).As(Int)}dip), right(${(RightMargin / 1dip).As(Int)}dip) & bottom(${(BottomMargin / 1dip).As(Int)}dip)"$, Colors.Blue)
		ActivityMargins = Array As Int(LeftMargin, TopMargin, RightMargin, BottomMargin)
		
		LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Calling FixVariantSpecificLayouts with the Activity margins & bottom-most element edtResponse"$, Colors.Blue)
		FixVariantSpecificLayouts(ActivityMargins, edtResponse)
		
	Else If LoadedLayout.Width == 480 And LoadedLayout.Height == 320 And LoadedLayout.Scale == 1 Then
		'480x320, scale = 1 (160dpi)
		
		LeftMargin   = 16dip * LoadedLayout.Scale
		TopMargin    = 16dip * LoadedLayout.Scale
		RightMargin  = 16dip * LoadedLayout.Scale
		BottomMargin = 32dip * LoadedLayout.Scale
		
		'[0] Left, [1] Top, [2] Right, [3] Bottom
		LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Setting Activity margins to left(${(LeftMargin / 1dip).As(Int)}dip), top(${(TopMargin / 1dip).As(Int)}dip), right(${(RightMargin / 1dip).As(Int)}dip) & bottom(${(BottomMargin / 1dip).As(Int)}dip)"$, Colors.Blue)
		ActivityMargins = Array As Int(LeftMargin, TopMargin, RightMargin, BottomMargin)
		
		LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Calling FixVariantSpecificLayouts with the Activity margins & bottom-most element btnSha512"$, Colors.Blue)
		FixVariantSpecificLayouts(ActivityMargins, btnSha512)
		
	Else If LoadedLayout.Width == 240 And LoadedLayout.Height == 320 And LoadedLayout.Scale == 0.75 Then
		'240x320, scale = 0.75 (120dpi)
		
		LeftMargin   = 16dip * LoadedLayout.Scale
		TopMargin    = 16dip * LoadedLayout.Scale
		RightMargin  = 16dip * LoadedLayout.Scale
		BottomMargin = 32dip * LoadedLayout.Scale
		
		'[0] Left, [1] Top, [2] Right, [3] Bottom
		LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Setting Activity margins to left(${(LeftMargin / 1dip).As(Int)}dip), top(${(TopMargin / 1dip).As(Int)}dip), right(${(RightMargin / 1dip).As(Int)}dip) & bottom(${(BottomMargin / 1dip).As(Int)}dip)"$, Colors.Blue)
		ActivityMargins = Array As Int(LeftMargin, TopMargin, RightMargin, BottomMargin)
		
		LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Calling FixVariantSpecificLayouts with the Activity margins & bottom-most element edtResponse"$, Colors.Blue)
		FixVariantSpecificLayouts(ActivityMargins, edtResponse)
		
	Else If LoadedLayout.Width == 320 And LoadedLayout.Height == 240 And LoadedLayout.Scale == 0.75 Then
		'320x240, scale = 0.75 (120dpi)
		
		LeftMargin   = 16dip * LoadedLayout.Scale
		TopMargin    = 16dip * LoadedLayout.Scale
		RightMargin  = 16dip * LoadedLayout.Scale
		BottomMargin = 32dip * LoadedLayout.Scale
		
		'[0] Left, [1] Top, [2] Right, [3] Bottom
		LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Setting Activity margins to left(${(LeftMargin / 1dip).As(Int)}dip), top(${(TopMargin / 1dip).As(Int)}dip), right(${(RightMargin / 1dip).As(Int)}dip) & bottom(${(BottomMargin / 1dip).As(Int)}dip)"$, Colors.Blue)
		ActivityMargins = Array As Int(LeftMargin, TopMargin, RightMargin, BottomMargin)
		
		LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Calling FixVariantSpecificLayouts with the Activity margins & bottom-most element btnSha512"$, Colors.Blue)
		FixVariantSpecificLayouts(ActivityMargins, btnSha512)
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Adding some neat borders to the EditText fields"$, Colors.Blue)
	For Each MyEditText As EditText In Array As EditText(edtChallenge, edtAdminKey, edtDecoyKey, edtResponse)
		AddBordersToEditText(MyEditText, False) 'HasFocus = False
	Next
	
	'Add the ScrollView itself to the Activity View (must be done explicitly)
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Adding the ScrollView's View to the Activity (must be done explicitly in code)"$, Colors.Blue)
	Activity.AddView(scvActivity, 0, 0, scvActivity.Width, scvActivity.Height)
	
	LogColor($"[${ActivityName}-${LogContextId}] LoadActivityLayout: Sub return"$, Colors.Blue)
End Sub

Private Sub FixVariantSpecificLayouts(ActivityMargins() As Int, BottomMostElement As View)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Sub entry"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: ActivityMargins = { Left: ${(ActivityMargins(0) / 1dip).As(Int)}dip, Top: ${(ActivityMargins(1) / 1dip).As(Int)}dip, Right: ${(ActivityMargins(2) / 1dip).As(Int)}dip, Bottom: ${(ActivityMargins(3) / 1dip).As(Int)}dip }"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Initializing a temporary copy of the MyCommon class..."$, Colors.Blue)
	Dim TempCommon As MyCommon
	TempCommon.Initialize
	
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Initializing a temporary JavaObject with this Activity's current context..."$, Colors.Blue)
	Dim TempJavaObject As JavaObject
	TempJavaObject.InitializeContext
	
	'Get the software navigation bar width
	'Returns 0 on devices that don't have one
	'
	'This function directly returns the raw
	'pixels count (not a dip-pixel value)
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Getting software navbar visibility status and device display scale..."$, Colors.Blue)
	Dim SoftwareNavBarWidth As Int   = TempJavaObject.RunMethod("jGetSoftwareNavBarWidth", Null)
	Dim DisplayScale        As Float = TempJavaObject.RunMethod("jGetDisplayScale", Null)
	
	'Correct the ScrollView inner panel's height to add
	'the layout's variant-specific bottom margin
	'
	'It's computed based on the below formula:
	'  - Bottom-most element's Top + Height + desired bottom margin:
	'    Here it's edtResponse / btnShareTo that are the bottom-most ones
	'
	'[0] Left, [1] Top, [2] Right, [3] Bottom
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Setting the ScrollView's inner panel height to bottom-most element's top(${(BottomMostElement.Top / 1dip).As(Int)}dip) + height(${(BottomMostElement.Height / 1dip).As(Int)}dip) and the layout's bottom margin(${(ActivityMargins(3) / 1dip).As(Int)}dip) too"$, Colors.Blue)
	scvActivity.Panel.Height = BottomMostElement.Top + BottomMostElement.Height + ActivityMargins(3)
	
	'Fix the ScrollView panel's height if it was created
	'but not given the proper height automatically
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: The ScrollView's panel should always fully cover the Activity view, so that modal background shades fully cover the screen"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Checking if the ScrollView's inner panel is somehow smaller than the Activity view's height..."$, Colors.Blue)
	If scvActivity.Panel.Height < Activity.Height Then
		LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: The ScrollView's inner panel height is somehow smaller than the Activity view height"$, Colors.Magenta)
		
		LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Increasing the ScrollView's inner panel height to match the Activity view height"$, Colors.Magenta)
		scvActivity.Panel.Height = Activity.Height
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: The ScrollView's inner panel height is equal or greater than the Activity view's height"$, Colors.Blue)
		LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Alright, so no need to fix its height"$, Colors.Blue)
		
	End If
	
	'Fix the Hash Text menu background to also fully cover the screen
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Setting the Hash Text menu's modal background dimensions to fully cover the ScrollView's inner panel"$, Colors.Blue)
	btnHashMenuBg.Height = scvActivity.Panel.Height
	
	'Correct the Hash Text menu background's text padding
	'
	' - |--------------- Activity landscape layout ---------------|
	'   |                                                         |
	'   | /* Hash Text menu background text */                    | <-- Text aligned to top
	'   |                                                         |   | /* margin-bottom spacing */
	'   | [chkHideAdminKey] [-----btnGenerate-----] [btnHashMenu] | <-- Top of btnHashMenu
	'   |                                                         |   | /* ScrollView panel's bottom padding */
	'   |---------------------------------------------------------| <-- ScrollView panel bottom
	'
	'[0] Left, [1] Top, [2] Right, [3] Bottom
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Computing the maximum display width without including the left(${(ActivityMargins(0) / 1dip).As(Int)}dip) & right(${(ActivityMargins(2) / 1dip).As(Int)}dip) margins"$, Colors.Blue)
	Dim MaxPanelNetWidth  As Int = scvActivity.Panel.Width - (ActivityMargins(0) + ActivityMargins(2))
	
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Computing the net visual height taken by the Hash Text menu background's info text"$, Colors.Blue)
	Dim TextDisplayHeight As Int = TempCommon.GetTextDisplayHeight(btnHashMenuBg.Text, btnHashMenuBg.TextSize, MaxPanelNetWidth, SoftwareNavBarWidth, DisplayScale)
	
	'We have to also account for the vertical text size and when
	'the text is long such that it gets wrapped in line breaks
	'
	'[0] Left, [1] Top, [2] Right, [3] Bottom
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Pushing the Hash Text menu background's info text so that it's exactly ${(ActivityMargins(3) / 1dip).As(Int)}dip (the bottom margin) above the Hash Text menu button when also including with the text visual height"$, Colors.Blue)
	Dim HashMenuBgTopMargin As Int = btnHashMenu.Top - ActivityMargins(3) - TextDisplayHeight
	btnHashMenuBg.Padding = Array As Int( _
		ActivityMargins(0),  _ '[0] Left,
		HashMenuBgTopMargin, _ '[1] Top,
		ActivityMargins(2),  _ '[2] Right,
		ActivityMargins(3)   _ '[3] Bottom
	)
	
	LogColor($"[${ActivityName}-${LogContextId}] FixVariantSpecificLayouts: Sub return"$, Colors.Blue)
End Sub

Private Sub AddBordersToEditText(EditText As EditText, HasFocus As Boolean)
	'
	'Add some neat borders to the EditTExt fields
	'
	
	'Unfocused state (default)
	Dim BackgroundColor As Int = Colors.ARGB((20 * 255) / 100, 0x87, 0x87, 0x87) 'Using a transparency percentage
	
	If HasFocus Then
		'If the focused-state version is needed,
		'then change the color to cyan borders
		BackgroundColor = Colors.ARGB((50 * 255) / 100, 0x00, 0xCC, 0xFF) 'Using a transparency percentage
		
	End If
	
	Dim BackgroundDrawable As ColorDrawable
	BackgroundDrawable.Initialize2(Colors.Transparent, 2dip, 2dip, BackgroundColor)
	
	EditText.Background = BackgroundDrawable
	
End Sub

Private Sub ResetViewState
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] ResetViewState: Sub entry"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] ResetViewState: Setting the ViewState last focused element to "edtChallenge""$, Colors.Blue)
	ViewState_LastFocusedElement = "edtChallenge"
	
	LogColor($"[${ActivityName}-${LogContextId}] ResetViewState: Setting the ViewState last scroll position to 0"$, Colors.Blue)
	ViewState_LastScrollPosition = 0
	
	LogColor($"[${ActivityName}-${LogContextId}] ResetViewState: Setting initial values for EditText fields"$, Colors.Blue)
	ViewState_edtChallenge_Text = ""
	ViewState_edtAdminKey_Text  = DEFAULT_ZEROES_ADMIN_KEY
	ViewState_edtResponse_Text  = ""
	
	LogColor($"[${ActivityName}-${LogContextId}] ResetViewState: Setting initial values for text labels"$, Colors.Blue)
	ViewState_lblResponse_Text = "Response:"
	
	'The layout file for Main has the Admin Key field revelaed by default,
	'and the Hide Admin Key checkbox in unchecked state by default,
	'so reset their ViewStates to safer values
	'
	'Note: Don't directly set the safer values in the layout file,
	'      because otherwise Android will not fire 'duplicate' events
	'      for setting UI element properties, and it's a bit of a hell otherwise
	'      to correctly set properties such as e.g. the Admin Key field's .Hint value
	'
	'       - (I mean e.g. the bullet-dots versus 48-zeroes EditText Hint)
	'
	'      If you do this anyway, then you need to adapt Activity_Create to:
	'       - Uncheck the Hide Admin Key checkbox on FirstTime create,
	'         rather than check it
	'
	'      You need to then adapt Activity_Resume to
	'       - Reveal the Admin Key field on first Activity resume,
	'         rather than hide it if it's not the first Activity resume
	'
	'      Finally, you need to then manually fix the EditTexts' .Hint values
	'      on every Activity resume, if you again set safer values in the layout files,
	'      which you should *not* do, even if you think that it's *safer*:
	'       - It will cause more problems for you to manage the UI state than
	'         the safety it would afford, and it might cause you to accidentally
	'         introduce bugs with safety-related consequences
	'
	LogColor($"[${ActivityName}-${LogContextId}] ResetViewState: Setting initial states for checkboxes & menu buttons"$, Colors.Blue)
	ViewState_chkHideAdminKey_Checked = True
	ViewState_btnHashMenu_Checked     = False
	
	LogColor($"[${ActivityName}-${LogContextId}] ResetViewState: Sub return"$, Colors.Blue)
End Sub

Private Sub InitializeActivityLayout
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] InitializeActivityLayout: Sub entry"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] InitializeActivityLayout: Set the Activity layout title to the application name"$, Colors.Blue)
	Activity.Title = Application.LabelName
	
	LogColor($"[${ActivityName}-${LogContextId}] InitializeActivityLayout: Harden this Activity's EditTexts to prevent Android from leaking sensitive information"$, Colors.Blue)
	HardenActivityEditTexts(Constants.EDITTEXT_NO_SPECIFIC_ONE, Null)
	
	'Currently only the Admin Key field has a monospace font
	LogColor($"[${ActivityName}-${LogContextId}] InitializeActivityLayout: Fix this Activity's EditTexts that have a monospace font to stay monospace on older Android versions"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] InitializeActivityLayout: Otherwise some older Android devices see these EditTexts as not being monospace"$, Colors.Blue)
	FixMonospaceEditTexts(Constants.EDITTEXT_SPECIFIC_ONE, edtAdminKey)
	
	LogColor($"[${ActivityName}-${LogContextId}] InitializeActivityLayout: Sub return"$, Colors.Blue)
End Sub

Private Sub HardenActivityEditTexts(WantsToHardenASpecificOne As Boolean, WhichOneIfYes As EditText)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Sub entry"$, Colors.Blue)
	
	'Caller sanity check:
	'If you want a specific one, then don't say a "Null" one
	LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Checking if the caller is "sane" (if what they ask for is logical)"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Checking whether the caller requested a specific EditText to harden but says that it's "Null""$, Colors.Blue)
	If WantsToHardenASpecificOne And WhichOneIfYes == Null Then
		'Caller is confused about what it wants
		'Not doing anything in such cases
		LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: The caller is illogical, providing illogical parameters to this function"$, Colors.Magenta)
		LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: The caller asks us to harden a specific EditText then gives "Null""$, Colors.Magenta)
		LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Since the caller is asking for an illogical thing, we just cannot proceed further"$, Colors.Magenta)
		
		LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Sub return"$, Colors.Magenta)
		Return
		
	End If
	LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Sanity check completed, the caller is logical (good news!)"$, Colors.Blue)
	
	'Create a list of EditTexts to harden
	LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Creating a list of EditTexts to harden (currently empty)"$, Colors.Blue)
	Dim EditTextsToHarden() As EditText
	
	LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Checking if the caller wants to harden a specific EditText"$, Colors.Blue)
	If WantsToHardenASpecificOne Then
		LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Caller wants to harden a specific EditText"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Adding only the specified EditText to our list"$, Colors.Blue)
		EditTextsToHarden = Array As EditText(WhichOneIfYes)
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Caller wants to harden any & all EditTexts in this Activity (no specific one)"$, Colors.Blue)
		
		'Even the decoy Admin key field too
		'
		'For hiding the Admin key field with explanations
		'about why it's hidden during app pause events
		LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Adding all this Activity's EditTexts to our list"$, Colors.Blue)
		EditTextsToHarden = Array As EditText(edtChallenge, edtAdminKey, edtDecoyKey, edtResponse)
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Hardening the security of the EditText fields in our completed list"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: This includes disabling autocomplete, autocorrect, fullscreen keyboard etc"$, Colors.Blue)
	For Each MyEditText As EditText In EditTextsToHarden
		'First the ones that modify the InputType
		'Then the ones that modify the ImeOptions
		'
		'Changing the InputType will clear the ImeOptions
		'So do the ImeOptions changes after the InputType ones
		'
		'There are actually mitigations for this in the
		'MySecurity class's Java native functions
		
		Security.DisableAutoCorrect(MyEditText)               'inputType
		Security.DisableAutoComplete(MyEditText)              'inputType
		Security.DisableAutoSuggestions(MyEditText)           'inputType
		Security.DisableTextConversionSuggestions(MyEditText) 'inputType
		Security.DisableTextSelectionSuggestions(MyEditText)  'inputType
		Security.DisableFullscreenKeyboard(MyEditText)   'imeOptions
		Security.DisablePersonalizedLearning(MyEditText) 'imeOptions
		
		LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: An EditText found in the list has been hardened"$, Colors.Blue)
	Next
	
	LogColor($"[${ActivityName}-${LogContextId}] HardenActivityEditTexts: Sub return"$, Colors.Blue)
End Sub

Private Sub FixMonospaceEditTexts(WantsToFixASpecificOne As Boolean, WhichOneIfYes As EditText)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Sub entry"$, Colors.Blue)
	
	'Caller sanity check:
	'If you want a specific one, then don't say a "Null" one
	LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Checking if the caller is "sane" (if what they ask for is logical)"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Checking whether the caller requested a specific EditText to fix but says that it's "Null""$, Colors.Blue)
	If WantsToFixASpecificOne And WhichOneIfYes == Null Then
		'Caller is confused about what it wants
		'Not doing anything in such cases
		LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: The caller is illogical, providing illogical parameters to this function"$, Colors.Magenta)
		LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: The caller asks us to fix a specific EditText then gives "Null""$, Colors.Magenta)
		LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Since the caller is asking for an illogical thing, we just cannot proceed further"$, Colors.Magenta)
		
		LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Sub return"$, Colors.Magenta)
		Return
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Sanity check completed, the caller is logical (good news!)"$, Colors.Blue)
	
	'Create a list of EditTexts to harden
	LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Creating a list of EditTexts to fix (currently empty)"$, Colors.Blue)
	Dim EditTextsToFix() As EditText
	
	LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Checking if the caller wants to fix a specific EditText"$, Colors.Blue)
	If WantsToFixASpecificOne Then
		LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Caller wants to fix a specific EditText"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Adding only the specified EditText to our list"$, Colors.Blue)
		EditTextsToFix = Array As EditText(WhichOneIfYes)
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Caller wants to fix any & all EditTexts in this Activity (no specific one)"$, Colors.Blue)
		
		'edtDecoyKey is also included if we need to fix *all* the EditTexts
		LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Adding all this Activity's EditTexts to our list"$, Colors.Blue)
		EditTextsToFix = Array As EditText(edtChallenge, edtAdminKey, edtDecoyKey, edtResponse)
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Correcting the monospace EditTexts in our completed list to always stay monospace"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: On older Android versions such as 2.x they are otherwise not monospace"$, Colors.Blue)
	For Each MyEditText As EditText In EditTextsToFix
		
		Common.ForceCorrectMonospaceFont(MyEditText)
		
		'Correcting the monospace EditTexts to also have proper monospace digits
		'On Android 5.0+ the monospace EditTexts don't have proper monospace digits otherwise
		Common.ForceCorrectMonospaceFontDigits(MyEditText)
		
		LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: An EditText found in the list has been fixed"$, Colors.Blue)
	Next
	
	LogColor($"[${ActivityName}-${LogContextId}] FixMonospaceEditTexts: Sub return"$, Colors.Blue)
End Sub

Sub Activity_Resume
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Sub entry"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Stopping this Activity's Lifecycle reset Timer for foreground rotation detection"$, Colors.Blue)
	LifecycleTracking.LifecycleClearingThread_Stop
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Blue)
	LifecycleTracking.ActivityLifecycle = LifecycleTracking.ActivityLifecycle & LifecycleTracking.RESUME
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: New Activity lifecycle tracking value: "$&LifecycleTracking.ActivityLifecycle, Colors.Blue)
	
	'
	'Moved RestoreViewState further down for security reasons
	'
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Checking if we received a QR code result from the Scan Activity"$, Colors.Blue)
	If Shared_DetectedQRCodeContents <> "" Or Shared_AllowEmptyQRCodeContent Then
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: We received a QR code result from the Scan Activity"$, Colors.Blue)
		
		'Before we restore the ViewState later, you have to first
		'alter it so that edtChallenge's text gets correctly
		'restored incase since received QR code contents
		'before the ViewState will actually get restored
		'
		'This is because this Activity's EditTexts don't have
		'a realtime ViewState saving on every text change,
		'as this would be unnecessarily performance-heavy
		'
		'Their last-focused-element ViewState though is indeed
		'saved in realtime whenever it changes (no need to alter it)
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Altering the Challenge code field's ViewState .Text to have the QR code content on ViewState restore (sensitive value)"$, Colors.Blue)
		ViewState_edtChallenge_Text = Shared_DetectedQRCodeContents
		
		'Clear the variable after use to prevent
		'repeated setting on the QR code content
		'on every Activity resume
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Resetting shared QR code information registers for the next use"$, Colors.Blue)
		Shared_DetectedQRCodeContents  = ""
		Shared_AllowEmptyQRCodeContent = False
		
		'Now focus on the Challenge code field to
		'bring visual attention to it
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Setting the ViewState's last focused element to the Challenge code field now to bring visual attention to it on ViewState restore"$, Colors.Blue)
		ViewState_LastFocusedElement = "edtChallenge"
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: We didn't receive any QR code result from the Scan Activity"$, Colors.Blue)
		
	End If
	
	'For always hiding the Admin Key when switching apps
	'such as pausing this App to use another one,
	'then coming back to this App
	'
	'This prevents accidental showing of Admin Key texts
	'incase the user forgot that the Admin Key text was
	'not hidden when they paused the App prior
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Checking if this is not the first Activity resume in this App lifecycle"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Also checking if this Activity resume was not just a screen rotation or foregroud pause"$, Colors.Blue)
	If Not(IsFirstApplicationResume) And Not(LifecycleTracking.WasForegroundRotation(LifecycleTracking.ActivityLifecycle)) And Not(LifecycleTracking.WasForegroundPause(LifecycleTracking.ActivityLifecycle)) Then
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: It's not the first-time Activity resume for this App lifecycle"$, Colors.Blue)
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: It's also not due to a foreground device screen orientation change nor a foreground pause"$, Colors.Blue)
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: So we want to hide the Admin Key field always to prevent accidental exposure in sensitive environments"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Setting the Hide Admin Key field's .Checked state to True"$, Colors.Blue)
		chkHideAdminKey.Checked = True
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: This is either the first-time Activity resume for this app lifecycle..."$, Colors.Blue)
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Or it's just a device screen rotation event while is app is in the foreground anyway, or a foreground-only app pause & resume"$, Colors.Blue)
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: We don't need to specifically hide the Admin Key field in such cases"$, Colors.Blue)
		
	End If
	
	'Restore the ViewState only after having first set the
	'Hide Admin Key checkbox to Checked if needed
	'
	'This prevents potential milliseconds-leaks of the
	'Admin key texts in app background pause & resume scenarios
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Restore ViewState"$, Colors.Blue)
	RestoreViewState
	
	'Something to do on app resume (only after restoring ViewState):
	'Show the Admin key text (using the Visible property)
	'
	'This is how preventing potential milliseconds-leaks works
	'in this application, to avoid having the key seen until
	'we confirm that it's allowed to be visible
	'
	'It's allowed to be visible only once we have properly
	'restored its PasswordMode property (incase it was hidden),
	'and after we confirmed that we did the forced
	'Admin key hiding in cases of application background-pause & resume
	'
	'It was set to invisible by Activity_Pause as a security precaution
	'against short milliseconds-wise Admin key leaks (visual leaks)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Restore Admin Key field visibility to Visible"$, Colors.Blue)
	edtAdminKey.Visible = True
	
	'Hide the decoy Admin key field after it's safe to hide it
	'(The ViewState successfully completed, and its synchronous now)
	'
	' - This decoy EditText field is used for hiding
	'   theAdmin key field with explanation about
	'   why it's hidden (during app pauses)
	'
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Reset decoy Admin Key field visibility back to invisible"$, Colors.Blue)
	edtDecoyKey.Visible = False
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Checking if an Admin key text was shared to the application..."$, Colors.Blue)
	CheckIfAdminKeySharedToTheApp(Activity.GetStartingIntent)
	
	'This part as always near the end of this function
	If IsFirstApplicationResume Then
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: This was the first Activity_Resume event"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Setting IsFirstActivityResume to False to so that next time we know it won't be the first Activity_Resume"$, Colors.Blue)
		IsFirstApplicationResume = False
		
	End If
	
	'Android wants to play boss with our application's focus management,
	'so we teach it a bit of a lesson by bypassing its obnoxious automatic
	'focus on the Activity View's first UI element
	'
	' - (Android does this right after Activity_Resume returns)
	'
	'This actually schedules a call 100ms caller, after Android deliberately
	'sabotaged our preferred last-focused-element restore,
	'then this will automatically correct Android's obnoxious mistake
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Calling the Hotfix function ForceRestoreCorrectLastFocusedElementState because Android is obnoxious with its default focus management with ScrollViews"$, Constants.COLORS_ORANGE)
	ForceRestoreCorrectLastFocusedElementState(ViewState_LastFocusedElement)
	
	'This part as the very last one of this function
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Resetting this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Blue)
	LifecycleTracking.ActivityLifecycle = ""
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: New Activity lifecycle tracking value: "$&LifecycleTracking.ActivityLifecycle, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Resume: Sub return"$, Colors.Blue)
End Sub

Private Sub RestoreViewState()
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Sub entry"$, Colors.Blue)
	
	'This is the very first thing to do
	'This is one of the most sensitive flags in this application
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the Hide Admin Key checkbox .Enabled state"$, Colors.Blue)
	chkHideAdminKey.Enabled = ViewState_chkHideAdminKey_Enabled
	
	'This one is the second-most sensitive flag
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the Hide Admin Key checkbox .Checked state"$, Colors.Blue)
	chkHideAdminKey.Checked = ViewState_chkHideAdminKey_Checked
	
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the About window if it was visible (Visible = ${ViewState_mnuAbout_Visible})"$, Colors.Blue)
	If ViewState_mnuAbout_Visible Then
		'Simulate a click on the About window
		'to show it again if it was shown
		'before Activity destroy-then-recreate
		mnuAbout_Click
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the Direct Unblock window if it was visible (Visible = ${ViewState_mnuDirectUnblock_Visible})"$, Colors.Blue)
	If ViewState_mnuDirectUnblock_Visible Then
		mnuDirectUnblock_Click
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the Challenge field .Text"$, Colors.Blue)
	edtChallenge.Text = ViewState_edtChallenge_Text
	
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the Admin Key field .Text"$, Colors.Blue)
	edtAdminKey.Text = ViewState_edtAdminKey_Text
	
	'The Admin Key label is always dynamically re-generated anyway
	'No need to save and restore it
	
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the Response label .Text"$, Colors.Blue)
	lblResponse.Text = ViewState_lblResponse_Text
	
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the Response field .Text"$, Colors.Blue)
	edtResponse.Text = ViewState_edtResponse_Text
	
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the Hash Text menu button .Checked state"$, Colors.Blue)
	btnHashMenu.Checked = ViewState_btnHashMenu_Checked
	
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Checking what was the last focused element before"$, Colors.Blue)
	Select ViewState_LastFocusedElement
		Case "edtChallenge"
			LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: The last focused element before was edtChallenge"$, Colors.Blue)
			
			LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the focus state on edtChallenge"$, Colors.Blue)
			edtChallenge.RequestFocus
			
			LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the .Selection state for edtChallenge"$, Colors.Blue)
			edtChallenge.SetSelection(ViewState_edtChallenge_SelectionStart, ViewState_edtChallenge_SelectionLength)
			
		Case "edtAdminKey"
			LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: The last focused element before was edtAdminKey"$, Colors.Blue)
			
			'This will fire its FocusChanged event which will
			'also update the Admin Key label accordingly
			LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the focus state on edtAdminKey"$, Colors.Blue)
			edtAdminKey.RequestFocus
			
			LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the .Selection state for edtAdminKey"$, Colors.Blue)
			edtAdminKey.SetSelection(ViewState_edtAdminKey_SelectionStart, ViewState_edtAdminKey_SelectionLength)
			
		Case "edtResponse"
			LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: The last focused element before was edtResponse"$, Colors.Blue)
			
			LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the focus state on edtResponse"$, Colors.Blue)
			edtResponse.RequestFocus
			
			LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the .Selection state for edtResponse"$, Colors.Blue)
			edtResponse.SetSelection(ViewState_edtResponse_SelectionStart, ViewState_edtResponse_SelectionLength)
			
		Case Else
			LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: The last focused element was not found in the list (value = ${ViewState_LastFocusedElement})"$, Colors.Magenta)
			LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Not restoring the focus state on any specific element"$, Colors.Magenta)
			
	End Select
	
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Restoring the ScrollView's last scroll position"$, Colors.Blue)
	Common.SynchronousSleep(100, Me, "RestoreViewState")
	Wait For SynchronousSleep_RestoreViewState_Completed
	scvActivity.ScrollPosition = ViewState_LastScrollPosition
	
	LogColor($"[${ActivityName}-${LogContextId}] RestoreViewState: Sub return"$, Colors.Blue)
End Sub

'Workaround for Android trying to force its own automatic focus management on
'our application despite us not wanting any such obnoxious 'functionality'
Private Sub ForceRestoreCorrectLastFocusedElementState(LastFocusedElement As String)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: Sub entry (LastFocusedElement = ${LastFocusedElement})"$, Constants.COLORS_ORANGE)
	
	'Wait until Android foolishly forces its own focus management and
	'deliberately tries to force the wrong one on our Activity
	'
	'Use a normal sleep call here (not synchronous sleep),
	'because this is just as if this function was called via CallSubDelayed
	'when you call a function that starts with a normal sleep call
	'
	'The sleep call immediately lets the caller function finish and return,
	'then puts e.g. this one (the called function) into a queue that will
	'start later when the sleep time is completed
	'
	'Note: Synchronous sleep is not compatible with functions called via
	'      the builtin CallSubDelayed functions, because if one such function is
	'      called via CallSubDelayed is waiting, then you do a CallSubDelayed with
	'      another one, the previously waiting one gets cancelled and never finishes:
	'       - CallSubDelayed cancels the previous one
	'
	'      The alternative is to directly call the function without CallSubDelayed
	'      then put a short e.g. Sleep(100) call at the start of the function
	'
	LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: Sleeping 100ms via Sleep(100) so that we reschedule our run 100ms later, to wait for Android to be annoying first before correcting its mistakes..."$, Constants.COLORS_ORANGE)
	Sleep(100)
	
	'
	'Now we correct Android by correcting its foolish mistake,
	'with Android being oblivious to having been swiftly corrected
	'
	
	'Restore the last focused element state as it should be, without
	'Android trying to meddle with our preferred focus management
	'
	'But there's a little thing with Android again:
	' - If any of these elements were already selected
	'   and had their focus set to focused,
	'   then the FocusChanged event doesn't fire:
	'
	'   Because Android doesn't fire redundant events for the same
	'   exact states as before (e.g. if the element is already focused)
	'
	' - So after setting the focus on any of these UI elements,
	'   we manually call their FocusChanged events ourselves
	'
	'Notes:
	' - Whenever you restore a focused state, make sure to also
	'   restore the text selection information afterwards as well
	'
	' - You need to send a 'lost focus' event manually to all
	'   other UI elements that were not the last-focused-one
	'
	LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: Preparing a list of unfocused UI elements with all of them at first..."$, Constants.COLORS_ORANGE)
	Dim UnfocusedElementsList As String = "[edtChallenge][edtAdminKey][edtResponse]"
	
	LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: Now because we know that the last focused element is ${LastFocusedElement} we exempt this one only"$, Constants.COLORS_ORANGE)
	LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: Removing ${LastFocusedElement} from the list of unfocused ones"$, Constants.COLORS_ORANGE)
	Select LastFocusedElement
		Case "edtChallenge"
			UnfocusedElementsList = UnfocusedElementsList.Replace("[edtChallenge]", "")
			
		Case "edtAdminKey"
			UnfocusedElementsList = UnfocusedElementsList.Replace("[edtAdminKey]", "")
			
		Case "edtResponse"
			UnfocusedElementsList = UnfocusedElementsList.Replace("[edtResponse]", "")
			
	End Select
	
	'Now UnfocusedElementsList contains only the unfocused UI elements
	'
	'These events will set ViewState_LastFocusedElement to "undetermined"
	'because they got unfocused and think that it will be fixed by the next one's
	'own FocusChanged event, so we do them first
	'
	' - (Although we still have a proper copy of it in as LastFocusedElement parameter)
	'
	'Then we fire the last focused element lastly, which fixes the
	'ViewState_LastFocusedElement value back to proper,
	'thanks to the focused one's FocusChanged event automatically doing it for us
	LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: We now call the unfocused elements' FocusChanged event Subs manually to report to them their lost focus status..."$, Constants.COLORS_ORANGE)
	If UnfocusedElementsList.Contains("[edtChallenge]") Then
		LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: Manually calling edtChallenge_FocusChanged(False) to report its lost focus to it"$, Constants.COLORS_ORANGE)
		edtChallenge_FocusChanged(False)
		
	End If
	If UnfocusedElementsList.Contains("[edtAdminKey]") Then
		LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: Manually calling edtAdminKey_FocusChanged(False) to report its lost focus to it"$, Constants.COLORS_ORANGE)
		edtAdminKey_FocusChanged(False)
		
	End If
	If UnfocusedElementsList.Contains("[edtResponse]") Then
		LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: Manually calling edtResponse_FocusChanged(False) to report its lost focus to it"$, Constants.COLORS_ORANGE)
		edtResponse_FocusChanged(False)
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: Again so to say the last focused element is ${LastFocusedElement}, so we proceed to restoring the focused state of this one"$, Constants.COLORS_ORANGE)
	LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: Calling ${LastFocusedElement}.RequestFocus, then manually calling its ${LastFocusedElement}_FocusChanged event Sub and restoring its text selection information..."$, Constants.COLORS_ORANGE)
	Select LastFocusedElement
		Case "edtChallenge"
			edtChallenge.RequestFocus
			edtChallenge_FocusChanged(True) 'Read "little thing with Android" notes for why it's here
			edtChallenge.SetSelection(ViewState_edtChallenge_SelectionStart, ViewState_edtChallenge_SelectionLength)
			
		Case "edtAdminKey"
			edtAdminKey.RequestFocus
			edtAdminKey_FocusChanged(True) 'Read "little thing with Android" notes for why it's here
			edtAdminKey.SetSelection(ViewState_edtAdminKey_SelectionStart, ViewState_edtAdminKey_SelectionLength)
			
		Case "edtResponse"
			edtResponse.RequestFocus
			edtResponse_FocusChanged(True) 'Read "little thing with Android" notes for why it's here
			edtResponse.SetSelection(ViewState_edtResponse_SelectionStart, ViewState_edtResponse_SelectionLength)
			
	End Select
	
	'Setting the focus automatically scrolls it, wait until
	'its scrolling is completed before proceeding further
	Common.SynchronousSleep(100, Me, "ForceRestoreCorrectLastFocusedElementState")
	Wait For SynchronousSleep_ForceRestoreCorrectLastFocusedElementState_Completed
	
	'Restore the ViewState last scroll position because as
	'said above the scroll position has been changed to the
	'last focused UI element's position
	LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: Restoring the ViewState last scroll position..."$, Constants.COLORS_ORANGE)
	scvActivity.ScrollPosition = ViewState_LastScrollPosition
	
	LogColor($"[${ActivityName}-${LogContextId}] ForceRestoreCorrectLastFocusedElementState: Sub return"$, Constants.COLORS_ORANGE)
End Sub

Sub Activity_NewIntent(NewIntent As Intent)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_NewIntent: Sub entry (NewIntent = {Action: "${NewIntent.Action}", HasTextExtra: ${NewIntent.HasExtra("android.intent.extra.TEXT")}})"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_NewIntent: Text ExtraData will never be shown in logs, as it's considered sensitive information"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_NewIntent: Checking if any Admin Key was shared to this App"$, Colors.Blue)
	CheckIfAdminKeySharedToTheApp(NewIntent)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_NewIntent: Sub return"$, Colors.Blue)
End Sub

Private Sub CheckIfAdminKeySharedToTheApp(ReceivedIntent As Intent)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Sub entry"$, Colors.Blue)
	
	'This variable will receive the Share To Intents' TEXT extra data (if any)
	Dim ReceivedText As String
	
	LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Checking what the starting Intent is"$, Colors.Blue)
	If  ReceivedIntent.Action == ReceivedIntent.ACTION_SEND  _
	And ReceivedIntent.HasExtra("android.intent.extra.TEXT") Then
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: The starting Intent is ACTION_SEND and it contains a TEXT extra"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Fetching the shared Admin Key text from the Share To Intent's TEXT extra"$, Colors.Blue)
		ReceivedText = ReceivedIntent.GetExtra("android.intent.extra.TEXT")
		
		'Return: ReturnValue(0) = whether it's a different truncated rehash (True / False)
		'        ReturnValue(1) = the truncated rehash, empty if verification returns
		'                         a False status
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Verifying if the shared Admin key text it's different from the previously shared one"$, Colors.Blue)
		
		Dim TruncatedTextRehash As String
		
		Try
			TruncatedTextRehash = Security.GenerateTruncatedTextRehash(ReceivedText)
		Catch
			'If generating the truncated text rehash fails,
			'then we deliberately set it to the previous one so that
			'the next part of the code considers it to be a duplicate
			'Share To attempt, thus rejecting it anyway
			TruncatedTextRehash = PreviousSharedTextTruncatedRehash
			
		End Try
		
		'Check if the truncated text rehash is different from
		'the previously shared one (False = same one)
		If TruncatedTextRehash.EqualsIgnoreCase(PreviousSharedTextTruncatedRehash) Then
			LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: The shared Admin Key text is the same as the previous one"$, Colors.Magenta)
			LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Ignoring Android's Share To Intent spam on every App resume..."$, Colors.Magenta)
			
			LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Sub return"$, Colors.Magenta)
			Return
			
		End If
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: The shared Admin Key text is different from the previous one"$, Colors.Blue)
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: So it was not an Android Share To Intent spam afterall..."$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Remembering this Admin Key text (in truncated rehash form) for future Intent spam identification purposes"$, Colors.Blue)
		PreviousSharedTextTruncatedRehash = TruncatedTextRehash
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: The starting Intent is not something we specifically care about"$, Colors.Blue)
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: It's something other than an ACTION_SEND with a TEXT extra, so ignoring it"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Sub return"$, Colors.Blue)
		Return
		
	End If
	
	'This part of the function cans only be reached
	'if the Share To Intent has ACTION_SEND and has
	'a TEXT extra inside
	
	'Admin Keys can be 64-digits, 48-digits or 32-digits (Hex string)
	'64 = AES-256
	'48 = 3DES (DES-EDE3)
	'32 = AES-128 / 2DES (DES-EDE2)
	LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Checking whether the shared Admin Key text (or hash) is valid"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: It must be a string representing Hex bytes and be atleast 32 chars"$, Colors.Blue)
	If Cryptography.IsTextHexBytes(ReceivedText) And ReceivedText.Length >= 32 Then
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: The shared Admin Key text (or maybe an hash) is actually valid"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Locking down the Admin Key field to unrevealable password mode"$, Colors.Blue)
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: When a valid Admin Key or hash is shared to the App, it's always made unrevealable"$, Colors.Blue)
		LockdownAdminKeyField
		
		'Only if the Admin key text is valid:
		'Set the focus on the Admin Key field to bring visual attention to it
		edtAdminKey.RequestFocus
		
		'Only put the Admin Key text in the Admin Key field
		'After it has been locked down and made unrevealable
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Setting the Admin Key field .Text to the text that we received"$, Colors.Blue)
		edtAdminKey.Text = ReceivedText
		
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Notify the user that the Admin Key field .Text has been set to the shared text we received in a toast notification"$, Colors.Blue)
		ToastMessageShow("Admin key text shared successfully", Constants.TOAST_DURATION_SHORT)
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: The shared Admin Key text (or maybe an hash) is invalid"$, Colors.Magenta)
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: We can't accept setting the Admin Key field .Text to an invalid value"$, Colors.Magenta)
		
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Setting the Admin Key .Text to empty-string to make sure the user doesn't accidentally use the default 48-zeroes Admin Key"$, Colors.Magenta)
		edtAdminKey.Text = ""
		
		LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Notify the user that the shared Admin Key is invalid with a toast notification"$, Colors.Magenta)
		ToastMessageShow("Shared Admin key text is invalid", Constants.TOAST_DURATION_SHORT)
		
	End If
	
	'Clear the contents of the receivedText variable
	'once it's no longer needed for the next part of
	'the application  lifecycle.
	LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Clearing the temporary variable containing the shared Admin Key (or hash) text"$, Colors.Blue)
	ReceivedText = ""
	
	LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Requesting a JVM garbage collection to discard the received Admin Key text variable as soon as possible"$, Colors.Blue)
	Security.TriggerJvmGarbageCollection
	
	LogColor($"[${ActivityName}-${LogContextId}] CheckIfAdminKeySharedToTheApp: Sub return"$, Colors.Blue)
End Sub

Private Sub LockdownAdminKeyField
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] LockdownAdminKeyField: Sub entry"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] LockdownAdminKeyField: Disabling the Hide Admin Key checkbox permanently"$, Colors.Blue)
	chkHideAdminKey.Enabled = False
	
	LogColor($"[${ActivityName}-${LogContextId}] LockdownAdminKeyField: Registering the Hide Admin Key checkbox disabling in the ViewState registers"$, Colors.Blue)
	ViewState_chkHideAdminKey_Enabled = False
	
	'This will fire the CheckedChange event even if
	'the checkbox is actually disabled
	LogColor($"[${ActivityName}-${LogContextId}] LockdownAdminKeyField: Hiding the Admin Key field for security reasons"$, Colors.Blue)
	chkHideAdminKey.Checked = True
	
	LogColor($"[${ActivityName}-${LogContextId}] LockdownAdminKeyField: Sub return"$, Colors.Blue)
End Sub

Private Sub Activity_KeyPress(KeyCode As Int) As Boolean
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: Sub entry (KeyCode = ${KeyCode})"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: Verifying what the KeyCode is"$, Colors.Blue)
	Select Case KeyCode
		Case KeyCodes.KEYCODE_BACK
			LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: The KeyCode is KEYCODE_BACK"$, Colors.Blue)
			
			LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: Checking if there any modals visible"$, Colors.Blue)
			LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: Don't exit the Activity if a modal was shown"$, Colors.Blue)
			If btnHashMenu.Checked Then
				LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: Found the text hashing options menu modal"$, Colors.Blue)
				
				LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: Closing the text hashing options menu"$, Colors.Blue)
				btnHashMenu.Checked = False
				
				LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: Sub return (returning True to prevent exit)"$, Colors.Blue)
				Return True
				
			End If
			LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: Alright, no dialog modals are visible"$, Colors.Blue)
			
			LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: Calling Activity_Exit"$, Colors.Blue)
			Activity_Exit
			
			LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: Sub return (returning True)"$, Colors.Blue)
			Return True
			
		Case KeyCodes.KEYCODE_HOME
			'This code branch might go too fast for the Basic4Android BridgeLogger to log
			LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: The KeyCode is KEYCODE_HOME"$, Colors.Blue)
			
			LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: Hiding the Admin Key field on application switching events (Home button press)"$, Colors.Blue)
			chkHideAdminKey.Checked = True
			
		Case Else
			LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: The KeyCode is something else"$, Colors.Blue)
			LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: We don't do anything particular with other KeyCodes"$, Colors.Blue)
			
	End Select
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_KeyPress: Sub return (returning False)"$, Colors.Blue)
	Return False
	
End Sub

Private Sub Activity_Exit
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Exit: Sub entry"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Exit: Stopping this Activity's Lifecycle reset Timer for foreground rotation detection"$, Colors.Blue)
	LifecycleTracking.LifecycleClearingThread_Stop
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Exit: Stopping any running text selection timers manually"$, Colors.Blue)
	StopAllActivityTimers
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Exit: Resetting the ViewState to clear all input contents etc"$, Colors.Blue)
	ResetViewState
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Exit: Asking the JVM to do a garbage collection as soon as possible"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Exit: This will clear traces of leftover variable contents"$, Colors.Blue)
	Security.TriggerJvmGarbageCollection
	
	'Don't exit the app anymore by killing its process
	'or calling System.exit(0) and so on,
	'because the Smartcard servie might be performing
	'a smartcard operation and in such cases we have
	'to wait until they complete, so by only exiting
	'this Activity and not the Service too
	'
	'Killing its process or calling System.exit()
	'would kill the Smartcard service too
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Exit: Finishing the Activity now"$, Colors.Blue)
	Activity.Finish
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Exit: Sub return"$, Colors.Blue)
End Sub

Private Sub StopAllActivityTimers
	
	'Add all this Activity's Timers below
	'Currently we only have one for the Admin Key field
	For Each ActivityTimer As Timer In Array As Timer(SelectionTimer_edtAdminKey)
		ActivityTimer.Enabled = False
	Next
	
End Sub

Sub Activity_Pause(UserClosed As Boolean)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: Sub entry (UserClosed = ${UserClosed})"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Blue)
	LifecycleTracking.ActivityLifecycle = LifecycleTracking.ActivityLifecycle & LifecycleTracking.PAUSE
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: New Activity lifecycle tracking value: "$&LifecycleTracking.ActivityLifecycle, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: Save ViewState"$, Colors.Blue)
	SaveViewState
	
	'
	'Important notice:
	'
	'On Activity pause, we have very little time afforded to us by Android
	'to quickly backup the Activity's ViewState, and while this little time
	'is well enough to backup variable contents and save UI elements' properties,
	'it's definitely not long enough to wait until we *set* UI element properties
	'before proceeding to the ViewState saving:
	' - In such cases, it's already too late:
	'
	'   The Activity got actually paused, and the Activity state is lost,
	'   *except* what Android already backs up by default on its own:
	'    - Such as EditTexts' text contents and checkbox checked states,
	'      but otherwise that's about it; the rest then gets lost
	'
	'      (anything not saved by Android itself in an Instance save Bundle)
	'
	'So that's why the Admin Key field is hidden *After* saving the ViewState
	'and updating the Activity lifecycle tracking value
	'
	'It's the only way that we get enough time to save everythin before the
	'Activity gets paused, *stopped*, destroyed, started, created & resumed
	'
	'Note: Yes, in Basic4Android Activities are started first then created...
	'
	'TLDR: Don't *set* ANY UI element properties until you've *read* ALL the
	'      UI element properties you need save then put them in
	'      process globals *first*:
	'       - Because while the UI elements will still exist on Activity pause,
	'         their contents & states will shortly be lost as said above
	'
	'      So first do all your properties' reading and only then the
	'      properties writing
	'
	
	'Something to always do first on app pause events:
	'
	'Hide the Admin key text (using the Visible property),
	'before even updating the Lifecycle tracking of this Activity
	'
	'This prevents potential milliseconds-leaks of the
	'Admin key texts in app background pause & resume scenarios
	'
	'It will be set to visible again anyway on app resume
	'This is done before even checking if UserClosed is True or not
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: Set the Admin Key field visibility to invisible"$, Colors.Blue)
	edtAdminKey.Visible = False
	
	'Stopping the running text selection timers is always done
	'no matter whether UserClosed is True of False
	'
	'Note: we stop text selection Timers only,
	'      not the Activity Lifecycle tracking thread
	'
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: Stopping any running text selection timers manually"$, Colors.Blue)
	StopAllActivityTimers
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: Check if the Activity is closing for real (check UserClosed parameter)..."$, Colors.Blue)
	If UserClosed Then
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: Activity is UserClosed"$, Colors.Blue)
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: No need to proceed further in this case"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: Sub return"$, Colors.Blue)
		Return
		
	End If
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: Activity is not UserClosed"$, Colors.Blue)
	
	'Do the decoy Admin key display here after we make sure that the
	'Activity's pause event is not UserClosed (so UserClosed must be False)
	'
	' - (Otherwise why bother showing it if the app will fully exit anyway)
	'
	'Show the decoy Admin key field during application pauses
	'
	'It's used for hiding the Admin key field with explanation abouy
	'why it's hidden, so that users know that it's not a bug
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: Set the decoy Admin Key field visibility to Visible"$, Colors.Blue)
	edtDecoyKey.Visible = True
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: Starting this Activity's Lifecycle reset Timer for foreground rotation detection"$, Colors.Blue)
	LifecycleTracking.LifecycleClearingThread_Start
	
	LogColor($"[${ActivityName}-${LogContextId}] Activity_Pause: Sub return"$, Colors.Blue)
End Sub

Private Sub SaveViewState()
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] SaveViewState: Sub entry"$, Colors.Blue)
	
	'The About window visibility status is saved
	'in realtime by its own event handler
	
	'The Direct Unblock window visibility status is saved
	'in realtime by its own event handler
	
	LogColor($"[${ActivityName}-${LogContextId}] SaveViewState: Saving Challenge field .Text"$, Colors.Blue)
	ViewState_edtChallenge_Text = edtChallenge.Text
	
	LogColor($"[${ActivityName}-${LogContextId}] SaveViewState: Saving Challenge field .Selection state"$, Colors.Blue)
	ViewState_edtChallenge_SelectionStart  = edtChallenge.SelectionStart
	ViewState_edtChallenge_SelectionLength = edtChallenge.SelectionLength
	
	LogColor($"[${ActivityName}-${LogContextId}] SaveViewState: Saving Admin Key field .Text"$, Colors.Blue)
	ViewState_edtAdminKey_Text = edtAdminKey.Text
	
	LogColor($"[${ActivityName}-${LogContextId}] SaveViewState: Saving Admin Key field .Selection state"$, Colors.Blue)
	ViewState_edtAdminKey_SelectionStart  = edtAdminKey.SelectionStart
	ViewState_edtAdminKey_SelectionLength = edtAdminKey.SelectionLength
	
	'The Hide Admin Key checkbox's .Checked is saved in realtime
	'in its own respective CheckedChanged event handler
	
	'The Admin Key label is always dynamically re-generated anyway
	'No need to save and restore it
	
	LogColor($"[${ActivityName}-${LogContextId}] SaveViewState: Saving Response label .Text"$, Colors.Blue)
	ViewState_lblResponse_Text = lblResponse.Text
	
	LogColor($"[${ActivityName}-${LogContextId}] SaveViewState: Saving Response field .Text"$, Colors.Blue)
	ViewState_edtResponse_Text = edtResponse.Text
	
	LogColor($"[${ActivityName}-${LogContextId}] SaveViewState: Saving Response field .Selection state"$, Colors.Blue)
	ViewState_edtResponse_SelectionStart  = edtResponse.SelectionStart
	ViewState_edtResponse_SelectionLength = edtResponse.SelectionLength
	
	'Last focused element is always saved in realtime in their
	'own respective FocusChanged event handlers
	
	LogColor($"[${ActivityName}-${LogContextId}] SaveViewState: Saving the ScrollView's last scroll position"$, Colors.Blue)
	ViewState_LastScrollPosition = scvActivity.ScrollPosition
	
	LogColor($"[${ActivityName}-${LogContextId}] SaveViewState: Sub return"$, Colors.Blue)
End Sub

'----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- ----- -----

'
'UI element events
'

Private Sub mnuDirectUnblock_Click
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: Sub entry"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: Get the USB OTG support status of this device..."$, Colors.Blue)
	Dim DeviceHasUsbOtg As Boolean = joActivity.RunMethod("jDeviceHasUsbOtgSupport", Null)
	
	'The Direct Unblock window automatically disappears
	'on Activity pause & Activity destroy
	
	LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: Prepare an introducory Activity dialog about this function..."$, Colors.Blue)
	Dim DirectUnblockIcon As Bitmap = Application.Icon
	
	Dim SquareIcoSize As Int = Common.GetSquareIconSizeForDisplayScale
	
	If DirectUnblockIcon.Height <> SquareIcoSize Then
		DirectUnblockIcon = DirectUnblockIcon.Resize(SquareIcoSize, SquareIcoSize, Constants.BITMAP_RESIZE_KEEP_ASPECT_RATIO)
	End If
	
	Dim DirectUnblockInfoText As CSBuilder
	DirectUnblockInfoText.Initialize
	
	DirectUnblockInfoText.Bold
	DirectUnblockInfoText.Append(Application.LabelName&CRLF)
	DirectUnblockInfoText.Pop
	DirectUnblockInfoText.RelativeSize(0.9)
	If DeviceHasUsbOtg Then
		DirectUnblockInfoText.Append("Direct unblock over USB-OTG"&CRLF)
	Else
		DirectUnblockInfoText.Append("Device has no USB-OTG support"&CRLF)
	End If
	DirectUnblockInfoText.PopAll
	
	DirectUnblockInfoText.Append(CRLF)
	DirectUnblockInfoText.PopAll
	
	If DeviceHasUsbOtg Then
		DirectUnblockInfoText.Append("You will be asked to connect your smartcard reader then insert your PKI smartcard into the reader."&CRLF)
		DirectUnblockInfoText.Append(CRLF)
		DirectUnblockInfoText.Color(Colors.Yellow)
		DirectUnblockInfoText.Append("If any error happens during the direct unblock process, then read the exception message carefully and don't retry to unblock the same card with this app again.")
	Else
		DirectUnblockInfoText.Append("Direct unblocking of smartcard PINs requires a device with USB-OTG support but your device claimed that it doesn't support it.")
		DirectUnblockInfoText.PopAll
	End If
	DirectUnblockInfoText.PopAll
	
	If DeviceHasUsbOtg Then
		'Positive action = Proceed
		LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: The device supports USB-OTG, displaying a card operation introducory message"$, Colors.Blue)
		Msgbox2Async(DirectUnblockInfoText, "Direct Unblock", "Proceed to Unblock", "Cancel", Constants.MSGBOX_HIDE_NEGATIVE, DirectUnblockIcon, Constants.MSGBOX_CANCELLABLE)
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: The device does not support USB-OTG, displaying an operation abort message"$, Colors.Magenta)
		Msgbox2Async(DirectUnblockInfoText, "Direct Unblock", Constants.MSGBOX_HIDE_POSITIVE, "Cancel", Constants.MSGBOX_HIDE_NEGATIVE, DirectUnblockIcon, Constants.MSGBOX_CANCELLABLE)
		
	End If
	LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: Setting the ViewState Visible attribute of the dialog window to True"$, Colors.Blue)
	ViewState_mnuDirectUnblock_Visible = True
	
	LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: Waiting for the MessageBox to be closed to check its return result"$, Colors.Blue)
	Wait For Msgbox_Result(Result As Int)
	LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: The MessageBox has been closed now"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: Setting the ViewState Visible attribute of the dialog window to False"$, Colors.Blue)
	ViewState_mnuDirectUnblock_Visible = False
	
	If Result <> DialogResponse.POSITIVE And DeviceHasUsbOtg Then
		LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: The MessageBox return result is not positive, cannot proceed further"$, Colors.Magenta)
		
		LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: Showing a toast notification about the cancellation of the operation"$, Colors.Magenta)
		ToastMessageShow("Direct unlock operation cancelled", Constants.TOAST_DURATION_SHORT)
		
		Return
		
	End If
	
	If Not(DeviceHasUsbOtg) Then
		LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: The device does not support OTG so cannot proceed further"$, Colors.Magenta)
		LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: So we don't care about checking the result of the operation abort dialog"$, Colors.Magenta)
		
		LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: Sub return"$, Colors.Magenta)
		Return
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: The dialog result is positive and the device supports USB-OTG"$, Colors.Blue)
	
	ToastMessageShow("TODO: Add SmartcardService", Constants.TOAST_DURATION_SHORT)
	
	LogColor($"[${ActivityName}-${LogContextId}] mnuDirectUnblock_Click: Sub return"$, Colors.Blue)
End Sub

Private Sub mnuAbout_Click
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] mnuAbout_Click: Sub entry"$, Colors.Blue)
	
	'The About window automatically disappears
	'on Activity pause & Activity destroy
	
	LogColor($"[${ActivityName}-${LogContextId}] mnuAbout_Click: Displaying the About MessageBox with the proper App icon and button options"$, Colors.Blue)
	Dim AboutIcon As Bitmap = Application.Icon
	
	'Get better-adapted About icons according to screen DPI & scale
	Dim SquareIcoSize As Int = Common.GetSquareIconSizeForDisplayScale
	
	If AboutIcon.Height <> SquareIcoSize Then
		AboutIcon = AboutIcon.Resize(SquareIcoSize, SquareIcoSize, Constants.BITMAP_RESIZE_KEEP_ASPECT_RATIO)
	End If
	
	'CSBuilder (CharSequenceBuilder) allows building CharSequence-based strings
	'Such char sequences can contain better formatting options for strings
	'
	'More info:
	' - https://www.b4x.com/android/forum/threads/charsequence-csbuilder-tutorial.76226/
	'
	'About Pop & PopAll:
	' - "Calling Pop ends the last span that was added (and not ended yet).
	'    Calling PopAll ends all open spans.
	'    It's convenient to always call PopAll at the end to ensure that all spans are closed."
	Dim AboutInfoText As CSBuilder
	AboutInfoText.Initialize
	
	'Make the app name bold
	AboutInfoText.Bold
	'Basic4Android's CRLF is actually a LF char
	'In its source code, CRLF resolves to "\n"
	AboutInfoText.Append(Application.LabelName&CRLF) 'App name + newline
	'Pop only the last app name span attribute (Bold)
	AboutInfoText.Pop
	'Make this app version text 10% smaller
	AboutInfoText.RelativeSize(0.9) '10% is 0.10, so decrease its size by 0.10 (1.00 -> 0.90)
	'Different version text between the
	'FLAG_SECURE and NO_FLAG_SECURE builds
	AboutInfoText.Append("Version "&Application.VersionName) 'App version (no CRLF char)
	#If OBFUSCATED
	'If it's obfuscated, then add a friendly warning
	'to highlight that the app should not be obfuscated
	'
	'The OBFUSCATED conditional symbol is a valid one
	'but will not be highlighted in the Basic4Android IDE,
	'it's only set at compile time but it does work
		
	'Add a space to the app version text
		AboutInfoText.Append(" ")
		
	'Set the caution label text to "OBFUSCATED"
	'Set a white color for the warning label text
	'Set a red color for the warning label background
		mnuAbout_AddVersionLabel(AboutInfoText, "OBFUSCATED", Colors.White, Colors.Red)
	#End If
	#If NO_FLAG_SECURE
	'Inform the user if they use an insecure build
	'
	'Insecure builds don't always warn the user
	'on startup with a toast notification,
	'as long as blocking the Recent Apps thumbnails
	'without using FLAG_SECURE is possible
	'
	'Nonetheless, it's nice to know which build you have
	'incase you're curious, rather than having to use an
	'older device to get the warning toast notifications
	'
	' - (Android 12 & earlier, API levels 32 and below)
	'
	'Even the very legacy devices up to 4.0.2 will not
	'show warning notifications on startup because
	'it's possible to block Recent Apps thumbnails
	'on these older Android versions without FLAG_SECURE
		
	'Add a space to the app version text
		AboutInfoText.Append(" ")
		
	'Set the warning label text to "INSECURE"
	'Set a black color for the warning label text
	'Set a yellow color for the warning label background
		mnuAbout_AddVersionLabel(AboutInfoText, "INSECURE", Colors.Black, Colors.Yellow)
	#End If
	AboutInfoText.Append(CRLF) 'Now we can add the CRLF char
	
	'End the App name & version span
	AboutInfoText.PopAll
	
	'Make sure to leave one empty line between
	'the app name / version info and the description
	'
	'Adding it as its own span (Append CRLF then PopAll)
	AboutInfoText.Append(CRLF)
	AboutInfoText.PopAll
	
	'App description now
	AboutInfoText.Append("This app generates unblock codes for cryptographic PKI smartcards such as Yubikey & IDPrime, eToken."&CRLF)
	AboutInfoText.PopAll
	
	'Make sure to leave one empty line between
	'the app description and the copyleft notice
	'
	'Adding it as its own span (Append CRLF then PopAll)
	AboutInfoText.Append(CRLF)
	AboutInfoText.PopAll
	
	'Copyleft notice (bonus)
	'
	'Yes, the Alignment constant is passed as a String
	'
	'Basic4Android then resolves the layout alignment constant
	'automatically without having to create any Alignment Object
	AboutInfoText.Alignment("ALIGN_CENTER")
	'Make this copyleft notice 10% smaller
	AboutInfoText.RelativeSize(0.9) '10% is 0.10, so decrease its size by 0.10 (1.00 -> 0.90)
	AboutInfoText.Append("Copyleft ")
	'Copyleft icon (custom addition to MaterialIcons)
	AboutInfoText.VerticalAlign(2dip * LoadedLayout.Scale) 'Push the copyleft icon 2dip further below (calibrated value)
	AboutInfoText.Typeface(Typeface.MATERIALICONS)
	AboutInfoText.Append(Constants.COPYLEFT_ICON)
	'Pop only the last copyleft icon span attributes (VerticalAlign & Typeface)
	AboutInfoText.Pop 'Pop Typeface
	AboutInfoText.Pop 'Pop VerticalAlign
	'No CRLF needed for the last line
	AboutInfoText.Append(" "&Constants.APPLICATION_LICENSE) 'No CRLF for the last text line
	'End the last span too always
	AboutInfoText.PopAll
	
	'Positive button is 'Homepage'
	'Cancel   button is 'Dismiss'
	Msgbox2Async(AboutInfoText, "About", Constants.APPLICATION_HOMEPAGE_NAME, "Dismiss", Constants.MSGBOX_HIDE_NEGATIVE, AboutIcon, Constants.MSGBOX_CANCELLABLE)
	
	'The ViewState visibility status of
	'the About window is to be saved here
	'
	'Because it's while we wait for the
	'MsgBox result that it's visible
	LogColor($"[${ActivityName}-${LogContextId}] mnuAbout_Click: Setting the ViewState Visible attribute of the dialog window to True"$, Colors.Blue)
	ViewState_mnuAbout_Visible = True
	
	LogColor($"[${ActivityName}-${LogContextId}] mnuAbout_Click: Waiting for the MessageBox to be closed to check its return result..."$, Colors.Blue)
	Wait For Msgbox_Result(Result As Int)
	LogColor($"[${ActivityName}-${LogContextId}] mnuAbout_Click: The MessageBox has been closed now"$, Colors.Blue)
	
	'The ViewState visibility status of
	'the About window is to be saved here again
	'
	'Because it's after the MsgBox result came
	'that the About window is no longer visible
	LogColor($"[${ActivityName}-${LogContextId}] mnuAbout_Click: Setting the ViewState Visible attribute of the dialog window to False"$, Colors.Blue)
	ViewState_mnuAbout_Visible = False
	
	LogColor($"[${ActivityName}-${LogContextId}] mnuAbout_Click: Checking its MessageBox return result..."$, Colors.Blue)
	If Result = DialogResponse.POSITIVE Then
		LogColor($"[${ActivityName}-${LogContextId}] mnuAbout_Click: The MessageBox return result is POSITIVE"$, Colors.Blue)
		
		'Because I don't want to bundle the big Phone library
		'Use the Advanced class to open the browser URL
		LogColor($"[${ActivityName}-${LogContextId}] mnuAbout_Click: Requesting the opening of the App homepage URL in the user's default Web browser"$, Colors.Blue)
		joActivity.RunMethod("jOpenBrowserUrl", Array(Constants.APPLICATION_HOMEPAGE_URL))
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] mnuAbout_Click: The MessageBox return result is not POSITIVE, no nothing to do here"$, Colors.Blue)
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] mnuAbout_Click: Sub return"$, Colors.Blue)
End Sub

#If NO_FLAG_SECURE OR OBFUSCATED
'Helper function to add more than
'one version label without writing
'the same code twice (no redundancy)
Private Sub mnuAbout_AddVersionLabel(AboutVersionText As CSBuilder, LabelText As String, LabelColor As Int, LabelBackgroundColor As Int)
	'You don't need to add logging in a simple
	'very small helper function like this one
	'Set yellow color for the warning label background
	
	'Set the background color for the version label
	AboutVersionText.BackgroundColor(LabelBackgroundColor)
	
	'Set the text color for the version label text
	AboutVersionText.Color(LabelColor)
	
	'25% smaller than the previous text
	AboutVersionText.RelativeSize(0.75)
	
	'Vertically align the version label text
	'by adjusting the offset, to be more
	'visually pleasing aka. better-aligned
	'for the Human eye when the user sees it
	AboutVersionText.VerticalAlign(-1dip * LoadedLayout.Scale) '-1dip higher (negative value - calibrated value)
	
	'Append the version label
	'
	'Notice the spaces before & after in order to
	'have left & right padding in the warning label
	AboutVersionText.Append(" "&LabelText&" ")
	
	AboutVersionText.Pop 'Pop the -1dip VerticalAlign span
	AboutVersionText.Pop 'Pop the 25% (plus 10%) smaller RelativeSize span
	AboutVersionText.Pop 'Pop the text color span
	AboutVersionText.Pop 'Pop the background color span
	
End Sub
#End If

Private Sub edtChallenge_FocusChanged(HasFocus As Boolean)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] edtChallenge_FocusChanged: Sub entry (HasFocus = ${HasFocus})"$, Colors.Blue)
	
	If HasFocus Then
		LogColor($"[${ActivityName}-${LogContextId}] edtChallenge_FocusChanged: HasFocus is True"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] edtChallenge_FocusChanged: Set ViewState last focused element to "edtChallenge""$, Colors.Blue)
		ViewState_LastFocusedElement = "edtChallenge"
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] edtChallenge_FocusChanged: HasFocus is False"$, Colors.Blue)
		
		'Android doesn't reset the selection information of
		'EditText fields when the focus is lost
		'
		'So the EditText selection timers call their respective
		'EditText_ShowSelectionInfo method but these functions
		'think that the their EditText selection didn't change
		'
		'To fix this, I just forewarn that the last focused
		'element is "undetermined" and the EditTexts'
		'respective EditText_ShowSelectionInfo methods will
		'verify that their element still has the focus
		'thanks to this forewarning being done in advance
		LogColor($"[${ActivityName}-${LogContextId}] edtChallenge_FocusChanged: Set ViewState last focused element to "undetermined" (will be set again properly by the next focused element)"$, Colors.Blue)
		ViewState_LastFocusedElement = "undetermined"
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] edtChallenge_FocusChanged: Update neat borders for this EditText field (according to the state of HasFocus = ${HasFocus})"$, Colors.Blue)
	AddBordersToEditText(edtChallenge, HasFocus)
	
	LogColor($"[${ActivityName}-${LogContextId}] edtChallenge_FocusChanged: Correct the scroll position to be better than Android's default scrolling to focused elements"$, Colors.Blue)
	scvActivity.ScrollPosition = 0dip
	
	LogColor($"[${ActivityName}-${LogContextId}] edtChallenge_FocusChanged: Sub return"$, Colors.Blue)
End Sub

Private Sub btnScanQR_Click
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Sub entry"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Verify if the device has a Camera first before proceeding further"$, Colors.Blue)
	If Common.GetDeviceCamerasCount < 1 Then
		LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: The device doesn't have a Camera, cannot proceed further"$, Colors.Magenta)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Display an exception message in a toast notification"$, Colors.Magenta)
		ToastMessageShow("Camera required to scan QR codes", Constants.TOAST_DURATION_SHORT)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Sub return"$, Colors.Magenta)
		Return
		
	End If
	
	'Ask for authorization to use the Camera at runtime
	'Required on Android 6.0+
	'Has no effect on older Android versions
	Dim RuntimePerms As RuntimePermissions

	LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Checking if we have the Camera runtime permission"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: This is required on Android 6.0+ devices"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: This check will always return True on older Android versions"$, Colors.Blue)
	If RuntimePerms.Check(RuntimePerms.PERMISSION_CAMERA) <> True Then
		LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: We don't have Camera runtime permission access"$, Colors.Magenta)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Requesting Camera runtime permission (the user needs to agree)"$, Colors.Magenta)
		RuntimePerms.CheckAndRequest(RuntimePerms.PERMISSION_CAMERA)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Waiting for the result of our Camera runtime permission request"$, Colors.Magenta)
		Wait For Activity_PermissionResult(PermissionIdentifier As String, HavePermission As Boolean)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: The results of our runtime permission request has come, checking if we were granted Camera access"$, Colors.Magenta)
		If HavePermission <> True Then
			LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Our Camera runtime permission request was rejected, cannot proceed further"$, Colors.Red)
			
			LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Display an exception message in a toast notification"$, Colors.Red)
			ToastMessageShow("Permission required to scan QR codes", Constants.TOAST_DURATION_SHORT)
			
			LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Sub return"$, Colors.Red)
			Return
			
		Else
			LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Our Camera runtime permission request was approved, we can now proceed further"$, Colors.Green)
			
		End If
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: We got Camera runtime permission access (or the device runs an older version of Android which always gives access anyway)"$, Colors.Blue)
		
	End If
	
	'Hide the Admin Key field when the user wants to scan a QR code,
	'because they might stay a little while on scanning the QR code,
	'then forget that they didn't hide it when they come back
	'to the Main module:
	' - And if there's somebody else next to them, they might
	'   accidentally see their Admin key before the user
	'   quickly hides it back
	'
	'This is the responsility of this Main module to do this task
	'before calling other Activities,
	'see the MyForegroundRotationDetection's CheckIfForegroundRotation
	'function code for more explanations about how this is not a bug,
	'and why it's not the job of CheckIfForegroundRotation to detect
	'Activity switching while the app is always in the foreground
	'
	'Also do this before starting another Activity,
	'otherwise Activity_Pause will immediately run
	'and pause this Activity before you can hide it
	LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Must hide the Admin Key field before launching another Activity"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Hide the Admin Key field to avoid having it potentially leak visually for a few milliseconds on Activity resume..."$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: (Launching another Activity causes this one to get paused, so we have to this before launching another one)"$, Colors.Blue)
	chkHideAdminKey.Checked = True
	
	'When you start another Activity, this one's Activity_Pause
	'automatically gets fired and handles the rest for you
	'
	'You don't have anything else in particular to do now
	
	LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Launching the QR scanner module Activity"$, Colors.Blue)
	StartActivity(Scan)
	
	LogColor($"[${ActivityName}-${LogContextId}] btnScanQR_Click: Sub return"$, Colors.Blue)
End Sub

Private Sub edtAdminKey_FocusChanged(HasFocus As Boolean)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] edtAdminKey_FocusChanged: Sub entry (HasFocus = ${HasFocus})"$, Colors.Blue)
	
	If HasFocus Then
		LogColor($"[${ActivityName}-${LogContextId}] edtAdminKey_FocusChanged: HasFocus is True"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] edtAdminKey_FocusChanged: Set ViewState last focused element to "edtAdminKey""$, Colors.Blue)
		ViewState_LastFocusedElement = "edtAdminKey"
		
		'This will already call edtAdminKey_ShowSelectionInfo
		'which will update the Admin Key label
		LogColor($"[${ActivityName}-${LogContextId}] edtAdminKey_FocusChanged: Enable the Admin Key selection timer because the Admin Key field is focused"$, Colors.Blue)
		SelectionTimer_edtAdminKey.Enabled = True
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] edtAdminKey_FocusChanged: HasFocus is False"$, Colors.Blue)
		
		'Android doesn't reset the selection information of
		'EditText fields when the focus is lost
		'
		'So the EditText selection timers call their respective
		'EditText_ShowSelectionInfo method but these functions
		'think that the their EditText selection didn't change
		'
		'To fix this, I just forewarn that the last focused
		'element is "undetermined" and the EditTexts'
		'respective EditText_ShowSelectionInfo methods will
		'verify that their element still has the focus
		'thanks to this forewarning being done in advance
		LogColor($"[${ActivityName}-${LogContextId}] edtAdminKey_FocusChanged: Set ViewState last focused element to "undetermined" (will be set again properly by the next focused element)"$, Colors.Blue)
		ViewState_LastFocusedElement = "undetermined"
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] edtAdminKey_FocusChanged: Update neat borders for this EditText field (according to the state of HasFocus = ${HasFocus})"$, Colors.Blue)
	AddBordersToEditText(edtAdminKey, HasFocus)
	AddBordersToEditText(edtDecoyKey, HasFocus)
	
	'Setting the scroll position to be a right below the UI element
	'that 'tops' the Admin Key field (edtChallenge)
	'
	'It's not lblAdminKey because I think that it's neater this way
	'with edtChallenge instead (so that it scrolls a bit higher)
	LogColor($"[${ActivityName}-${LogContextId}] edtAdminKey_FocusChanged: Correct the scroll position to be better than Android's default scrolling to focused elements"$, Colors.Blue)
	scvActivity.ScrollPosition = edtChallenge.Top + edtChallenge.Height
	
	LogColor($"[${ActivityName}-${LogContextId}] edtAdminKey_FocusChanged: Sub return"$, Colors.Blue)
End Sub

Private Sub edtAdminKey_TextChanged(Old As String, New As String)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] edtAdminKey_TextChanged: Sub entry (sensitive parameters)"$, Colors.Blue)
	
	'The Admin Key field text might be changed even if
	'the Admin Key field is not focused, such as when
	'generating a SHA256, SHA512 etc hash while another
	'field is focused, so the TextChanged event should
	'also update the Admin Key label too
	LogColor($"[${ActivityName}-${LogContextId}] edtAdminKey_TextChanged: Running the edtAdminKey_ShowSelectionInfo Sub to update the Admin Key label text"$, Colors.Blue)
	edtAdminKey_ShowSelectionInfo
	
	LogColor($"[${ActivityName}-${LogContextId}] edtAdminKey_TextChanged: Sub return"$, Colors.Blue)
End Sub

Private Sub edtAdminKey_ShowSelectionInfo
	'Don't add logging here to avoid log spam
	'This function is called by a Timer Sub
	
	Dim TextLength, SelectionStart, SelectionLength, SelectionEnd As Int
	TextLength		= edtAdminKey.Text.Length
	SelectionStart	= edtAdminKey.SelectionStart
	SelectionLength	= edtAdminKey.SelectionLength
	SelectionEnd    = SelectionStart + SelectionLength
	
	'Only show selection information if the Admin Key field
	'is actually focused, otherwise show generic information
	Dim IsAdminKeyFocused As Boolean = (ViewState_LastFocusedElement == "edtAdminKey")
	
	'Visual neat tweak incase there's only one char
	'in the Admin Key field
	Dim chars As String
	
	'We say different from 1 instead of more than 1
	'This is because in theory 0 should be said as:
	' - "0 chars"
	'
	'Zero is a plural too, only the number 1 is singular
	'So this check lets both 0 and values more than 1 pass
	'
	'But no worries since we don't display the count
	'of characters if it's zero later on in this function
	'
	'This way of doing things is just so we stay correct
	'with number semantics and the plurality of language
	If TextLength <> 1 Then
		chars = "chars"
	Else
		chars = "char"
	End If
	
	If IsAdminKeyFocused And TextLength >= 1 And SelectionLength < 1 _
		And SelectionStart > 0 And SelectionStart < TextLength Then
		'When not selecting any text and just moving
		'the cursor (caret) around in the Admin key field
		'-[-------------|-------]-
		lblAdminKey.Text = $"Admin Key: (${TextLength} ${chars}) - Pos: ${SelectionStart}"$
		
	Else If IsAdminKeyFocused And TextLength >= 1 And SelectionLength >= 1 _
		And SelectionStart > 0 And SelectionEnd < TextLength Then
		'When selecting a part of text in the middle of the text
		'but not at the start of the text and also NOT all the
		'text until the end of it
		'-----xxxxxxxxxxxxxxx-----
		lblAdminKey.Text = $"Admin Key: (${TextLength} ${chars}) - Before: ${SelectionStart} | Sel: ${SelectionLength} | After: ${TextLength - SelectionEnd}"$
		
	Else If IsAdminKeyFocused And TextLength >= 1 And SelectionLength >= 1 _
		And SelectionStart > 0 Then
		'When selecting a part of text in the middle of the text
		'but not at the start of the text and also ALL the text
		'until the end of it
		'-----xxxxxxxxxxxxxxxxxxxx
		lblAdminKey.Text = $"Admin Key: (${TextLength} ${chars}) - Before: ${SelectionStart} | Sel: ${SelectionLength}"$
		
	Else If IsAdminKeyFocused And TextLength >= 1 And SelectionLength >= 1 _
		And SelectionStart == 0 And SelectionLength < TextLength Then
		
		'When selecting text starting at the first character
		'but not selecting the entire text length
		'xxxxxxxxxxxxxxxxxxxx-----
		lblAdminKey.Text = $"Admin Key: (${TextLength} ${chars}) - Sel: ${SelectionLength} | After: ${TextLength - SelectionEnd}"$
		
	Else If IsAdminKeyFocused And TextLength >= 1 And SelectionLength >= 1 _
		And SelectionStart == 0 Then
		'When all the text is selected
		'xxxxxxxxxxxxxxxxxxxxxxxxx
		lblAdminKey.Text = $"Admin Key: (${TextLength} ${chars}) - Sel: ${SelectionLength}"$
		
	Else If TextLength >= 1 Then
		'Admin key field not focused
		lblAdminKey.Text = $"Admin Key: (${TextLength} ${chars})"$
		
	Else
		'Admin key field empty
		lblAdminKey.Text = "Admin Key:"
		
	End If
	
End Sub

Private Sub SelectionTimer_edtAdminKey_Tick
	'Don't add logging here to avoid log spam
	'
	'Also make sure functions called by this one
	'don't include logging to avoid flooding
	'your logcat when you need to do debugging
	
	'If the Admin Key field is unfocused:
	'Make a call to edtAdminKey_ShowSelectionInfo atleast once
	'to reflect the change for the unfocused version of the
	'Admin Key label text
	'
	'Otherwise:
	'The timer wasn't disabled and cans keep looping to
	'continously update the Admin Key label text
	edtAdminKey_ShowSelectionInfo
	
	'Check if the Admin Key field is still focused
	If ViewState_LastFocusedElement <> "edtAdminKey" Then
		'Admin Key field is not focused
		
		'Disable this selection timer because it's not needed
		'when the Admin Key field is not focused
		SelectionTimer_edtAdminKey.Enabled = False
		
	End If
	
End Sub

Private Sub chkHideAdminKey_CheckedChange(Checked As Boolean)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: Sub entry (Checked = ${Checked})"$, Colors.Blue)
	
	If Checked Then
		'The Hide Admin Key Checkbox is checked
		'Its .Hint should also display bullet dots too
		
		LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: Set the Admin Key field .Hint (not .Text) to show bullets characters because Checked is True"$, Colors.Blue)
		edtAdminKey.Hint = DEFAULT_BULLETS_ADMIN_KEY
		
	Else
		'The Hide Admin Key Checkbox is unchecked
		'Its .Hint cans now display the default Admin Key zeroes
		LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: Set the Admin Key field .Hint (not .Text) to show zeroes characters because Checked if False"$, Colors.Blue)
		edtAdminKey.Hint = DEFAULT_ZEROES_ADMIN_KEY
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: Verifying if the Admin Key was made unrevealable before and the requested .Checked state is False"$, Colors.Blue)
	If Not(ViewState_chkHideAdminKey_Enabled) And Not(Checked) Then
		LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: We have a problem, looks like the Hide Admin Key checkbox was forcibly re-enabled using hacks"$, Colors.Red)
		LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: This might be a forensic Admin Key recovery attack"$, Colors.Red)
		
		'Close any visible modal window before exit
		'Then simulate a KEYCODE_BACK Activity keypress
		LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: Exiting the App by simulating user natural exit (close any visible modal window then send a Back activity keypress)"$, Colors.Red)
		btnHashMenu.Checked = False
		Activity_KeyPress(KeyCodes.KEYCODE_BACK)
		
		LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: Sub return (this code shouldn't be reachable if the Activity exited correctly)"$, Colors.Red)
		Return
		
	End If
	LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: All good, the caller isn't trying to reveal an unrevealable Admin key"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: The requested Checked value is ${Checked}"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: Set ViewState of this checkbox checked state to ${Checked}"$, Colors.Blue)
	ViewState_chkHideAdminKey_Checked = Checked
	
	'Allow preserving the selection state when toggling password modes
	LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: Saving information about the current selection state before toggling password modes"$, Colors.Blue)
	Dim LastSelectionStart, LastSelectionLength As Int
	LastSelectionStart  = edtAdminKey.SelectionStart
	LastSelectionLength = edtAdminKey.SelectionLength
	
	LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: Setting the Admin Key field password mode to PasswordMode = ${Checked}"$, Colors.Blue)
	edtAdminKey.PasswordMode = Checked
	
	'Allow preserving the selection state when toggling password modes
	LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: Restoring information about the previous selection state after toggling password modes"$, Colors.Blue)
	edtAdminKey.SetSelection(LastSelectionStart, LastSelectionLength)
	
	LogColor($"[${ActivityName}-${LogContextId}] chkHideAdminKey_CheckedChange: Sub return"$, Colors.Blue)
End Sub

Private Sub btnHashMenu_CheckedChange(Checked As Boolean)
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] btnHashMenu_CheckedChange: Sub entry (Checked = ${Checked})"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] btnHashMenu_CheckedChange: Set ViewState of this checkbox checked state to ${Checked}"$, Colors.Blue)
	ViewState_btnHashMenu_Checked = Checked
	
	If Checked Then
		LogColor($"[${ActivityName}-${LogContextId}] btnHashMenu_CheckedChange: The Hash Text button is checked"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnHashMenu_CheckedChange: Show the text hashing options menu"$, Colors.Blue)
		btnHashMenuBg.Visible = True
		btnSha256.Visible     = True
		btnSha512.Visible     = True
		
	Else
		LogColor($"[${ActivityName}-${LogContextId}] btnHashMenu_CheckedChange: The Hash Text button is unchecked"$, Colors.Blue)
		
		LogColor($"[${ActivityName}-${LogContextId}] btnHashMenu_CheckedChange: Hide the text hashing options menu"$, Colors.Blue)
		btnSha512.Visible     = False
		btnSha256.Visible     = False
		btnHashMenuBg.Visible = False
		
	End If
	
	LogColor($"[${ActivityName}-${LogContextId}] btnHashMenu_CheckedChange: Sub return"$, Colors.Blue)
End Sub

Private Sub btnHashMenuBg_Click
	Dim LogContextId As Int = Rnd(1000, 9999)
	LogColor($"[${ActivityName}-${LogContextId}] btnHashMenuBg_Click: Sub entry"$, Colors.Blue)
	
	LogColor($"[${ActivityName}-${LogContextId}] btnHashMenuBg_Click: The Hash Text menu shade background was clicked"$, Colors.Blue)
	LogColor($"[${ActivityName}-${LogContextId}] btnHashMenuBg_Click: Hide the text hashing options menu"$, Colors.Blue)
	btnHashMenu.Checked = False
	
	LogColor($"[${ActivityName}-${LogContextId}] btnHashMenuBg_Click: Sub return"$, Colors.Blue)
End Sub

