End Sub

Sub Activity_Start()
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Start: Sub entry"$, Colors.Black)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Start: Checking if this Activity's Lifecycle tracking is initialized..."$, Colors.Black)
	#End If
	If ForegroundRotationDetection == Null Or Not(ForegroundRotationDetection.IsInitialized) Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Start: This Activity's Lifecycle tracking is NOT initialized"$, Colors.Black)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Start: No need to proceed further"$, Colors.Black)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Start: Sub return"$, Colors.Black)
		#End If
		Return
		
	End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Start: This Activity's Lifecycle tracking is initialized, alright"$, Colors.Black)
	#End If
