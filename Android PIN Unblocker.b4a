#If Java
//
// Add missing onRestart runHook in Basic4Android
//
import android.content.Context;
import android.app.Activity;
import anywheresoftware.b4a.BA;
@Override
public void onRestart()
{
	// Call Android's super implementation (mandatory)
	super.onRestart();
	
	try
	{
		// Mimick Basic4Android's builtin runHook ability
		processBA.runHook("onrestart", this, null);
	}
	catch (Exception e)
	{
		// Nothing to do here
	}
}
#End If
'
'For detecting foreground device rotation
'
#If Java
import android.content.res.Configuration;
import android.content.Context;
import android.app.Activity;
import anywheresoftware.b4a.BA;
@Override
public void onConfigurationChanged(Configuration newConfig)
{
	// Call Android's super implementation (mandatory)
	super.onConfigurationChanged(newConfig);
	
	// Just so we know when the Activity receives
	// a mundane configuration changed event
	BA.LogInfo("** Activity (main) Configuration Changed **");
	
	//
	// We deliberately ignore mundane configuration change
	// events as set in the app manifest
	//
	// This makes sure that we know only device rotations
	// will destroy-then-recreate our App's Activity
	//
	
	/* Nothing to do here */
}
#End If
'
'Better method of checking for Admin keys shared to the App
'
#If Java
import android.content.Intent;
import anywheresoftware.b4a.BA;
import anywheresoftware.b4a.objects.IntentWrapper;
import android.content.Context;
import android.app.Activity;
import anywheresoftware.b4a.objects.ActivityWrapper;
public void _onNewIntent(Intent newIntent)
{
	BA.LogInfo("** Activity (main) NewIntent **");
	
	try
	{
		// The Basic-code function "Activity_NewIntent(NewIntent As Intent)"
		// actually takes an IntentWrapper object, not an Intent one
		//
		// And this is how Basic4Android's core library creates
		// an IntentWrapper object when you make one in Basic-code
		IntentWrapper wrappedNewIntent = new IntentWrapper();
		wrappedNewIntent.setObject(newIntent);
		
		//
		// Now we can send this wrapped Intent
		// to our Activity_NewIntent function
		//
		/*                    Activity,       DontIgnoreIfPaused, EventName,            ThrowErrorIfMissingSub, ParametersObjectArray */
		processBA.raiseEvent2(this._activity, true,               "activity_newintent", false,                  new Object[]{wrappedNewIntent});
	}
	catch (Exception e)
	{
		// Nothing to do here
	}
}
#End If
'
'Common type of _onCreate Java inline code
'
#If Java
import android.content.Context;
import android.app.Activity;
#End If
#If NO_FLAG_SECURE
'Hackish method for conditional compile-time Java code
#If Java
import android.os.Build;
import android.os.CountDownTimer;
import android.content.Intent;
#End If
#End If
#If Java
//
// Below is for detecting device idle state
// When the display is no longer 'interactive'
//
// Display off, screen locked, screensaver, inactivity [...]
//
import android.content.Intent;
import android.content.BroadcastReceiver;
import anywheresoftware.b4a.objects.ActivityWrapper;
import android.content.IntentFilter;

private static BroadcastReceiver DeviceIdleDetectionReceiver;

public void _onCreate()
{
	//
	// Disable the Activity TitleBar & ActionBar if needed
	//
	MainAdvanced.jDisableTitleBarAndActionBarIfNeeded(this);
	
	//
	// Disable the Android 8.0+ Autofill service (for security reasons)
	//
	MainAdvanced.jDisableAndroidAutofillService(this);
#End If
#If NO_FLAG_SECURE
#If Java
	// Check if the App is started from a Share To Intent
	// This checks if an Admin key was shared to the App
	//
	// It's currently only used in NO_FLAG_SECURE builds
	boolean isStartedFromShareToIntent = false;
	
	// We currently only use the isStartedFromShareToIntent flag
	// for displaying security toast notifications in the
	// NO_FLAG_SECURE build, so no need to run any of this code
	// below if the App is compiled with FLAG_SECURE
	//
	// FLAG_SECURE is the default build configuration and also
	// the configuration used for all compiled APK files
	// on Github release pages
	//
	// And also because the security toast notifications that
	// we use this Share To Intent dection for only runs on
	// the first-time App launch, no need to run it more than
	// once per App launch / App lifecycle either
	if ( isFirst ) // Undocumented Basic4Android variable
	{
		try
		{
			Intent  launchIntent = this.getIntent();
			String  launchAction = launchIntent.getAction();
			boolean hasTextExtra = launchIntent.hasExtra(Intent.EXTRA_TEXT);
			
			if ( launchAction == Intent.ACTION_SEND && hasTextExtra )
			{
				isStartedFromShareToIntent = true;
			}
		}
		catch (Exception e)
		{
			// Incase we have a botched value
			isStartedFromShareToIntent = false;
		}
	}
	
	//
	// Check if the App was compiled without FLAG_SECURE
	// and if this is the first-time Activity launch
	//
	if ( isFirst ) // Undocumented Basic4Android variable
	{
		/* Warn about the risks of using the NO_FLAG_SECURE build
		 * on Android versions where it's a security risks
		 *
		 * Don't warn yet on versions where it might
		 * not actually be a problem for security:
		 *  - API levels 33+ (Android 13+)
		 *  - API levels 14- (Android 4.0.2-)
		 *
		 * Only the below versions have no other way
		 * of disabling Recent Apps thumbnails other
		 * than using FLAG_SECURE:
		 *  - API levels 15+ up to API level 32
		 *    (from Android 4.0.3 up to Android 12)
		 */
		if ( Build.VERSION.SDK_INT >= 15 && Build.VERSION.SDK_INT < 33 )
		{
			//
			// Notify the user about the risks of running
			// a version of this App without FLAG_SECURE
			//
			// If user cannot be warned then exit the App
			// Better to be safe than sorry
			//
			
			/* By default no wait time for the first toast notification
			 * And only a short toast delay wait time for the second one
			 */
			int waitTimeForFirstToast  = 0;
			int waitTimeForSecondToast = myadvanced.TOAST_SHORT_DELAY;
			
			/* Do note that we wait a bit before showing the first
			 * toast notification, that's because if the user
			 * shares an invalid Admin key text to the App then
			 * the function responsible for handling it will also
			 * show a toast notification:
			 * 
			 * Then both toasts show at the same time but most
			 * of the time it's the "Shared Admin key is invalid"
			 * toast notification that wins and shows ontop of
			 * this more important one
			 *
			 * So we wait until any potential Basic-code startup
			 * toast notification has shown before showing the
			 * first security-related one
			 */
			if ( isStartedFromShareToIntent )
			{
				//
				// If started from a Share To Intent with
				// a shared Admin key text inside, then
				// the wait times are not the same now
				//
				// Now the first toast notification needs to wait
				// for any Basic-code toast to finish showing first
				//
				waitTimeForFirstToast  = waitTimeForFirstToast + myadvanced.TOAST_SHORT_DELAY;
				//
				// And the second toast notification waits 2x more
				//
				waitTimeForSecondToast = waitTimeForSecondToast + myadvanced.TOAST_SHORT_DELAY;
			}
			//
			// Transfer current context for onFinish function
			//
			// Needs not to use the "this" keyword since it
			// will just be the context of the onFinish function
			//
			Activity ctx = this;
			//
			// Using 500ms as the tick rate because
			// the durations for toasts are 2000ms & 3500ms
			// so that neatly aligns with both durations
			//
			new CountDownTimer(waitTimeForFirstToast, 500)
			{
				@Override
				public void onTick(long millisUntilFinished) { }
				
				@Override
				public void onFinish()
				{
					if ( !MainAdvanced.jToastMessageShow(ctx, "This build of the app is insecure", myadvanced.TOAST_DURATION_SHORT) )
					{
						MainAdvanced.jBetterActivityFinish(ctx);
						mycommon.jTrueApplicationExit();
					}
				}
			}.start();
			
			//
			// Wait until the first toast disappears
			// before showing another one
			//
			new CountDownTimer(waitTimeForSecondToast, 500)
			{
				@Override
				public void onTick(long millisUntilFinished) { }
				
				@Override
				public void onFinish()
				{
					if ( !MainAdvanced.jToastMessageShow(ctx, "Admin keys might leak in this build", myadvanced.TOAST_DURATION_LONG) )
					{
						MainAdvanced.jBetterActivityFinish(ctx);
						mycommon.jTrueApplicationExit();
					}
				}
			}.start();
		}
	}
#End If
#End If
#If Java
	//
	// Make this App Activity secure
	//
	MainAdvanced.jSecureActivityOnCreate(this, isFirst); // Undocumented Basic4Android variable
	
	// Below is for detecting device idle state
	// When the display is no longer 'interactive'
	//
	// Display off, screen locked, screensaver, inactivity [...]
	//
	// "_activity" (ActivityWrapper) is not a public field so we have to
	// explicitly give an handle to it for the IdleDeviceReceiver class
	this.DeviceIdleDetectionReceiver = new myadvanced.IdleDeviceReceiver(this.processBA, this._activity);
	this.registerReceiver(DeviceIdleDetectionReceiver, myadvanced.jGetIdleDeviceIntentFilter());
}
#End If
'
'For detecting screen off / screen locked / sleep mode
'
'On legacy devices such as those running Android 2.3,
'the app's Activity is not paused on screen lock,
'so it doesn't fire a resume event either
'
'On such old legacy devices, this function is considered
'as very important before it's their only way of breaking
'the Activity Lifecycle tracking and hiding the Admin key
'on device screen off then unlock
'
Sub Activity_Idle
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Idle: Sub entry"$, Colors.Black)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Idle: This event was fired, so the device is idle (non-interactive UI state)"$, Colors.Black)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Idle: Setting the Hide Admin Key checkbox's ViewState to Checked and resetting the Activity Lifecycle tracking"$, Colors.Black)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Idle: This will make it even quicker to securely hide the Admin Key on slow devices during application resume"$, Colors.Black)
	#End If
	
	'Update the ViewState of the Hide Admin Key checkbox
	'for the next Activity resume, because receivers are
	'only called after Activity events
	'
	'That means our SaveViewState function actually ran
	'before this one, so we have to catch up on it
	'
	'Also it's not possible to directly update chkHideAdminKey
	'because when the activity is stopped (unlike paused)
	'the Activity's UI elements are inaccessible (they are Null)
	ViewState_chkHideAdminKey_Checked = True
	
	'Clear Activity Lifecycle tracking
	'
	'We clear the ActivityLifecycle tracking
	'because we want to prevent any possibility
	'for the app to potentially mistake the next
	'application resume as from a foreground
	'device rotation event
	'
	'Clearing the Activity Lifecycle tracking
	'is therefore a bonus safety precaution
	ForegroundRotationDetection.ActivityLifecycle = ""
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Idle: Sub return"$, Colors.Black)
	#End If
End Sub
'
'For detecting foreground device rotation
'
Sub Activity_Stop()
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Stop: Sub entry"$, Colors.Black)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Stop: Checking if this Activity's Lifecycle tracking is initialized..."$, Colors.Black)
	#End If
	If ForegroundRotationDetection == Null Or Not(ForegroundRotationDetection.IsInitialized) Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Stop: This Activity's Lifecycle tracking is NOT initialized"$, Colors.Black)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Stop: No need to proceed further"$, Colors.Black)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Stop: Sub return"$, Colors.Black)
		#End If
		Return
		
	End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Stop: This Activity's Lifecycle tracking is initialized, alright"$, Colors.Black)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Stop: Now we can proceed further"$, Colors.Black)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Stop: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Black)
	#End If
	ForegroundRotationDetection.ActivityLifecycle = ForegroundRotationDetection.ActivityLifecycle & ForegroundRotationDetection.Stop
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Stop: New Activity lifecycle tracking value: "$&ForegroundRotationDetection.ActivityLifecycle, Colors.Black)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Stop: Sub return"$, Colors.Black)
	#End If
End Sub

Sub Activity_Destroy(IsFinishing As Boolean, IsChangingConfigurations As Boolean)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Destroy: Sub entry (IsFinishing = ${IsFinishing}, IsChangingConfigurations = ${IsChangingConfigurations})"$, Colors.Black)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Destroy: Checking if this Activity's Lifecycle tracking is initialized..."$, Colors.Black)
	#End If
	If ForegroundRotationDetection == Null Or Not(ForegroundRotationDetection.IsInitialized) Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Destroy: This Activity's Lifecycle tracking is NOT initialized"$, Colors.Black)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Destroy: No need to proceed further"$, Colors.Black)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Destroy: Sub return"$, Colors.Black)
		#End If
		Return
		
	End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Destroy: This Activity's Lifecycle tracking is initialized, alright"$, Colors.Black)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Destroy: Now we can proceed further"$, Colors.Black)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Destroy: Checking if the Activity is finishing for real..."$, Colors.Black)
	#End If
	If IsFinishing And Not(IsChangingConfigurations) Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Destroy: The Activity is finishing for real, no need to update this Activity's Lifecycle tracking"$, Colors.Black)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Destroy: Resetting this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Black)
		#End If
		ForegroundRotationDetection.ActivityLifecycle = ""
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Destroy: New Activity lifecycle tracking value: "$&ForegroundRotationDetection.ActivityLifecycle, Colors.Black)
		#End If
		
		'
		'Don't fully kill the app here because that's how
		'Android works when you share an Admin Key text to
		'the app while it's running
		'
		'Basically Android will kill the previous instance
		'of the app before firing Activity_NewIntent
		'
		'Otherwise if you e.g. write something in the
		'Response code field and want to share that
		'to the app while it's running, the app would
		'fully close itself (app exit)
		'
		'This was the proper way of doing things but
		'Android unfortunately doesn't like this way
		'of doing things, so we don't fully kill
		'the app here; we let Activity_Pause do it
		'when it's appropriate (UserClosed == True)
		'
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Destroy: Sub return"$, Colors.Blue)
		#End If
		Return
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Destroy: The Activity is not finishing for real, alright"$, Colors.Black)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Destroy: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Black)
		#End If
		ForegroundRotationDetection.ActivityLifecycle = ForegroundRotationDetection.ActivityLifecycle & ForegroundRotationDetection.Destroy
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Destroy: New Activity lifecycle tracking value: "$&ForegroundRotationDetection.ActivityLifecycle, Colors.Black)
		#End If
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Destroy: Sub return"$, Colors.Black)
	#End If
End Sub

Sub Activity_Restart()
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Restart: Sub entry"$, Colors.Black)
	#End If
	
