import android.app.Activity;
public float jGetDeviceScale()
{
	return MainAdvanced.jGetDeviceScale(this);
}

import android.content.Context;
import android.app.Activity;
public void jOpenBrowserUrl(String browserUrl)
{
	MainAdvanced.jOpenBrowserUrl(this, browserUrl);
}
