Private Sub btnHash_LongClick(HashType As String)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_LongClick: Sub entry (HashType = ${HashType})"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_LongClick: Now the Admin Key field will be permanently hidden for this App lifecycle"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_LongClick: Calling LockdownAdminKeyField to make the Admin Key unrevealable"$, Colors.Blue)
	#End If
	LockdownAdminKeyField
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_LongClick: Calling btnHash_Click("${HashType}")"$, Colors.Blue)
	#End If
	btnHash_Click(HashType)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_LongClick: Sub return"$, Colors.Blue)
	#End If
End Sub

Private Sub btnHash_Click(HashType As String)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_Click: Sub entry (HashType = ${HashType})"$, Colors.Blue)
	#End If
	
	Dim Text, TextHash As String
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_Click: Fetching the text to hash from the Admin Key field (sensitive value)"$, Colors.Blue)
	#End If
	Text     = edtAdminKey.Text
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_Click: Hashing the fetched Admin Key text (sensitive value) with ${HashType}"$, Colors.Blue)
	#End If
	TextHash = Cryptography.TextToHash(Text, HashType)
	
	'Verify if the returned hash has a correct format
	'It must be Hexadecimal characters
	'
	'This also verifies that the return value isn't empty,
	'because strings representing Hex bytes are atleast
	'2-chars of text length (so not empty string)
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_Click: Verify if there was no problem hashing text with ${HashType}"$, Colors.Blue)
	#End If
	If Cryptography.VerifyIfTextIsHexBytes(TextHash) Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnHash_Click: No problem found while hashing text with ${HashType}"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnHash_Click: Setting the Admin Key field .Text content with the generated ${HashType} (sensitive value)"$, Colors.Blue)
		#End If
		edtAdminKey.Text = TextHash
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnHash_Click: There was a problem while hashing text with ${HashType}"$, Colors.Red)
		#End If
		
		'Don't clear the Admin key text input on failure
		'because it would be a bit harsh to do that
		'just show an exception text in a toast message
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnHash_Click: Don't clear the Admin Key field .Text because it would be too harsh (even for showing an exception message)"$, Colors.Red)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnHash_Click: Displaying an exception message in a toast notification instead"$, Colors.Red)
		#End If
		ToastMessageShow($"Failed to generate ${HashType}"$, Constants.TOAST_DURATION_SHORT)
		
	End If
	
	'Request running the garbage collector as soon as possible
	'This way old values will be soon cleared from the App's memory
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_Click: Requesting a JVM garbage collection as soon as possible to discard this function's old text-related variable contents"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_Click: We do the JVM garbage collection call even if the text hashing was unsuccessful, because atleast the Text variable must be discarded as soon as possible"$, Colors.Blue)
	#End If
	Security.TriggerJvmGarbageCollection
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_Click: Now closing the text hashing options menu"$, Colors.Blue)
	#End If
	btnHashMenu.Checked = False
	
	'Visually bring attention to the Admin key field
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_Click: Setting current focused element to the Admin Key field to bring visual attention to it"$, Colors.Blue)
	#End If
	edtAdminKey.RequestFocus
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHash_Click: Sub return"$, Colors.Blue)
	#End If
End Sub
'-------------------------
#End Region

#Region Generate (response code) button event handlers

Private Sub btnGenerate_Click
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Sub entry"$, Colors.Blue)
	#End If
	
	'Reset the Response Code label before generating a new Response Code
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Resetting the Response code label before generating a new Response code"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: If a correct challenge-response algorithm is not found, then this default value stays"$, Colors.Blue)
	#End If
	lblResponse.Text = "Response:"
	
	'Reset the Response Code field before generating a new Response Code
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Resetting the Response code field .Text before generating a new Response code"$, Colors.Blue)
	#End If
	edtResponse.Text = ""
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Fetching the Challenge code & Admin Key .Text values for sanitization (sensitive values)"$, Colors.Blue)
	#End If
	Dim SanitizedUserInputs() As String = GetSanitizedUserInputs(edtChallenge.Text, edtAdminKey.Text)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Checking whether the Challenge code & Admin Key values were valid and sanitized"$, Colors.Blue)
	#End If
	If SanitizedUserInputs(0) == False Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: The Challenge code and/or Admin Key value(s) were invalid and therefore not returned sanitized"$, Colors.Magenta)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: Set the Response code field .Hint value to the reason for why the input(s) were invalid"$, Colors.Magenta)
		#End If
		edtResponse.Hint = SanitizedUserInputs(1)
		
		'Unfocus the Admin key field when the user clicks Generate (if it was focused)
		'
		'This helps makes the Admin key cursor position Timer run less often,
		'especially useful since after generating the Response codes,
		'the user might take some while to read & copy it on their computer
		'
		'Focus instead on the Response code field (bring visual attention to it)
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: Setting the focus on the Response code field to bring visual attention to it"$, Colors.Magenta)
		#End If
		edtResponse.RequestFocus
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: Sub return"$, Colors.Magenta)
		#End If
		Return
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Both the Challenge code & Admin Key values were verified as correct and matching a supported algorithm"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Fetching the sanitized Challenge code & Admin Key values from the return of GetSanitizedUserInputs (sensitive values)"$, Colors.Blue)
	#End If
	Dim SanitizedChallenge, SanitizedAdminKey As String
	SanitizedChallenge = SanitizedUserInputs(1)
	SanitizedAdminKey  = SanitizedUserInputs(2)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Now we need to determine which challenge-response algorithm to use, running DetectChallengeAlgorithm (sensitive parameters)"$, Colors.Blue)
	#End If
	Dim DetectedAlgorithm As String = DetectChallengeAlgorithm(SanitizedChallenge, SanitizedAdminKey)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Setting the initial Response code value to empty"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: If generating a response code fails, then this allows displaying the Response code field's .Hint value (where the exception messages are displayed)"$, Colors.Blue)
	#End If
	Dim ResponseCode      As String = ""
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Checking what was the detected algorithm to use"$, Colors.Blue)
	#End If
	If DetectedAlgorithm == Cryptography.CRYPTOGRAPHY_ALGORITHM_3DES _
	Or DetectedAlgorithm == Cryptography.CRYPTOGRAPHY_ALGORITHM_2DES Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: The detected algorithm is ${DetectedAlgorithm}"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: Running the TripleDesEncrypt function for ${DetectedAlgorithm}"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: The TripleDesEncrypt function supports both 2DES & 3DES"$, Colors.Blue)
		#End If
		ResponseCode = Cryptography.TripleDesEncrypt(SanitizedChallenge, SanitizedAdminKey)
		
	Else If DetectedAlgorithm == Cryptography.CRYPTOGRAPHY_ALGORITHM_AES128 _
	     Or DetectedAlgorithm == Cryptography.CRYPTOGRAPHY_ALGORITHM_AES256 Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: The detected algorithm is ${DetectedAlgorithm}"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: Running the AesEncrypt function for ${DetectedAlgorithm}"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: The AesEncrypt function supports both AES-128 & AES-256"$, Colors.Blue)
		#End If
		ResponseCode = Cryptography.AesEncrypt(SanitizedChallenge, SanitizedAdminKey)
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: No known algorithm could be detected ${DetectedAlgorithm}"$, Colors.Magenta)
		#End If
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Checking if the generated Response code is valid"$, Colors.Blue)
	#End If
	If Not(Cryptography.VerifyIfTextIsHexBytes(ResponseCode)) Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: The generated Response code is invalid"$, Colors.Red)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: The Response code field .Text value stays the initial one we have set before at the start of this function"$, Colors.Red)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: Setting the Response code field .Hint value to let the user know about the error"$, Colors.Red)
		#End If
		edtResponse.Hint = "Failed to compute"
		
		'Unfocus the Admin key field when the user clicks Generate (if it was focused)
		'
		'This helps makes the Admin key cursor position Timer run less often,
		'especially useful since after generating the Response codes,
		'the user might take some while to read & copy it on their computer
		'
		'Focus instead on the Response code field (bring visual attention to it)
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: Setting the focus on the Response code field to bring visual attention to it"$, Colors.Red)
		#End If
		edtResponse.RequestFocus
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: Sub return"$, Colors.Red)
		#End If
		Return
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: The generated Response code is valid, we can proceed further"$, Colors.Blue)
		#End If
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Checking if a correct algorithm was detected"$, Colors.Blue)
	#End If
	If DetectedAlgorithm <> Cryptography.CRYPTOGRAPHY_ALGORITHM_UNKNOWN Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: A correct algorithm detected"$, Colors.Blue)
		#End If
		
		'Notice the space between the Response code label
		'and the detected algorithm
		'
		'Otherwise it would give a result such as:
		' - "Response:3DES (DES-EDE3)"
		'
		'What we instead want is a result such as:
		' - "Response: 3DES (DES-EDE3)"
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: Updating the Response code label with the detected algorithm ${DetectedAlgorithm}"$, Colors.Blue)
		#End If
		lblResponse.Text = $"${lblResponse.Text} ${DetectedAlgorithm}"$
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: No correct algorithm was detected"$, Colors.Magenta)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnGenerate_Click: The Response code label .Text value stays the initial one we have set before at the start of this function"$, Colors.Magenta)
		#End If
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Checking the exact length of the generated Response code"$, Colors.Blue)
	#End If
	Select ResponseCode.Length
		Case 16
			#If LOGGING
			LogColor($"[Main-${LogContextId}] btnGenerate_Click: The response code length is 16 chars, setting 4x 4-chars separation on it"$, Colors.Blue)
			#End If
			ResponseCode =	Regex.Replace2("^([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})$", _
								Regex.CASE_INSENSITIVE, ResponseCode, "$1 $2 $3 $4")
		Case 32
			#If LOGGING
			LogColor($"[Main-${LogContextId}] btnGenerate_Click: The response code length is 32 chars, setting 8x 4-chars separation on it"$, Colors.Blue)
			#End If
			ResponseCode =	Regex.Replace2("^([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})$", _
								Regex.CASE_INSENSITIVE, ResponseCode, "$1 $2 $3 $4 $5 $6 $7 $8")
		Case 64
			#If LOGGING
			LogColor($"[Main-${LogContextId}] btnGenerate_Click: The response code length is 32 chars, setting 16x 4-chars separation on it"$, Colors.Blue)
			#End If
			'First part of the AES-256 response code:
			'Match from the beginning without the end ('$' character)
			'Also add a trailing space to separate the two response code parts
			ResponseCode =	Regex.Replace2("^([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})", _
								Regex.CASE_INSENSITIVE, ResponseCode, "$1 $2 $3 $4 $5 $6 $7 $8 ")
			'Second part of the AES-256 response code:
			'Here for the second part match it from the end (no '^' character at the beginning)
			ResponseCode =	Regex.Replace2("([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})$", _
								Regex.CASE_INSENSITIVE, ResponseCode, "$1 $2 $3 $4 $5 $6 $7 $8")
			
		Case Else
			#If LOGGING
			LogColor($"[Main-${LogContextId}] btnGenerate_Click: The response code length is not a length supported for setting separation on it yet"$, Colors.Magenta)
			#End If
			#If LOGGING
			LogColor($"[Main-${LogContextId}] btnGenerate_Click: Not setting any separation on it, leaving it as-is"$, Colors.Magenta)
			#End If
			
	End Select
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Setting the Response code field .Text value to the generated Response code"$, Colors.Blue)
	#End If
	edtResponse.Text = ResponseCode
	
	'Unfocus the Admin key field when the user clicks Generate (if it was focused)
	'
	'This helps makes the Admin key cursor position Timer run less often,
	'especially useful since after generating the Response codes,
	'the user might take some while to read & copy it on their computer
	'
	'Focus instead on the Response code field (bring visual attention to it)
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Setting the focus on the Response code field to bring visual attention to it"$, Colors.Blue)
	#End If
	edtResponse.RequestFocus
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnGenerate_Click: Sub return"$, Colors.Blue)
	#End If
End Sub

'If the inputs are valid then the return is:
'
'String Array = ReturnValue(0) = (Boolean) IsValidInput = True
'               ReturnValue(1) = (String)  SanitizedChallenge
'               ReturnValue(2) = (String)  SanitizedAdminKey
'
'If the inputs are invalid then the return is:
'
'String Array = ReturnValue(0) = (Boolean) IsValidInput = False
'               ReturnValue(1) = (String)  ReasonForWhyInputsAreInvalid
'               <there's no index 2 returned if inputs are invalid>
Private Sub GetSanitizedUserInputs(ChallengeCode As String, AdminKey As String) As String()
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Sub entry (sensitive parameters)"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Trimming space and hyphen separators from the Challenge code & Admin Key if any"$, Colors.Blue)
	#End If
	Dim SanitizedChallenge	As String = ChallengeCode.Replace(" ", "").Replace("-", "")
	Dim SanitizedAdminKey	As String = AdminKey     .Replace(" ", "").Replace("-", "")
	
	'The Admin Key field supports line breaks,
	'so we should also automatically trim them
	'
	'It supports line breaks because it's also
	'used for generating text hashes
	'
	'Some people also write their 3DES Admin Key
	'as 3 separate lines for each DES key too
	#If LOGGING
	LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Trimming line breaks from the Admin Key if any"$, Colors.Blue)
	#End If
	SanitizedAdminKey = SanitizedAdminKey.Replace(CRLF, "")
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Checking if any of the trimmed input values are now empty"$, Colors.Blue)
	#End If
	If SanitizedChallenge == "" Or SanitizedAdminKey == "" Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Atleast one of the inputs is now empty, returning False validity status & the appropriate invalidity reason"$, Colors.Magenta)
		#End If
		Return Array As String(False, "Some input(s) are empty")
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Both inputs have been verified as not being empty, verifying if they are valid strings representing Hex bytes"$, Colors.Blue)
	#End If
	If	Not(Cryptography.VerifyIfTextIsHexBytes(SanitizedChallenge))     _
		Or Not(Cryptography.VerifyIfTextIsHexBytes(SanitizedAdminKey))   _
	Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Atleast one of the inputs is not a correct string representing Hex bytes, returning False validity status & the appropriate invalidity reason"$, Colors.Magenta)
		#End If
		Return Array As String(False, "Input(s) must be Hex bytes")
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Both inputs have been verified as being valid strings representing Hex bytes, verifying if they are of correct supported lengths each"$, Colors.Blue)
	#End If
	'Challenge codes can currently only ever be 16, 32 or 64 chars
	Dim KnownChallengeLength As Boolean =	SanitizedChallenge.Length == 16 Or _
											SanitizedChallenge.Length == 32 Or _
											SanitizedChallenge.Length == 64
	
	'Admin Keys can currenly only ever be 32, 48 or 64 chars
	Dim KnownAdminKeyLength  As Boolean =	SanitizedAdminKey.Length == 32 Or _
											SanitizedAdminKey.Length == 48 Or _
											SanitizedAdminKey.Length == 64
	'Now do the actual verification (much cleaner with two Booleans)
	If Not(KnownChallengeLength) Or Not(KnownAdminKeyLength) Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Atleast one of the inputs does not have a correct supported length, returning False validity status & the appropriate invalidity reason"$, Colors.Magenta)
		#End If
		Return Array As String(False, "Wrong input length(s)")
		
	End If
	
	'Identify Algorithm mismatches between Challenges & Admin keys
	'
	'If using DES-EDE2 the Admin Key will be 32 chars and the challenge 16 chars
	'If using DES-EDE3 the Admin Key will be 48 chars and the challenge 16 chars
	'If using AES-128  the Admin Key and challenge code will be 32 chars each
	'If using AES-256  the Admin Key and challenge code will be 64 chars each
	#If LOGGING
	LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Both inputs have been verified to have correct supported lengths, now checking for Challenge vs. Admin Key algorithm mismatches"$, Colors.Blue)
	#End If
	'AES-128
	If	SanitizedChallenge.Length == 32 And _		'AES-128 challenge
		SanitizedAdminKey.Length  <> 32 Then		'Not AES-128 Admin Key
		#If LOGGING
		LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Algorithm mismatch detected because the Challenge needs an AES-128 Admin Key but the provided one isn't, returning False validity status & the appropriate invalidity reason"$, Colors.Magenta)
		#End If
		Return Array As String(False, "Code needs AES-128 key")
		
	'DES-EDE3 / DES-EDE2
	Else If	SanitizedChallenge.Length == 16 And _	'DES-EDE2 or DES-EDE3 challenge
			SanitizedAdminKey.Length  <> 32 And _	'Not DES-EDE2 Admin Key (2DES)
			SanitizedAdminKey.Length  <> 48 Then	'Not DES-EDE3 Admin Key (3DES)
		#If LOGGING
		LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Algorithm mismatch detected because the Challenge needs a 2DES or 3DES Admin Key but the provided one is neither, returning False validity status & the appropriate invalidity reason"$, Colors.Magenta)
		#End If
		Return Array As String(False, "Code needs 2/3DES key")
		
	'AES-256
	Else If	SanitizedChallenge.Length == 64 And _	'AES-256 challenge
			SanitizedAdminKey.Length  <> 64 Then	'Not AES-256 Admin Key
		#If LOGGING
		LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Algorithm mismatch detected because the Challenge needs an AES-256 Admin Key but the provided one isn't, returning False validity status & the appropriate invalidity reason"$, Colors.Magenta)
		#End If
		Return Array As String(False, "Code needs AES-256 key")
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: Both inputs have been verified not to be empty, to have correct supported lengths, and no algorithm mismatches"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] GetSanitizedUserInputs: We can return the sanitized Admin Key and Challenge code values now (sensitive values)"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Sub return (returning String(True, <the sanitized Challenge code>, <the sanitized Admin Key>))"$, Colors.Blue)
	#End If
	Return Array As String(True, SanitizedChallenge, SanitizedAdminKey)
	
End Sub

'This function takes already-sanitized inputs
Private Sub DetectChallengeAlgorithm(SanitizedChallenge As String, SanitizedAdminKey As String) As String
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Sub entry (sensitive parameters)"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: This function takes already sanitized parameters"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Set initial detected algorithm to ${Cryptography.CRYPTOGRAPHY_ALGORITHM_UNKNOWN}"$, Colors.Blue)
	#End If
	Dim DetectedAlgorithm As String = Cryptography.CRYPTOGRAPHY_ALGORITHM_UNKNOWN
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Checking the sanitized Admin Key and Challenge code lengths to determine the correct algorithm"$, Colors.Blue)
	#End If
	If	SanitizedAdminKey.Length == 48 And SanitizedChallenge.Length == 16 Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Sanitized Admin Key and Challenge codes are 48 and 16 chars respectively"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Setting the detected algorithm value to ${Cryptography.CRYPTOGRAPHY_ALGORITHM_3DES}"$, Colors.Blue)
		#End If
		DetectedAlgorithm = Cryptography.CRYPTOGRAPHY_ALGORITHM_3DES
		
	Else If	SanitizedAdminKey.Length == 32 And SanitizedChallenge.Length == 16 Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Sanitized Admin Key and Challenge codes are 32 and 16 chars respectively"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Setting the detected algorithm value to ${Cryptography.CRYPTOGRAPHY_ALGORITHM_2DES}"$, Colors.Blue)
		#End If
		DetectedAlgorithm = Cryptography.CRYPTOGRAPHY_ALGORITHM_2DES
		
	Else If	SanitizedAdminKey.Length == 32 And SanitizedChallenge.Length == 32 Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Sanitized Admin Key and Challenge codes are 32 and 32 chars respectively"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Setting the detected algorithm value to ${Cryptography.CRYPTOGRAPHY_ALGORITHM_AES128}"$, Colors.Blue)
		#End If
		DetectedAlgorithm = Cryptography.CRYPTOGRAPHY_ALGORITHM_AES128
		
	Else If	SanitizedAdminKey.Length == 64 And SanitizedChallenge.Length == 64 Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Sanitized Admin Key and Challenge codes are 64 and 64 chars respectively"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Setting the detected algorithm value to ${Cryptography.CRYPTOGRAPHY_ALGORITHM_AES256}"$, Colors.Blue)
		#End If
		DetectedAlgorithm = Cryptography.CRYPTOGRAPHY_ALGORITHM_AES256
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Sanitized Admin Key and Challenge codes are ${SanitizedAdminKey.Length} and ${SanitizedChallenge.Length} chars respectively"$, Colors.Magenta)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Could not detect any suitable challenge-response algorithm"$, Colors.Magenta)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: The detected algorithm value stays the initial value ${DetectedAlgorithm}"$, Colors.Magenta)
		#End If
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] DetectChallengeAlgorithm: Sub return (returning ${DetectedAlgorithm})"$, Colors.Blue)
	#End If
	Return DetectedAlgorithm
End Sub

#End Region

#Region Response code field event handlers

Private Sub edtResponse_FocusChanged(HasFocus As Boolean)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] edtResponse_FocusChanged: Sub entry (HasFocus = ${HasFocus})"$, Colors.Blue)
	#End If
	
	If HasFocus Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtResponse_FocusChanged: HasFocus is True"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtResponse_FocusChanged: Set ViewState last focused element to "edtResponse""$, Colors.Blue)
		#End If
		ViewState_LastFocusedElement = "edtResponse"
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtResponse_FocusChanged: HasFocus is False"$, Colors.Blue)
		#End If
		
		'Android doesn't reset the selection information of
		'EditText fields when the focus is lost
		'
		'So the EditText selection timers call their respective
		'EditText_ShowSelectionInfo method but these functions
		'think that the their EditText selection didn't change
		'
		'To fix this, I just forewarn that the last focused
		'element is "undetermined" and the EditTexts'
		'respective EditText_ShowSelectionInfo methods will
		'verify that their element still has the focus
		'thanks to this forewarning being done in advance
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtResponse_FocusChanged: Set ViewState last focused element to "undetermined" (will be set again properly by the next focused element)"$, Colors.Blue)
		#End If
		ViewState_LastFocusedElement = "undetermined"
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] edtResponse_FocusChanged: Sub return"$, Colors.Blue)
	#End If
End Sub

#End Region

#Region Share To button event handlers

Private Sub btnShareTo_Click
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnShareTo_Click: Sub entry"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnShareTo_Click: Preparing a Share To Intent for sharing the Response code"$, Colors.Blue)
	#End If
	Dim ShareIntent As Intent
	ShareIntent.Initialize(ShareIntent.ACTION_SEND, Constants.INTENT_NO_SPECIFIC_TARGET)
	
	ShareIntent.SetType("text/plain")
	ShareIntent.PutExtra("android.intent.extra.TEXT", edtResponse.Text)
	
	ShareIntent.WrapAsIntentChooser("Share the Response code")
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnShareTo_Click: Starting the previously prepared Share To Intent to share the Response code"$, Colors.Blue)
	#End If
	StartActivity(ShareIntent)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnShareTo_Click: Sub return"$, Colors.Blue)
	#End If
End Sub

#End Region

#End Region
