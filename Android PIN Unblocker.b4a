	#End If
End Sub
'
'This function is important, we now use it instead of Activity_Resume
'when we want to check for any shared Admin key texts
'
Sub Activity_NewIntent(NewIntent As Intent)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_NewIntent: Sub entry (NewIntent = {Action: "${NewIntent.Action}", HasTextExtra: ${NewIntent.HasExtra("android.intent.extra.TEXT")}})"$, Constants.COLORS_ORANGE)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_NewIntent: Sub entry (Text ExtraData will never be shown in logs, as it's considered sensitive information)"$, Constants.COLORS_ORANGE)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_NewIntent: Checking if any Admin Key was shared to this App"$, Constants.COLORS_ORANGE)
	#End If
	CheckIfAdminKeySharedToTheApp(NewIntent)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_NewIntent: Sub return"$, Constants.COLORS_ORANGE)
	#End If
End Sub

Private Sub CheckIfAdminKeySharedToTheApp(ReceivedIntent As Intent)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Sub entry"$, Colors.Blue)
	#End If
	
	'This variable will receive the Share To
	'Intents TEXT extra data if applicable
	Dim ReceivedText As String
	
	'Add ability to receive Admin Key with Android's Share To
	#If LOGGING
	LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Checking what the starting Intent is"$, Colors.Blue)
	#End If
	If  ReceivedIntent.Action == ReceivedIntent.ACTION_SEND  _
	And ReceivedIntent.HasExtra("android.intent.extra.TEXT") Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: The starting Intent is ACTION_SEND and it contains a TEXT extra"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Fetching the shared Admin Key text from the Share To Intent's TEXT extra"$, Colors.Blue)
		#End If
		ReceivedText = ReceivedIntent.GetExtra("android.intent.extra.TEXT")
		
		'Return: ReturnValue(0) = whether it's a different truncated rehash (True / False)
		'        ReturnValue(1) = the truncated rehash, empty if verification
		'                         returns a False status
		'
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Generating a truncated text rehash of the currently shared Admin Key text and verifying if it's different from our previous one"$, Colors.Blue)
		#End If
		Dim TruncatedHashDifferentStatusAndNewHash() As String = Security.GetTruncatedHashDifferentStatusAndGetNewHash(ReceivedText, PreviouslySharedTextTruncatedRehash)
		
		'Check if the truncated text rehash is different
		'from the previously shared one (False = same one)
		If TruncatedHashDifferentStatusAndNewHash(0) == False Then
			#If LOGGING
			LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: The shared Admin Key text is the same as the previous one"$, Colors.Magenta)
			#End If
			#If LOGGING
			LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Ignoring Android's Share To Intent spam on every App resume..."$, Colors.Magenta)
			#End If
			
			#If LOGGING
			LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Sub return"$, Colors.Magenta)
			#End If
			Return
			
		End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: The shared Admin Key text is different from the previous one"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: So it was not an Android Share To Intent spam afterall..."$, Colors.Blue)
		#End If
		
		'Return: ReturnValue(0) = whether it's a different truncated rehash (True / False)
		'        ReturnValue(1) = the truncated rehash, empty if verification
		'                         returns a False status
		'
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Remembering this Admin Key text (in truncated rehash form) for future Intent spam identification purposes"$, Colors.Blue)
		#End If
		PreviouslySharedTextTruncatedRehash = TruncatedHashDifferentStatusAndNewHash(1)
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: The starting Intent is not something we specifically care about"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: It's something other than an ACTION_SEND with a TEXT extra, so ignoring it"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Sub return"$, Colors.Blue)
		#End If
		Return
		
	End If
	
	'
	'This part of the function cans only be reached
	'if the Share To Intent has ACTION_SEND and has
	'a TEXT extra inside
	'
	
	'Admin Keys can be 64-digits, 48-digits or 32-digits (Hex string)
	'64 = AES-256
	'48 = 3DES (DES-EDE3)
	'32 = AES-128 / 2DES (DES-EDE2)
	#If LOGGING
	LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Checking whether the shared Admin Key text (or hash) is valid"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: It must be a string representing Hex bytes and be atleast 32 chars"$, Colors.Blue)
	#End If
	If Cryptography.VerifyIfTextIsHexBytes(ReceivedText) And ReceivedText.Length >= 32 Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: The shared Admin Key text (or maybe an hash) is actually valid"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Locking down the Admin Key field to password mode"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: When a valid Admin Key or hash is shared to the App, it's always made unrevealable"$, Colors.Blue)
		#End If
		LockdownAdminKeyField
		
		'Only put the Admin Key text in the Admin Key field
		'After it has been locked down and made unrevealable
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Setting the Admin Key field .Text to the text that we received"$, Colors.Blue)
		#End If
		edtAdminKey.Text = ReceivedText
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Notify the user that the Admin Key field .Text has been set to the shared text we received in a toast notification"$, Colors.Blue)
		#End If
		ToastMessageShow("Admin key text shared successfully", Constants.TOAST_DURATION_SHORT)
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: The shared Admin Key text (or maybe an hash) is invalid"$, Colors.Magenta)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: We can't accept setting the Admin Key field .Text to an invalid value"$, Colors.Magenta)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Setting the Admin Key .Text to empty-string to make sure the user doesn't accidentally use the default 48-zeroes Admin Key"$, Colors.Magenta)
		#End If
		edtAdminKey.Text = ""
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Notify the user that the shared Admin Key is invalid with a toast notification"$, Colors.Magenta)
		#End If
		ToastMessageShow("Shared Admin key text is invalid", Constants.TOAST_DURATION_SHORT)
		
	End If
	
	'Clear the contents of the receivedText variable once it's
	'no longer needed for the next part of the App lifecycle.
	#If LOGGING
	LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Clearing the temporary variable containing the shared Admin Key (or hash) text"$, Colors.Blue)
	#End If
	ReceivedText = ""
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Requesting a JVM garbage collection to discard the received Admin Key text variable as soon as possible"$, Colors.Blue)
	#End If
	Security.TriggerJvmGarbageCollection
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] CheckIfAdminKeySharedToTheApp: Sub return"$, Colors.Blue)
	#End If
End Sub
'
'------------------------------------------------------------------
'
Sub Process_Globals
	
	'These constants exist to save space in the source code
	'So that we don't write the entire texts multiple times
	Private Const DEFAULT_ZEROES_ADMIN_KEY  As String = "000000000000000000000000000000000000000000000000"
	Private Const DEFAULT_BULLETS_ADMIN_KEY As String = "••••••••••••••••••••••••••••••••••••••••••••••••" 'U+2022
	
	'ViewState registers for restoring the App state
	'on Activity destruction & re-creation
	Private ViewState_LastFocusedElement As String
	
	'This one is for the last visibility status
	'of the About window
	Private ViewState_mnuAbout_Visible As Boolean
	
	Private ViewState_edtChallenge_Text            As String
	Private ViewState_edtChallenge_SelectionStart  As Int
	Private ViewState_edtChallenge_SelectionLength As Int
	
	'The Admin Key label is always dynamically updated
	'so it doesn't need to be saved & restored
	'it will always be updated to the correct latest state
	
	Private ViewState_edtAdminKey_Text            As String
	Private ViewState_edtAdminKey_SelectionStart  As Int
	Private ViewState_edtAdminKey_SelectionLength As Int
	
	Private ViewState_chkHideAdminKey_Checked As Boolean
	Private ViewState_chkHideAdminKey_Enabled As Boolean = True 'Sensitive flag
	
	Private ViewState_btnHashMenu_Checked As Boolean
	
	Private ViewState_lblResponse_Text As String
	
	Private ViewState_edtResponse_Text            As String
	Private ViewState_edtResponse_SelectionStart  As Int
	Private ViewState_edtResponse_SelectionLength As Int
	
	'Admin Key selection information in Admin Key label
	Private SelectionTimer_edtAdminKey As Timer
	
	'Convenience constants stored inside this class
	Private Constants As MyConstants
	
	'Better method of managing the App's security
	Private Security As MySecurity
	
	'For getting Phone library functions without
	'bundling the big Phone library
	Private Common As MyCommon
	
	'For generating text hashes & encryption (response codes)
	Private Cryptography As MyCryptography
	
	'For advanced Java functions that require context
	Private joMain As JavaObject
	
	'For the QR code scanner module
	Public Shared_AllowEmptyQRCodeContent As Boolean 'Whether the QR code content was literally empty
	Public Shared_DetectedQRCodeContents  As String
	
	'For sharing Admin Keys to the App
	'Don't allow Android to repeatedly re-send its Share To Intents
	Private PreviouslySharedTextTruncatedRehash As String = Null 'Must be Null by default
	
	'Turns out using a Process_Globals variable
	'is the proper solution in our use-case...
	'
	'We use this process variable to know whether
	'it's really the first App resume event in
	'this App's lifecycle when the user launches it
	'
	'Note that we don't reset this flag when the
	'Activity is destroyed and recreated,
	'since it's still not the first-time App launch
	'in the App's lifecycle in such cases
	'
	'It will only be reset if the user truly
	'exits the App then launches it again
	'just like a reboot but for Apps instead
	Private IsFirstApplicationResume As Boolean = True 'True by default
	
	'For foreground device rotation detection
	Private ForegroundRotationDetection As MyForegroundRotationDetection
	
End Sub

'These are re-created each time the Activity
'gets re-created, such as screen rotation
'or other events that destroy-then-recreate it
Sub Globals
	Private lblChallenge As Label 'For getting its properties to fix btnHashMenuBg's
	Private edtChallenge As EditText
	
	Private lblAdminKey As Label
	Private edtAdminKey As EditText
	
	'For hiding the Admin key field with explanations
	'about why it's hidden during app pause events
	Private edtDecoyKey As EditText 'It's always visible by default
	
	Private chkHideAdminKey As CheckBox
	Private btnHashMenu     As ToggleButton
	
	Private btnHashMenuBg As Button
	Private btnSha256     As Button
	Private btnSha512     As Button
	
	Private lblResponse As Label
	Private edtResponse As EditText
	
End Sub

#Region ViewState functions

'Special function used for either setting initial defaults
'or for securely erasing the ViewState before Activity exit
Private Sub ResetViewState
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ResetViewState: Sub entry"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ResetViewState: Setting the focus on the Activity handle itself"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ResetViewState: This automatically causes all other UI elements to lose the focus"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ResetViewState: This also means that selection information and timers automatically stop themselves"$, Colors.Blue)
	#End If
	Activity.RequestFocus
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ResetViewState: Setting the ViewState last focused element to "Activity""$, Colors.Blue)
	#End If
	ViewState_LastFocusedElement = "Activity"
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ResetViewState: Setting initial values for text fields"$, Colors.Blue)
	#End If
	ViewState_edtChallenge_Text = ""
	ViewState_edtAdminKey_Text  = DEFAULT_ZEROES_ADMIN_KEY
	ViewState_edtResponse_Text  = ""
	
	'The Admin Key label is always dynamically re-generated anyway
	'No need to save and restore it
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ResetViewState: Setting initial values for text labels"$, Colors.Blue)
	#End If
	ViewState_lblResponse_Text = "Response:"
	
	'The layout file for Main has the Admin Key field
	'in PasswordMode and the Hide Admin Key checkbox
	'in Checked state by default
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ResetViewState: Setting initial states for checkboxes & menu buttons"$, Colors.Blue)
	#End If
	ViewState_chkHideAdminKey_Checked = True
	ViewState_btnHashMenu_Checked     = False
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ResetViewState: Sub return"$, Colors.Blue)
	#End If
End Sub

Private Sub SaveViewState()
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] SaveViewState: Sub entry"$, Colors.Blue)
	#End If
	
	'The About window visibility status is saved
	'in realtime by its own event handler
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] SaveViewState: Saving Challenge field .Text"$, Colors.Blue)
	#End If
	ViewState_edtChallenge_Text = edtChallenge.Text
	#If LOGGING
	LogColor($"[Main-${LogContextId}] SaveViewState: Saving Challenge field .Selection state"$, Colors.Blue)
	#End If
	ViewState_edtChallenge_SelectionStart  = edtChallenge.SelectionStart
	ViewState_edtChallenge_SelectionLength = edtChallenge.SelectionLength
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] SaveViewState: Saving Admin Key field .Text"$, Colors.Blue)
	#End If
	ViewState_edtAdminKey_Text = edtAdminKey.Text
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] SaveViewState: Saving Admin Key field .Selection state"$, Colors.Blue)
	#End If
	ViewState_edtAdminKey_SelectionStart  = edtAdminKey.SelectionStart
	ViewState_edtAdminKey_SelectionLength = edtAdminKey.SelectionLength
	
	'The Hide Admin Key checkbox's .Checked is saved in realtime
	'in its own respective CheckedChanged event handler
	
	'The Admin Key label is always dynamically re-generated anyway
	'No need to save and restore it
	#If LOGGING
	LogColor($"[Main-${LogContextId}] SaveViewState: Saving Response label .Text"$, Colors.Blue)
	#End If
	ViewState_lblResponse_Text = lblResponse.Text
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] SaveViewState: Saving Response field .Text"$, Colors.Blue)
	#End If
	ViewState_edtResponse_Text = edtResponse.Text
	#If LOGGING
	LogColor($"[Main-${LogContextId}] SaveViewState: Saving Response field .Selection state"$, Colors.Blue)
	#End If
	ViewState_edtResponse_SelectionStart  = edtResponse.SelectionStart
	ViewState_edtResponse_SelectionLength = edtResponse.SelectionLength
	
	'Last focused element is always saved in realtime in their
	'own respective FocusChanged event handlers
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] SaveViewState: Stopping any running selection timer by setting the focus on the Activity handle itself"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] SaveViewState: However we do it without affecting the ViewState last selected element register because we will restore this information on App resume"$, Colors.Blue)
	#End If
	Activity.RequestFocus
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] SaveViewState: Sub return"$, Colors.Blue)
	#End If
End Sub

Private Sub RestoreViewState()
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] RestoreViewState: Sub entry"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the Hide Admin Key checkbox .Enabled state"$, Colors.Blue)
	#End If
	chkHideAdminKey.Enabled = ViewState_chkHideAdminKey_Enabled
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the Hide Admin Key checkbox .Checked state"$, Colors.Blue)
	#End If
	chkHideAdminKey.Checked = ViewState_chkHideAdminKey_Checked
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the ViewState Visible attribute of the About window (Visible = ${ViewState_mnuAbout_Visible})"$, Colors.Blue)
	#End If
	If ViewState_mnuAbout_Visible Then
		'Simulate a click on the About window
		'to show it again if it was shown
		'before Activity destroy-then-recreate
		'
		'Thanks to IsAboutWindowAlreadyVisible the About window
		'will no show if its already being shown, which helps
		'to provide restoring of it on e.g. screen rotation,
		'while preventing multiple-displays of it on App pause & resume
		mnuAbout_Click
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the Challenge field .Text"$, Colors.Blue)
	#End If
	edtChallenge.Text = ViewState_edtChallenge_Text
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the Admin Key field .Text"$, Colors.Blue)
	#End If
	edtAdminKey.Text = ViewState_edtAdminKey_Text
	
	'The Admin Key label is always dynamically re-generated anyway
	'No need to save and restore it
	#If LOGGING
	LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the Response label .Text"$, Colors.Blue)
	#End If
	lblResponse.Text = ViewState_lblResponse_Text
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the Response field .Text"$, Colors.Blue)
	#End If
	edtResponse.Text = ViewState_edtResponse_Text
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the Hash Text menu button .Checked state"$, Colors.Blue)
	#End If
	btnHashMenu.Checked = ViewState_btnHashMenu_Checked
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] RestoreViewState: Checking what was the last focused element before"$, Colors.Blue)
	#End If
	Select ViewState_LastFocusedElement
		Case "edtChallenge"
			#If LOGGING
			LogColor($"[Main-${LogContextId}] RestoreViewState: The last focused element before was edtChallenge"$, Colors.Blue)
			#End If
			
			#If LOGGING
			LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the focus state on edtChallenge"$, Colors.Blue)
			#End If
			edtChallenge.RequestFocus
			
			#If LOGGING
			LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the .Selection state for edtChallenge"$, Colors.Blue)
			#End If
			edtChallenge.SetSelection(ViewState_edtChallenge_SelectionStart, ViewState_edtChallenge_SelectionLength)
			
		Case "edtAdminKey"
			#If LOGGING
			LogColor($"[Main-${LogContextId}] RestoreViewState: The last focused element before was edtAdminKey"$, Colors.Blue)
			#End If
			
			'This will fire its FocusChanged event which will
			'update the Admin Key label accordingly
			#If LOGGING
			LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the focus state on edtAdminKey"$, Colors.Blue)
			#End If
			edtAdminKey.RequestFocus
			
			#If LOGGING
			LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the .Selection state for edtAdminKey"$, Colors.Blue)
			#End If
			edtAdminKey.SetSelection(ViewState_edtAdminKey_SelectionStart, ViewState_edtAdminKey_SelectionLength)
			
		Case "edtResponse"
			#If LOGGING
			LogColor($"[Main-${LogContextId}] RestoreViewState: The last focused element before was edtResponse"$, Colors.Blue)
			#End If
			
			#If LOGGING
			LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the focus state on edtResponse"$, Colors.Blue)
			#End If
			edtResponse.RequestFocus
			
			#If LOGGING
			LogColor($"[Main-${LogContextId}] RestoreViewState: Restoring the .Selection state for edtResponse"$, Colors.Blue)
			#End If
			edtResponse.SetSelection(ViewState_edtResponse_SelectionStart, ViewState_edtResponse_SelectionLength)
			
		Case Else
			#If LOGGING
			LogColor($"[Main-${LogContextId}] RestoreViewState: The last focused element was not found in the list"$, Colors.Magenta)
			#End If
			#If LOGGING
			LogColor($"[Main-${LogContextId}] RestoreViewState: Not restoring the focus state on any specific element"$, Colors.Magenta)
			#End If
			
	End Select
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] RestoreViewState: Sub return"$, Colors.Blue)
	#End If
End Sub

#End Region

#Region Activity Event Handlers

Sub Activity_Create(FirstTime As Boolean)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Create: Sub entry (FirstTime = ${FirstTime})"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Create: Initializing this Activity's Lifecycle tracking if needed..."$, Constants.COLORS_ORANGE)
	#End If
	If FirstTime Then
		ForegroundRotationDetection.Initialize
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Create: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Constants.COLORS_ORANGE)
	#End If
	ForegroundRotationDetection.ActivityLifecycle = ForegroundRotationDetection.ActivityLifecycle & ForegroundRotationDetection.Create
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Create: New Activity lifecycle tracking value: "$&ForegroundRotationDetection.ActivityLifecycle, Constants.COLORS_ORANGE)
	#End If
	
	'---------------------------------------------'
	' Disabling the Activity TitleBar & ActionBar '
	' must be done before adding content to the   '
	' Activity, so before loading the layout file '
	'---------------------------------------------'
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Create: Load Main layout"$, Colors.Blue)
	#End If
	Activity.LoadLayout("Main")
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Create: Check if it's the FirstTime Activity launch"$, Colors.Blue)
	#End If
	If FirstTime Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: It's the FirstTime Activity launch"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: Disable the Admin Key selection timer so that it doesn't tick upon initialization"$, Colors.Blue)
		#End If
		SelectionTimer_edtAdminKey.Enabled = False
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: Initialize the Admin Key selection timer at a tick rate of 100ms"$, Colors.Blue)
		#End If
		SelectionTimer_edtAdminKey.Initialize("SelectionTimer_edtAdminKey", 100)
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: Get an initial ViewState with default UI element values by resetting the ViewState"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: The layout files don't always contain default UI element values"$, Colors.Blue)
		#End If
		ResetViewState
		
		'Use ViewState registers here instead of calling elements' .RequestFocus
		'The restore of the ViewState will be done in the Activity_Resume
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: Alter the ViewState to display the Admin Key field .Text by default because it's the FirstTime Activity launch"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: Set the ViewState .Checked state of chkHideAdminKey to False"$, Colors.Blue)
		#End If
		ViewState_chkHideAdminKey_Checked = False
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: Alter the ViewState to focus on the Challenge code field by default because it's the FirstTime Activity launch"$, Colors.Blue)
		#End If
		ViewState_LastFocusedElement = "edtChallenge"
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: Initialize the Constants Class (MyConstants class)"$, Colors.Blue)
		#End If
		Constants.Initialize
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: Initialize the Security Class (MySecurity class)"$, Colors.Blue)
		#End If
		Security.Initialize
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: Initialize the Common Class (MyCommon class)"$, Colors.Blue)
		#End If
		Common.Initialize
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: Initialize the Cryptography Class (MyCryptography class)"$, Colors.Blue)
		#End If
		Cryptography.Initialize
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: It's not the FirstTime Activity launch"$, Colors.Blue)
		#End If
		
	End If
	
	'The Activity context must always be fresh,
	'so always re-initialize the joMain JavaObject
	'on every Activity create (not just on FirstTime)
	'
	'This is mandatory for context-dependent functions
	'that receive the Activity context, because they
	'must always have a fresh Activity context handle!
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Create: Initialize the joMain JavaObject always (not just on FirstTime launch)"$, Colors.Blue)
	#End If
	joMain.InitializeContext
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Create: Check if the Android version is 3.0 or newer and if the device display scale is 1.0 or higher"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Create: If the Android version is 3.0 or newer then it has ActionBar support"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Create: If the device display scale is 1.0 or higher then it cans display the ActionBar (not hidden)"$, Colors.Blue)
	#End If
	If Common.GetAndroidSdkVersion >= 11 And 1.0 <= joMain.RunMethod("jGetDeviceScale", Null) Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: The device is Android version is 3.0 or newer and the device display scale is 1.0 or higher"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: Adding the About menu as icon in the ActionBar"$, Colors.Blue)
		#End If
		Activity.AddMenuItem3("About", "mnuAbout", LoadBitmap(File.DirAssets, "About.png"), True)
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: The device is Android version is older than 3.0 or the device display scale is lower than 1.0"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Create: Adding the About menu as Activity options menu item"$, Colors.Blue)
		#End If
		Activity.AddMenuItem("About", "mnuAbout")
		
	End If
	
	'
	'The UI controls that don't depend on a ViewState
	'to be restored (their styling properties etc)
	'can just be restored in a shared function for
	'both Activity_Create and Activity_Resume
	'
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Create: Calling InitializeActivityLayout to initialize the loaded layout..."$, Colors.Blue)
	#End If
	InitializeActivityLayout
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Create: Sub return"$, Colors.Blue)
	#End If
End Sub

Sub InitializeActivityLayout
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] InitializeActivityLayout: Sub entry"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] InitializeActivityLayout: Set the Activity layout title to the App name"$, Colors.Blue)
	#End If
	Activity.Title = Application.LabelName
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] InitializeActivityLayout: Harden this Activity's EditTexts to prevent Android from leaking sensitive information"$, Colors.Blue)
	#End If
	HardenActivityEditTexts(Constants.EDITTEXT_NO_SPECIFIC_ONE, Null)
	
	'Currently only the Admin Key field has a monospace font
	#If LOGGING
	LogColor($"[Main-${LogContextId}] InitializeActivityLayout: Fix this Activity's EditTexts that have a monospace font to stay monospace on older Android versions"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] InitializeActivityLayout: Otherwise some older Android devices see these EditTexts as not being monospace"$, Colors.Blue)
	#End If
	FixMonospaceEditTexts(Constants.EDITTEXT_SPECIFIC_ONE, edtAdminKey)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] InitializeActivityLayout: Calling FixHashMenuBackgroundTextPadding to fix the padding of the white text on the Hash Text menu background..."$, Colors.Blue)
	#End If
	FixHashMenuBackgroundTextPadding
	
	'
	'Initially always False on Activity_Create
	'
	'It will be set to the proper value later
	'by Activity_Resume when it calls RestoreViewState
	'
	#If LOGGING
	LogColor($"[Main-${LogContextId}] InitializeActivityLayout: Calling FixHashMenuButtonTextColorIfNeeded(False) to fix the Hash Text button's text color if needed..."$, Colors.Blue)
	#End If
	FixHashMenuButtonTextColorIfNeeded(False)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] InitializeActivityLayout: Sub return"$, Colors.Blue)
	#End If
End Sub

Sub HardenActivityEditTexts(WantsToHardenASpecificOne As Boolean, WhichOneIfYes As EditText)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Sub entry"$, Colors.Blue)
	#End If
	
	'Caller sanity check:
	'If you want a specific one, then don't say a "Null" one
	#If LOGGING
	LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Checking if the caller is "sane" (if what they ask for is logical)"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Checking whether the caller requested a specific EditText to harden but says that it's "Null""$, Colors.Blue)
	#End If
	If WantsToHardenASpecificOne And WhichOneIfYes == Null Then
		'Caller is confused about what it wants
		'Not doing anything in such cases
		#If LOGGING
		LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: The caller is illogical, providing illogical parameters to this function"$, Colors.Magenta)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: The caller asks us to harden a specific EditText then gives "Null""$, Colors.Magenta)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Since the caller is asking for an illogical thing, we just cannot proceed further"$, Colors.Magenta)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Sub return"$, Colors.Magenta)
		#End If
		Return
		
	End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Sanity check completed, the caller is logical (good news!)"$, Colors.Blue)
	#End If
	
	'Create a list of EditTexts to harden
	#If LOGGING
	LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Creating a list of EditTexts to harden (currently empty)"$, Colors.Blue)
	#End If
	Dim EditTextsToHarden() As EditText
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Checking if the caller wants to harden a specific EditText"$, Colors.Blue)
	#End If
	If WantsToHardenASpecificOne Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Caller wants to harden a specific EditText"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Adding only the specified EditText to our list"$, Colors.Blue)
		#End If
		EditTextsToHarden = Array As EditText(WhichOneIfYes)
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Caller wants to harden any & all EditTexts in this Activity (no specific one)"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Adding all this Activity's EditTexts to our list"$, Colors.Blue)
		#End If
		
		'Even the decoy Admin key field too
		'
		'For hiding the Admin key field with explanations
		'about why it's hidden during app pause events
		EditTextsToHarden = Array As EditText(edtChallenge, edtAdminKey, edtDecoyKey, edtResponse)
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Hardening the security of the EditText fields in our completed list"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: This includes disabling autocomplete, autocorrect, fullscreen keyboard etc"$, Colors.Blue)
	#End If
	For Each MyEditText As EditText In EditTextsToHarden
		'First the ones that modify the InputType
		'Then the ones that modify the ImeOptions
		'
		'Changing the InputType will clear the ImeOptions
		'So do the ImeOptions changes after the InputType ones
		'
		'There are actually already now mitigations for this
		'in the MySecurity class's Java native functions
		Security.DisableAutoCorrect(MyEditText)               'inputType
		Security.DisableAutoComplete(MyEditText)              'inputType
		Security.DisableAutoSuggestions(MyEditText)           'inputType
		Security.DisableTextConversionSuggestions(MyEditText) 'inputType
		Security.DisableTextSelectionSuggestions(MyEditText)  'inputType
		Security.DisableFullscreenKeyboard(MyEditText)   'imeOptions
		Security.DisablePersonalizedLearning(MyEditText) 'imeOptions
		#If LOGGING
		LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: An EditText found in the list has been hardened"$, Colors.Blue)
		#End If
		
	Next
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] HardenActivityEditTexts: Sub return"$, Colors.Blue)
	#End If
End Sub

Sub FixMonospaceEditTexts(WantsToFixASpecificOne As Boolean, WhichOneIfYes As EditText)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Sub entry"$, Colors.Blue)
	#End If
	
	'Caller sanity check:
	'If you want a specific one, then don't say a "Null" one
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Checking if the caller is "sane" (if what they ask for is logical)"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Checking whether the caller requested a specific EditText to fix but says that it's "Null""$, Colors.Blue)
	#End If
	If WantsToFixASpecificOne And WhichOneIfYes == Null Then
		'Caller is confused about what it wants
		'Not doing anything in such cases
		#If LOGGING
		LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: The caller is illogical, providing illogical parameters to this function"$, Colors.Magenta)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: The caller asks us to fix a specific EditText then gives "Null""$, Colors.Magenta)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Since the caller is asking for an illogical thing, we just cannot proceed further"$, Colors.Magenta)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Sub return"$, Colors.Magenta)
		#End If
		Return
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Sanity check completed, the caller is logical (good news!)"$, Colors.Blue)
	#End If
	
	'Create a list of EditTexts to harden
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Creating a list of EditTexts to fix (currently empty)"$, Colors.Blue)
	#End If
	Dim EditTextsToFix() As EditText
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Checking if the caller wants to fix a specific EditText"$, Colors.Blue)
	#End If
	If WantsToFixASpecificOne Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Caller wants to fix a specific EditText"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Adding only the specified EditText to our list"$, Colors.Blue)
		#End If
		EditTextsToFix = Array As EditText(WhichOneIfYes)
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Caller wants to fix any & all EditTexts in this Activity (no specific one)"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Adding all this Activity's EditTexts to our list"$, Colors.Blue)
		#End If
		
		'edtDecoyKey is also included if we need to fix *all* the EditTexts
		EditTextsToFix = Array As EditText(edtChallenge, edtAdminKey, edtDecoyKey, edtResponse)
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Correcting the monospace EditTexts in our completed list to always stay monospace"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: On older Android versions such as 2.x they are otherwise not monospace"$, Colors.Blue)
	#End If
	For Each MyEditText As EditText In EditTextsToFix
		Common.ForceCorrectMonospaceFont(MyEditText)
		'Correcting the monospace EditTexts to also have proper monospace digits
		'On Android 5.0+ the monospace EditTexts don't have proper monospace digits otherwise
		Common.ForceCorrectMonospaceFontDigits(MyEditText)
		#If LOGGING
		LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: An EditText found in the list has been fixed"$, Colors.Blue)
		#End If
		
	Next
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixMonospaceEditTexts: Sub return"$, Colors.Blue)
	#End If
End Sub

Sub FixHashMenuBackgroundTextPadding
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixHashMenuBackgroundTextPadding: Sub entry"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixHashMenuBackgroundTextPadding: Dynamically correcting the padding of the text hashing options menu's info-text"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixHashMenuBackgroundTextPadding: It's needed to correct it to match the Challenge label"$, Colors.Blue)
	#End If
	btnHashMenuBg.Padding = Array As Int( lblChallenge.Left, _ 'Left   = [0]
	                                      lblChallenge.Top,  _ 'Top    = [1]
	                                      lblChallenge.Left, _ 'Right  = [2]
	                                      lblChallenge.Top   _ 'Bottom = [3]
										)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixHashMenuBackgroundTextPadding: Sub return"$, Colors.Blue)
	#End If
End Sub

Sub FixHashMenuButtonTextColorIfNeeded(Checked As Boolean)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixHashMenuButtonTextColorIfNeeded: Sub entry (Checked = ${Checked})"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixHashMenuButtonTextColorIfNeeded: Check if the Android version is older than 3.0"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixHashMenuButtonTextColorIfNeeded: Some small Hash Text button text color tweak has to be done on such older versions on Android"$, Colors.Blue)
	#End If
	If Common.GetAndroidSdkVersion < 11 Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] FixHashMenuButtonTextColorIfNeeded: Device is older than Android 3.0, apply the Text Hash button text color fix for Checked = ${Checked}"$, Colors.Blue)
		#End If
		If Checked Then
			btnHashMenu.TextColor = Colors.Red
		Else
			btnHashMenu.TextColor = Colors.Black
		End If
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] FixHashMenuButtonTextColorIfNeeded: Device is either Android 3.0 or newer, no need for the Text Hash button text color fix"$, Colors.Blue)
		#End If
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixHashMenuButtonTextColorIfNeeded: Sub return"$, Colors.Blue)
	#End If
End Sub

Sub Activity_Resume
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: Sub entry"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: Stopping this Activity's Lifecycle reset Timer for foreground rotation detection"$, Constants.COLORS_ORANGE)
	#End If
	ForegroundRotationDetection.ActivityLifecycleTimer_Stop
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Constants.COLORS_ORANGE)
	#End If
	ForegroundRotationDetection.ActivityLifecycle = ForegroundRotationDetection.ActivityLifecycle & ForegroundRotationDetection.Resume
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: New Activity lifecycle tracking value: "$&ForegroundRotationDetection.ActivityLifecycle, Constants.COLORS_ORANGE)
	#End If
	
	'
	'Moved RestoreViewState further down for security reasons
	'
	
	If Shared_DetectedQRCodeContents <> "" Or Shared_AllowEmptyQRCodeContent Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: We received a QR code result from the Scan Activity"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: Setting the Challenge code field .Text to the QR code content (sensitive value)"$, Colors.Blue)
		#End If
		edtChallenge.Text = Shared_DetectedQRCodeContents
		
		'Before we restore the ViewState later, you have to first
		'alter it so that edtChallenge's text gets correctly
		'restored incase since received QR code contents
		'before the ViewState will actually get restored
		'
		'This is because this Activity's EditTexts don't have
		'a realtime ViewState saving on every text change,
		'as this would be unnecessarily performance-heavy
		'
		'Their last-focused-element ViewState though is indeed
		'saved in realtime whenever it changes (no need to alter it)
		ViewState_edtChallenge_Text = edtChallenge.Text
		
		'Clear the variable after use to prevent
		'repeated setting on the QR code content
		'on every Activity resume
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: Resetting shared QR code information registers for the next use"$, Colors.Blue)
		#End If
		Shared_DetectedQRCodeContents  = ""
		Shared_AllowEmptyQRCodeContent = False
		
		'Now focus on the Challenge code field to
		'bring visual attention to it
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: Setting the focus on the Challenge code field now to bring visual attention to it"$, Colors.Blue)
		#End If
		edtChallenge.RequestFocus
		
	End If
	
	'For Always hiding the Admin Key when switching Apps
	'such as pausing this App to use another one,
	'then coming back to this App
	'
	'This prevents accidental showing of Admin Key texts
	'incase the user forgot that the Admin Key text was
	'not hidden when they paused the App prior
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: Checking if this is not the first Activity resume in this App lifecycle"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: Also checking if this Activity resume was not just a screen rotation"$, Colors.Blue)
	#End If
	If Not(IsFirstApplicationResume) And Not(ForegroundRotationDetection.CheckIfForegroundRotation(ForegroundRotationDetection.ActivityLifecycle)) Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: It's not the first-time Activity resume for this App lifecycle"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: It's also not due to a foreground device screen orientation change"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: So we want to hide the Admin Key field always to prevent accidental exposure in sensitive environments"$, Colors.Blue)
		#End If
		
		'
		'We have to forcibly call the CheckedChange event
		'for the Hide Admin key checkbox instead of
		'setting chkHideAdminKey.Checked to True
		'
		'This is because when the Activity is destroyed
		'then recreated, it load the layout, but the
		'Hide Admin Key checkbox is already enabled
		'by default inside the layout configuration
		'
		'Therefore if you try setting chkHideAdminKey.Checked
		'to True, it's trying to set it to the same value
		'and Android ignores the event if it considers it "redundant"
		'
		'Previously it worked with chkHideAdminKey.Checked = True
		'because we restored the ViewState first, then set the
		'Checkbox .Checked state to True
		'
		'So we were restoring the previous state, which was
		'potentially True **or False** then hid it again later
		'
		'But now that we restore the ViewState later only
		'for security reasons, remember that the Checked
		'state will always be by default True already
		'because it's set to Checked = True in the layout file
		'
		'That's why we must manually force the event to fire
		'by calling chkHideAdminKey_CheckedChange(True)
		'
		'We also don't mark the call as "called from Hotfix"
		'because we want the full function to run,
		'not just updating the Admin key field's .Hint value
		'with bullet chars or zero digits
		'
		'TLDR: Don't use chkHideAdminKey.Checked = True
		'
		'      You must manually fire the event with:
		'       - chkHideAdminKey_CheckedChange(True)
		'
		
		'
		'Additional note:
		' - chkHideAdminKey_CheckedChange will already update
		'   the checkbox's ViewState .Checked status with
		'   the provided Checked parameter
		'
		' - You don't need to manually alter this ViewState
		'   register before the Activity resume's call to
		'   the RestoreViewState function
		'
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: Setting the Hide Admin Key field's .Checked state to True"$, Colors.Blue)
		#End If
		chkHideAdminKey_CheckedChange(True) 'It must be forcibly called
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: This is either the first-time Activity resume for this App lifecycle..."$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: Or it's just a device screen rotation event while is app is in the foreground anyway"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: We don't need to specifically hide the Admin Key field in such cases"$, Colors.Blue)
		#End If
		
	End If
	
	'Restore the ViewState only after having first set the
	'Hide Admin Key checkbox to Checked if needed
	'
	'This prevents potential milliseconds-leaks of the
	'Admin key texts in app background pause & resume scenarios
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: Restore ViewState"$, Colors.Blue)
	#End If
	RestoreViewState
	
	'Something to do on app resume (only after restoring ViewState):
	'Show the Admin key text (using the Visible property)
	'
	'This is how preventing potential milliseconds-leaks works
	'in this application, to avoid having the key seen until
	'we confirm that it's allowed to be visible
	'
	'It's allowed to be visible only once we have properly
	'restored its PasswordMode property (incase it was hidden),
	'and after we confirmed that we did the forced
	'Admin key hiding in cases of application background-pause & resume
	'
	'It was set to invisible by Activity_Pause as a security precaution
	'against short milliseconds-wise Admin key leaks (visual leaks)
	If Not(IsFirstApplicationResume) Then
		'No need to wait if it's the first app launch (first resume)
		'
		'If it's the first app launch, then there's no sensitive
		'Admin key material shown anyway (just a 48-zeroes default key)
		'
		'Otherwise add a small 5ms delay for good measure
		'Any delay value higher than 1ms will do fine
		Sleep(5)
		
	End If
	edtAdminKey.Visible = True
	
	'Hide the decoy Admin key field after it's safe to hide it
	'
	'It's used for hiding the Admin key field with
	'explanations about why it's hidden (during app pauses)
	edtDecoyKey.Visible = False
	
	'This only needs to be done once per Activity resume
	'And only at the end of the Activity resume event
	'
	'No need to do this on Activity create because the
	'Activity resume event always follows the create one
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: Calling the Hotfix function FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue as a Hotfix for our needed use-cases"$, Colors.Blue)
	#End If
	FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue
	
	'Android will not fire Activity_NewIntent somehow
	'even when it needds to fire it,
	'because Android refuses to do the right thing
	'we have to do it manually ourselves
	'
	'Atleast it's pleased enough to please fire the
	'Activity_Resume event though, fortunately...
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: We need to manually fire Activity_NewIntent because Android won't do it"$, Colors.Magenta)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: Check the source-code comments of this function for more information"$, Colors.Magenta)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: Manually firing Activity_NewIntent with the current Android Intent object"$, Colors.Magenta)
	#End If
	Activity_NewIntent(Activity.GetStartingIntent)
	
	'
	'This part as the very last one
	'
	If IsFirstApplicationResume Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: This was the first Activity_Resume event"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Resume: Setting IsFirstActivityResume to False to so that next time we know it won't be the first Activity_Resume"$, Colors.Blue)
		#End If
		IsFirstApplicationResume = False
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: Resetting this Activity's Lifecycle tracking for foreground rotation detection"$, Constants.COLORS_ORANGE)
	#End If
	ForegroundRotationDetection.ActivityLifecycle = ""
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: New Activity lifecycle tracking value: "$&ForegroundRotationDetection.ActivityLifecycle, Constants.COLORS_ORANGE)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Resume: Sub return"$, Colors.Blue)
	#End If
End Sub

'We implemented this Hotfix to correct a normal
'Android behavior of not re-calling checkboxes
'CheckedChange events if the new .Checked value
'is the same as the old one
'
'This behavior is actually correct but unfortunately
'prevents us from using checkboxes CheckedChange events
'to properly change the Admin Key field's .Hint value
'from within its own ChangedChange event,
'yet this should always be done even if the
'new .Checked value is the same as the old one
Sub FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue()
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue: Sub entry"$, Colors.Blue)
	#End If
	
	'Because Android is will not fire the
	'CheckedChange events of Checkable
	'UI elements when the new .Checked value
	'is the same as the current one
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue: ----- ----- ----- ----- -----"$, Constants.COLORS_ORANGE)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue: Android doesn't fire CheckedChange events when the new .Checked value of Checkable UI elements is the same as the current one"$, Constants.COLORS_ORANGE)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue: So we explicitly fire the CheckedChange events ourselves"$, Constants.COLORS_ORANGE)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue:"$, Constants.COLORS_ORANGE)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue: The actual problem is not that it never fires CheckedChange events, it does actually"$, Constants.COLORS_ORANGE)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue: But it only fires the CheckedChange event if the .Checked value is *different* from the previous one"$, Constants.COLORS_ORANGE)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue:"$, Constants.COLORS_ORANGE)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue: Interestingly enough, this problem only affects CheckBoxes here, not other kinds of Checkable UI elements"$, Constants.COLORS_ORANGE)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue: ----- ----- ----- ----- -----"$, Constants.COLORS_ORANGE)
	#End If
	
	'
	'Only add the specific CheckBoxes for which Android's
	'duplicate CheckedChange call avoidance is a problem
	'
	'Don't just add all of an Activity's CheckBoxes here
	'Unless strictly necessary
	'
	'Let Android avoid the CheckedChange event calls
	'for CheckBoxes that don't particularly need their
	'CheckedChange event to always be fired no matter
	'whether the new .Checked value is redundant
	'
	'See chkHideAdminKey_CheckedChange for a reference
	'on how to implement this Hotfix in your CheckBoxes
	'CheckedChange event handlers
	'
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue: Telling chkHideAdminKey_CheckedChange that the next call is from this Hotfix function"$, Colors.Blue)
	#End If
	chkHideAdminKey.Tag = chkHideAdminKey.Tag.As(String)&"[CHECKEDCHANGE_FROM_HOTFIX]"
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue: Manually firing chkHideAdminKey_CheckedChange(chkHideAdminKey.Checked) (with its own current Checked value)"$, Colors.Blue)
	#End If
	chkHideAdminKey_CheckedChange(chkHideAdminKey.Checked)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] FixAndroidCheckedChangeEventIgnoresIfSameCheckedValue: Sub return"$, Colors.Blue)
	#End If
End Sub

Sub Activity_Pause(UserClosed As Boolean)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Pause: Sub entry (UserClosed = ${UserClosed})"$, Colors.Blue)
	#End If
	
	'Something to do first on app pause events:
	'Hide the Admin key text (using the Visible property)
	'
	'This prevents potential milliseconds-leaks of the
	'Admin key texts in app background pause & resume scenarios
	'
	'It will be set to visible again anyway on app resume
	edtAdminKey.Visible = False
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Pause: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Constants.COLORS_ORANGE)
	#End If
	ForegroundRotationDetection.ActivityLifecycle = ForegroundRotationDetection.ActivityLifecycle & ForegroundRotationDetection.Pause
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Pause: New Activity lifecycle tracking value: "$&ForegroundRotationDetection.ActivityLifecycle, Constants.COLORS_ORANGE)
	#End If
	
	If Not(UserClosed) Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Pause: Activity is not UserClosed"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Pause: Save ViewState"$, Colors.Blue)
		#End If
		SaveViewState
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Pause: Activity is UserClosed"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Pause: No need to save the ViewState in this case"$, Colors.Blue)
		#End If
		
		'No need to call ActivityExit here anymore
		'ActivityExit already calls Activity.finish()
		'
		'It will then already call this Activity_Pause Sub,
		'followed by Activity_Stop and Activity_Destroy if
		'the app is lingering in the background as idle process
		'
		'However we can indeed directly call TrueApplicationExit
		'without calling ActivityExit to avoid recusion
		'
		'This is incase Android doesn't respect our app manifest where
		'it says that we don't want to stay running in the background
		'
		'Then when the user closes the app (finishes the Activity for real)
		'the UserClosed variable will be True, so it's here that we can do
		'the true application exit procedure
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Pause: The UserClosed parameter is True, so Android actually called this Activity_Pause function because it wants to keep this app's process running in the background"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Pause: But we don't want that, we want the app to truly exit (its process too) when the user exits it"$, Colors.Blue)
		#End If
		
		'This method of exiting the App is so fast that
		'the Basic4Android BridgeLogger doesn't have
		'enough time to display the App exit-related
		'logging lines, probably only logcat-based logging
		'over USB with ADB cans be fast enough to show them
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Pause: True exit of the App using the TrueApplicationExit method from the MyCommon class"$, Colors.Black)
		#End If
		'The Common object is necessarily initialized if
		'Activity_Pause cans be called to begin with
		Common.TrueApplicationExit
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Pause: This code here and below should never be reached if TrueApplicationExit is fast enough and instant"$, Colors.Red)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] Activity_Pause: Sub return"$, Colors.Red)
		#End If
		Return
		
	End If
	
	'
	'Do the decoy Admin key display here
	'after we make sure that the app's
	'pause event is not UserClosed == True
	'
	'Otherwise why bother showing it
	'if the app will fully exit anyway
	'
	
	'Show the decoy Admin key field during application pauses
	'
	'It's used for hiding the Admin key field with explanations
	'about why it's hidden, so that users know it's not a bug
	edtDecoyKey.Visible = True
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Pause: Starting this Activity's Lifecycle reset Timer for foreground rotation detection"$, Constants.COLORS_ORANGE)
	#End If
	ForegroundRotationDetection.ActivityLifecycleTimer_Start
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Pause: Sub return"$, Colors.Blue)
	#End If
End Sub

Private Sub Activity_KeyPress(KeyCode As Int) As Boolean
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_KeyPress: Sub entry (KeyCode = ${KeyCode})"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_KeyPress: Verifying what the KeyCode is"$, Colors.Blue)
	#End If
	Select Case KeyCode
		Case KeyCodes.KEYCODE_BACK
			#If LOGGING
			LogColor($"[Main-${LogContextId}] Activity_KeyPress: The KeyCode is KEYCODE_BACK"$, Colors.Blue)
			#End If
			
			#If LOGGING
			LogColor($"[Main-${LogContextId}] Activity_KeyPress: Checking if there any modals visible"$, Colors.Blue)
			#End If
			#If LOGGING
			LogColor($"[Main-${LogContextId}] Activity_KeyPress: Don't exit the Activity if a modal was shown"$, Colors.Blue)
			#End If
			
			If btnHashMenu.Checked Then
				#If LOGGING
				LogColor($"[Main-${LogContextId}] Activity_KeyPress: Found the text hashing options menu modal"$, Colors.Blue)
				#End If
				
				#If LOGGING
				LogColor($"[Main-${LogContextId}] Activity_KeyPress: Closing the text hashing options menu"$, Colors.Blue)
				#End If
				btnHashMenu.Checked = False
				
				#If LOGGING
				LogColor($"[Main-${LogContextId}] Activity_KeyPress: Sub return (returning True to prevent exit)"$, Colors.Blue)
				#End If
				Return True
				
			End If
			
			#If LOGGING
			LogColor($"[Main-${LogContextId}] Activity_KeyPress: Calling ActivityExit"$, Colors.Blue)
			#End If
			ActivityExit
			
			#If LOGGING
			LogColor($"[Main-${LogContextId}] Activity_KeyPress: Sub return (returning True)"$, Colors.Blue)
			#End If
			Return True
			
		Case KeyCodes.KEYCODE_HOME
			'This code branch might go too fast for
			'the Basic4Android BridgeLogger to log
			#If LOGGING
			LogColor($"[Main-${LogContextId}] Activity_KeyPress: The KeyCode is KEYCODE_HOME"$, Colors.Blue)
			#End If
			
			#If LOGGING
			LogColor($"[Main-${LogContextId}] Activity_KeyPress: Hiding the Admin Key field on App switching events (Home button press)"$, Colors.Blue)
			#End If
			chkHideAdminKey.Checked = True
			
		Case Else
			#If LOGGING
			LogColor($"[Main-${LogContextId}] Activity_KeyPress: The KeyCode is something else"$, Colors.Blue)
			#End If
			#If LOGGING
			LogColor($"[Main-${LogContextId}] Activity_KeyPress: We don't do anything particular with other KeyCodes"$, Colors.Blue)
			#End If
			
	End Select
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_KeyPress: Sub return (returning False)"$, Colors.Blue)
	#End If
	Return False
	
End Sub

Private Sub ActivityExit
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ActivityExit: Sub entry"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ActivityExit: Stopping this Activity's Lifecycle reset Timer for foreground rotation detection"$, Constants.COLORS_ORANGE)
	#End If
	ForegroundRotationDetection.ActivityLifecycleTimer_Stop
	
	'This function already stops any running selection timer
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ActivityExit: Resetting the ViewState to clear all input contents etc"$, Colors.Blue)
	#End If
	ResetViewState
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ActivityExit: Asking the JVM to do a garbage collection as soon as possible"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ActivityExit: This will clear traces of leftover variable contents"$, Colors.Blue)
	#End If
	Security.TriggerJvmGarbageCollection
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ActivityExit: Finishing the Activity using the better Activity finish method"$, Colors.Blue)
	#End If
	joMain.RunMethod("jBetterActivityFinish", Null)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] ActivityExit: Sub return"$, Colors.Blue)
	#End If
End Sub

Private Sub LockdownAdminKeyField
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] LockdownAdminKeyField: Sub entry"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] LockdownAdminKeyField: Disabling the Hide Admin Key checkbox permanently"$, Colors.Blue)
	#End If
	chkHideAdminKey.Enabled = False
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] LockdownAdminKeyField: Registering the Hide Admin Key checkbox disabling in the ViewState registers"$, Colors.Blue)
	#End If
	ViewState_chkHideAdminKey_Enabled = False
	
	'This will fire the CheckedChange event even if
	'the checkbox is actually disabled
	#If LOGGING
	LogColor($"[Main-${LogContextId}] LockdownAdminKeyField: Hiding the Admin Key field for security reasons"$, Colors.Blue)
	#End If
	chkHideAdminKey.Checked = True
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] LockdownAdminKeyField: Sub return"$, Colors.Blue)
	#End If
End Sub

#Region UI Event Handlers

#Region Activity menu event handlers

'Currently only used in NO_FLAG_SECURE and LOGGING
'build configurations, so no need to include it
'in the FLAG_SECURE builds (e.g. GitHub releases)
'
'We do however also want to include this function
'in any obfuscated build, no matter what configuration
'the application uses (build type =/= build configuration)
'
'The OBFUSCATED conditional symbol is a valid one
'but will not be highlighted in the Basic4Android IDE,
'it's only set at compile time but it does work
#If NO_FLAG_SECURE OR LOGGING OR OBFUSCATED
'Helper function to add more than
'one version label without writing
'the same code twice (no redundancy)
Private Sub mnuAbout_AddVersionLabel(AboutVersionText As CSBuilder, LabelText As String, LabelColor As Int, LabelBackgroundColor As Int)
	'You don't need to add logging in a simple
	'very small helper function like this one
	'Set yellow color for the warning label background
	
	'Set the background color for the version label
	AboutVersionText.BackgroundColor(LabelBackgroundColor)
	
	'Set the text color for the version label text
	AboutVersionText.Color(LabelColor)
	
	'25% smaller than the previous text
	AboutVersionText.RelativeSize(0.75)
	
	'Vertically align the version label text
	'by adjusting the offset, to be more
	'visually pleasing aka. better-aligned
	'for the Human eye when the user sees it
	AboutVersionText.VerticalAlign(-1dip) '1dip higher (negative value - calibrated value)
	
	'Append the version label
	'
	'Notice the spaces before & after in order to
	'have left & right padding in the warning label
	AboutVersionText.Append(" "&LabelText&" ")
	
	AboutVersionText.Pop 'Pop the -1dip VerticalAlign span
	AboutVersionText.Pop 'Pop the 25% (plus 10%) smaller RelativeSize span
	AboutVersionText.Pop 'Pop the text color span
	AboutVersionText.Pop 'Pop the background color span
	
End Sub
#End If

Private Sub mnuAbout_Click
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] mnuAbout_Click: Sub entry"$, Colors.Blue)
	#End If
	
	'The About window automatically disappears
	'on Activity pause & Activity destroy
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] mnuAbout_Click: Get the App icon"$, Colors.Blue)
	#End If
	Dim AboutIcon As Bitmap = Application.Icon
	
	'Get better-adapted About icons according to screen DPI & scale
	#If LOGGING
	LogColor($"[Main-${LogContextId}] mnuAbout_Click: Get the proper square icon size for this device's display scale"$, Colors.Blue)
	#End If
	Dim SquareIcoSize As Int = Common.GetSquareIconSizeForDeviceScale
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] mnuAbout_Click: Check if the App icon needs to be resized to match this device's display scale"$, Colors.Blue)
	#End If
	If AboutIcon.Height <> SquareIcoSize Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] mnuAbout_Click: The App icon doesn't match this device's square icon size, it needs to be resized to match this device's display scale"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] mnuAbout_Click: Resizing the App icon to match this device's display scale"$, Colors.Blue)
		#End If
		AboutIcon = AboutIcon.Resize(SquareIcoSize, SquareIcoSize, Constants.BITMAP_RESIZE_KEEP_ASPECT_RATIO)
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] mnuAbout_Click: The App icon matches this device's square icon size or device scale is so high that it requires atleast the original App icon"$, Colors.Blue)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] mnuAbout_Click: No need to resize the App icon, using the original one as-is"$, Colors.Blue)
		#End If
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] mnuAbout_Click: Displaying the About MessageBox with the proper App icon and button options"$, Colors.Blue)
	#End If
	
	'CSBuilder (CharSequenceBuilder) allows building CharSequence-based strings
	'Such char sequences can contain better formatting options for strings
	'
	'More info:
	' - https://www.b4x.com/android/forum/threads/charsequence-csbuilder-tutorial.76226/
	'
	'About Pop & PopAll:
	' - "Calling Pop ends the last span that was added (and not ended yet).
	'    Calling PopAll ends all open spans.
	'    It's convenient to always call PopAll at the end to ensure that all spans are closed."
	'
	Dim AboutInfoText As CSBuilder
	AboutInfoText.Initialize
	
	'Make the app name bold
	AboutInfoText.Bold
	'Basic4Android's CRLF is actually a LF char
	'In its source code, CRLF resolves to "\n"
	AboutInfoText.Append(Application.LabelName&CRLF) 'App name + newline
	'Pop only the last app name span attribute (Bold)
	AboutInfoText.Pop
	'Make this app version text 10% smaller
	AboutInfoText.RelativeSize(0.9) '10% is 0.10, so decrease its size by 0.10 (1.00 -> 0.90)
	'Different version text between the
	'FLAG_SECURE and NO_FLAG_SECURE builds
	AboutInfoText.Append("Version "&Application.VersionName) 'App version (no CRLF char)
	#If OBFUSCATED
		'If it's obfuscated, then add a friendly warning
		'to highlight that the app should not be obfuscated
		'
		'The OBFUSCATED conditional symbol is a valid one
		'but will not be highlighted in the Basic4Android IDE,
		'it's only set at compile time but it does work
		
		'Add a space to the app version text
		AboutInfoText.Append(" ")
		
		'Set the caution label text to "OBFUSCATED"
		'Set a white color for the warning label text
		'Set a red color for the warning label background
		mnuAbout_AddVersionLabel(AboutInfoText, "OBFUSCATED", Colors.White, Colors.Red)
	#End If
	#If NO_FLAG_SECURE
		'Inform the user if they use an insecure build
		'
		'Insecure builds don't always warn the user
		'on startup with a toast notification,
		'as long as blocking the Recent Apps thumbnails
		'without using FLAG_SECURE is possible
		'
		'Nonetheless, it's nice to know which build you have
		'incase you're curious, rather than having to use an
		'older device to get the warning toast notifications
		'
		' - (Android 12 & earlier, API levels 32 and below)
		'
		'Even the very legacy devices up to 4.0.2 will not
		'show warning notifications on startup because
		'it's possible to block Recent Apps thumbnails
		'on these older Android versions without FLAG_SECURE
		
		'Add a space to the app version text
		AboutInfoText.Append(" ")
		
		'Set the warning label text to "INSECURE"
		'Set a black color for the warning label text
		'Set a yellow color for the warning label background
		mnuAbout_AddVersionLabel(AboutInfoText, "INSECURE", Colors.Black, Colors.Yellow)
	#End If
	#If LOGGING
		'Inform the user if they use a logging-enabled build
		'
		'Logging-enabled builds require Internet access for
		'the BridgeLogger to work, so this will reassure
		'users on why the app somehow requests the Internet
		'application permission, when they on the About menu
		
		'Add a space to the app version text
		AboutInfoText.Append(" ")
		
		'Set the info label text to "LOGGING"
		'Set a black color for the warning label text
		'Set a cyan color for the warning label background
		mnuAbout_AddVersionLabel(AboutInfoText, "LOGGING", Colors.Black, Colors.Cyan)
	#End If
	AboutInfoText.Append(CRLF) 'Now we can add the CRLF char
	
	'End the App name & version span
	AboutInfoText.PopAll
	
	'Make sure to leave one empty line between
	'the app name / version info and the description
	'
	'Adding it as its own span (Append CRLF then PopAll)
	AboutInfoText.Append(CRLF)
	AboutInfoText.PopAll
	
	'App description now
	AboutInfoText.Append("This app generates unblock codes for cryptographic PKI smartcards such as Yubikey & IDPrime, eToken."&CRLF)
	AboutInfoText.PopAll
	
	'Make sure to leave one empty line between
	'the app description and the copyleft notice
	'
	'Adding it as its own span (Append CRLF then PopAll)
	AboutInfoText.Append(CRLF)
	AboutInfoText.PopAll
	
	'Copyleft notice (bonus)
	'
	'Yes, the Alignment constant is passed as a String
	'
	'Basic4Android then resolves the layout alignment constant
	'automatically without having to create any Alignment Object
	AboutInfoText.Alignment("ALIGN_CENTER")
	'Make this copyleft notice 10% smaller
	AboutInfoText.RelativeSize(0.9) '10% is 0.10, so decrease its size by 0.10 (1.00 -> 0.90)
	AboutInfoText.Append("Copyleft ")
		'Copyleft icon (custom addition to MaterialIcons)
		AboutInfoText.VerticalAlign(2dip) 'Push the copyleft icon 2dip further below (calibrated value)
		AboutInfoText.Typeface(Typeface.MATERIALICONS)
		AboutInfoText.Append(Constants.COPYLEFT_ICON)
		'Pop only the last copyleft icon span attributes (VerticalAlign & Typeface)
		AboutInfoText.Pop 'Pop Typeface
		AboutInfoText.Pop 'Pop VerticalAlign
	'No CRLF needed for the last line
	AboutInfoText.Append(" "&Constants.APPLICATION_LICENSE) 'No CRLF for the last text line
	'End the last span too always
	AboutInfoText.PopAll
	
	'Positive button is 'Homepage'
	'Cancel   button is 'Dismiss'
	Msgbox2Async(AboutInfoText, "About", Constants.APPLICATION_HOMEPAGE_NAME, "Dismiss", Constants.MSGBOX_HIDE_NEGATIVE, AboutIcon, Constants.MSGBOX_CANCELLABLE)
	
	'The ViewState visibility status of
	'the About window is to be saved here
	'
	'Because it's while we wait for the
	'MsgBox result that it's visible
	#If LOGGING
	LogColor($"[Main-${LogContextId}] mnuAbout_Click: Setting the ViewState Visible attribute of the About window to True"$, Colors.Blue)
	#End If
	ViewState_mnuAbout_Visible = True
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] mnuAbout_Click: Waiting for the MessageBox to be closed to check its return result"$, Colors.Blue)
	#End If
	Wait For Msgbox_Result(Result As Int)
	
	'The ViewState visibility status of
	'the About window is to be saved here again
	'
	'Because it's after the MsgBox result came
	'that the About window is no longer visible
	#If LOGGING
	LogColor($"[Main-${LogContextId}] mnuAbout_Click: Setting the ViewState Visible attribute of the About window to False"$, Colors.Blue)
	#End If
	ViewState_mnuAbout_Visible = False
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] mnuAbout_Click: The MessageBox was closed, checking its return result"$, Colors.Blue)
	#End If
	If Result = DialogResponse.POSITIVE Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] mnuAbout_Click: The MessageBox return result is POSITIVE"$, Colors.Blue)
		#End If
		
		'Because I don't want to bundle the big Phone library
		'Use the Advanced class to open the browser URL
		#If LOGGING
		LogColor($"[Main-${LogContextId}] mnuAbout_Click: Requesting the opening of the App homepage URL in the user's default Web browser"$, Colors.Blue)
		#End If
		joMain.RunMethod("jOpenBrowserUrl", Array(Constants.APPLICATION_HOMEPAGE_URL))
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] mnuAbout_Click: The MessageBox return result is not POSITIVE, no nothing to do here"$, Colors.Blue)
		#End If
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] mnuAbout_Click: Sub return"$, Colors.Blue)
	#End If
End Sub

#End Region

#Region Challenge field event handlers

Private Sub edtChallenge_FocusChanged(HasFocus As Boolean)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] edtChallenge_FocusChanged: Sub entry (HasFocus = ${HasFocus})"$, Colors.Blue)
	#End If
	
	If HasFocus Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtChallenge_FocusChanged: HasFocus is True"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtChallenge_FocusChanged: Set ViewState last focused element to "edtChallenge""$, Colors.Blue)
		#End If
		ViewState_LastFocusedElement = "edtChallenge"
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtChallenge_FocusChanged: HasFocus is False"$, Colors.Blue)
		#End If
		
		'Android doesn't reset the selection information of
		'EditText fields when the focus is lost
		'
		'So the EditText selection timers call their respective
		'EditText_ShowSelectionInfo method but these functions
		'think that the their EditText selection didn't change
		'
		'To fix this, I just forewarn that the last focused
		'element is "undetermined" and the EditTexts'
		'respective EditText_ShowSelectionInfo methods will
		'verify that their element still has the focus
		'thanks to this forewarning being done in advance
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtChallenge_FocusChanged: Set ViewState last focused element to "undetermined" (will be set again properly by the next focused element)"$, Colors.Blue)
		#End If
		ViewState_LastFocusedElement = "undetermined"
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] edtChallenge_FocusChanged: Sub return"$, Colors.Blue)
	#End If
End Sub

#End Region

#Region Scan QR button event handlers

Private Sub btnScanQR_Click
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnScanQR_Click: Sub entry"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnScanQR_Click: Verify if the device has a Camera first before proceeding further"$, Colors.Blue)
	#End If
	If Common.GetNumberOfDeviceCameras < 1 Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnScanQR_Click: The device doesn't have a Camera, cannot proceed further"$, Colors.Magenta)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnScanQR_Click: Display an exception message in a toast notification"$, Colors.Magenta)
		#End If
		ToastMessageShow("Camera required to scan QR codes", Constants.TOAST_DURATION_SHORT)
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnScanQR_Click: Sub return"$, Colors.Magenta)
		#End If
		Return
		
	End If
	
	'Ask for authorization to use the Camera at runtime
	'Required on Android 6.0+
	'Has no effect on older Android versions
	Dim RuntimePerms As RuntimePermissions

	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnScanQR_Click: Checking if we have the Camera runtime permission"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnScanQR_Click: This is required on Android 6.0+ devices"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnScanQR_Click: This check will always return True on older Android versions"$, Colors.Blue)
	#End If
	If RuntimePerms.Check(RuntimePerms.PERMISSION_CAMERA) <> True Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnScanQR_Click: We don't have Camera runtime permission access"$, Colors.Magenta)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnScanQR_Click: Requesting Camera runtime permission (the user needs to agree)"$, Colors.Magenta)
		#End If
		RuntimePerms.CheckAndRequest(RuntimePerms.PERMISSION_CAMERA)
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnScanQR_Click: Waiting for the result of our Camera runtime permission request"$, Colors.Magenta)
		#End If
		Wait For Activity_PermissionResult(PermissionIdentifier As String, HavePermission As Boolean)
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnScanQR_Click: The results of our runtime permission request has come, checking if we were granted Camera access"$, Colors.Magenta)
		#End If
		If HavePermission <> True Then
			#If LOGGING
			LogColor($"[Main-${LogContextId}] btnScanQR_Click: Our Camera runtime permission request was rejected, cannot proceed further"$, Colors.Red)
			#End If
			
			#If LOGGING
			LogColor($"[Main-${LogContextId}] btnScanQR_Click: Display an exception message in a toast notification"$, Colors.Red)
			#End If
			ToastMessageShow("Permission required to scan QR codes", Constants.TOAST_DURATION_SHORT)
			
			#If LOGGING
			LogColor($"[Main-${LogContextId}] btnScanQR_Click: Sub return"$, Colors.Red)
			#End If
			Return
			
		Else
			#If LOGGING
			LogColor($"[Main-${LogContextId}] btnScanQR_Click: Our Camera runtime permission request was approved, now we can proceed further"$, Colors.Green)
			#End If
			
		End If
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnScanQR_Click: We got Camera runtime permission access (or the device runs an older version of Android which always gives access anyway)"$, Colors.Blue)
		#End If
		
	End If
	
	'Hide the Admin Key field when the user wants to scan a QR code,
	'because they might stay a little while on scanning the QR code,
	'then forget that they didn't hide it when they come back
	'to the Main module:
	' - And if there's somebody else next to them, they might
	'   accidentally see their Admin key before the user
	'   quickly hides it back
	'
	'This is the responsility of this Main module to do this task
	'before calling other Activities,
	'see the MyForegroundRotationDetection's CheckIfForegroundRotation
	'function code for more explanations about how this is not a bug,
	'and why it's not the job of CheckIfForegroundRotation to detect
	'Activity switching while the app is always in the foreground
	'
	'Also do this before starting another Activity,
	'otherwise Activity_Pause will immediately run
	'and pause this Activity before you can hide it
	chkHideAdminKey.Checked = True
	
	'
	'When you start another Activity, this one's Activity_Pause
	'automatically gets fired and handles the rest for you
	'
	'You don't have anything else in particular to do now
	'
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnScanQR_Click: Launching the QR scanner module Activity"$, Colors.Blue)
	#End If
	StartActivity(Scan)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnScanQR_Click: Sub return"$, Colors.Blue)
	#End If
End Sub

#End Region

#Region Admin Key field event handlers

Private Sub edtAdminKey_FocusChanged(HasFocus As Boolean)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] edtAdminKey_FocusChanged: Sub entry (HasFocus = ${HasFocus})"$, Colors.Blue)
	#End If
	
	If HasFocus Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtAdminKey_FocusChanged: HasFocus is True"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtAdminKey_FocusChanged: Set ViewState last focused element to "edtAdminKey""$, Colors.Blue)
		#End If
		ViewState_LastFocusedElement = "edtAdminKey"
		
		'This will already call edtAdminKey_ShowSelectionInfo
		'which will update the Admin Key label
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtAdminKey_FocusChanged: Enable the Admin Key selection timer because the Admin Key field is focused"$, Colors.Blue)
		#End If
		SelectionTimer_edtAdminKey.Enabled = True
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtAdminKey_FocusChanged: HasFocus is False"$, Colors.Blue)
		#End If
		
		'Android doesn't reset the selection information of
		'EditText fields when the focus is lost
		'
		'So the EditText selection timers call their respective
		'EditText_ShowSelectionInfo method but these functions
		'think that the their EditText selection didn't change
		'
		'To fix this, I just forewarn that the last focused
		'element is "undetermined" and the EditTexts'
		'respective EditText_ShowSelectionInfo methods will
		'verify that their element still has the focus
		'thanks to this forewarning being done in advance
		#If LOGGING
		LogColor($"[Main-${LogContextId}] edtAdminKey_FocusChanged: Set ViewState last focused element to "undetermined" (will be set again properly by the next focused element)"$, Colors.Blue)
		#End If
		ViewState_LastFocusedElement = "undetermined"
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] edtAdminKey_FocusChanged: Sub return"$, Colors.Blue)
	#End If
End Sub

Private Sub edtAdminKey_TextChanged(Old As String, New As String)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] edtAdminKey_TextChanged: Sub entry (sensitive parameters)"$, Colors.Blue)
	#End If
	
	'The Admin Key field text might be changed even if
	'the Admin Key field is not focused, such as when
	'generating a SHA256, SHA512 etc hash while another
	'field is focused, so the TextChanged event should
	'also update the Admin Key label too
	#If LOGGING
	LogColor($"[Main-${LogContextId}] edtAdminKey_TextChanged: Running the edtAdminKey_ShowSelectionInfo Sub to update the Admin Key label text"$, Colors.Blue)
	#End If
	edtAdminKey_ShowSelectionInfo
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] edtAdminKey_TextChanged: Sub return"$, Colors.Blue)
	#End If
End Sub

Private Sub SelectionTimer_edtAdminKey_Tick
	'
	'Don't add logging here to avoid log spam
	'
	'Also make sure functions called by this one
	'don't include logging to avoid flooding
	'your logcat when you need to do debugging
	'
	
	'If the Admin Key field is unfocused:
	'Make a call to edtAdminKey_ShowSelectionInfo atleast once
	'to reflect the change for the unfocused version of the
	'Admin Key label text
	'
	'Otherwise:
	'The timer wasn't disabled and cans keep looping to
	'continously update the Admin Key label text
	edtAdminKey_ShowSelectionInfo
	
	'Check if the Admin Key field is still focused
	If ViewState_LastFocusedElement <> "edtAdminKey" Then
		'Admin Key field is not focused
		
		'Disable this selection timer because it's not needed
		'when the Admin Key field is not focused
		SelectionTimer_edtAdminKey.Enabled = False
		
	End If
	
End Sub

Private Sub edtAdminKey_ShowSelectionInfo
	'
	'Don't add logging here to avoid log spam
	'This function is called by a Timer Sub
	'
	Dim TextLength, SelectionStart, SelectionLength, SelectionEnd As Int
	TextLength		= edtAdminKey.Text.Length
	SelectionStart	= edtAdminKey.SelectionStart
	SelectionLength	= edtAdminKey.SelectionLength
	SelectionEnd    = SelectionStart + SelectionLength
	
	'Only show selection information if the Admin Key field
	'is actually focused, otherwise show generic information
	Dim IsAdminKeyFocused As Boolean = (ViewState_LastFocusedElement == "edtAdminKey")
	
	'Visual neat tweak incase there's only one char
	'in the Admin Key field
	Dim chars As String
	
	'We say different from 1 instead of more than 1
	'This is because in theory 0 should be said as:
	' - "0 chars"
	'
	'Zero is a plural too, only the number 1 is singular
	'So this check lets both 0 and values more than 1 pass
	'
	'But no worries since we don't display the count
	'of characters if it's zero later on in this function
	'
	'This way of doing things is just so we stay correct
	'with number semantics and the plurality of language
	If TextLength <> 1 Then
		chars = "chars"
	Else
		chars = "char"
	End If
	
	If IsAdminKeyFocused And TextLength >= 1 And SelectionLength < 1 _
		And SelectionStart > 0 And SelectionStart < TextLength Then
		'When not selecting any text and just moving
		'the cursor (caret) around in the Admin key field
		'-[-------------|-------]-
		lblAdminKey.Text = $"Admin Key: (${TextLength} ${chars}) - Pos: ${SelectionStart}"$
		
	Else If IsAdminKeyFocused And TextLength >= 1 And SelectionLength >= 1 _
		And SelectionStart > 0 And SelectionEnd < TextLength Then
		'When selecting a part of text in the middle of the text
		'but not at the start of the text and also NOT all the
		'text until the end of it
		'-----xxxxxxxxxxxxxxx-----
		lblAdminKey.Text = $"Admin Key: (${TextLength} ${chars}) - Before: ${SelectionStart} | Sel: ${SelectionLength} | After: ${TextLength - SelectionEnd}"$
		
	Else If IsAdminKeyFocused And TextLength >= 1 And SelectionLength >= 1 _
		And SelectionStart > 0 Then
		'When selecting a part of text in the middle of the text
		'but not at the start of the text and also ALL the text
		'until the end of it
		'-----xxxxxxxxxxxxxxxxxxxx
		lblAdminKey.Text = $"Admin Key: (${TextLength} ${chars}) - Before: ${SelectionStart} | Sel: ${SelectionLength}"$
		
	Else If IsAdminKeyFocused And TextLength >= 1 And SelectionLength >= 1 _
		And SelectionStart == 0 And SelectionLength < TextLength Then
		
		'When selecting text starting at the first character
		'but not selecting the entire text length
		'xxxxxxxxxxxxxxxxxxxx-----
		lblAdminKey.Text = $"Admin Key: (${TextLength} ${chars}) - Sel: ${SelectionLength} | After: ${TextLength - SelectionEnd}"$
		
	Else If IsAdminKeyFocused And TextLength >= 1 And SelectionLength >= 1 _
		And SelectionStart == 0 Then
		'When all the text is selected
		'xxxxxxxxxxxxxxxxxxxxxxxxx
		lblAdminKey.Text = $"Admin Key: (${TextLength} ${chars}) - Sel: ${SelectionLength}"$
		
	Else If TextLength >= 1 Then
		'Admin key field not focused
		lblAdminKey.Text = $"Admin Key: (${TextLength} ${chars})"$
		
	Else
		'Admin key field empty
		lblAdminKey.Text = "Admin Key:"
		
	End If
	
End Sub

#End Region

#Region Hide Admin Key checkbox event handlers

Private Sub chkHideAdminKey_CheckedChange(Checked As Boolean)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Sub entry (Checked = ${Checked})"$, Colors.Blue)
	#End If
	
	'Start of part that must always be done ----- ----- ----- ----- -----
	'
	'This part needs to always be done even if the Checked value is
	'the same as the current one
	'
	#If LOGGING
	LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Doing the CheckedChange event part that must always be done"$, Colors.Blue)
	#End If
	If Checked Then
		'The Hide Admin Key Checkbox is checked
		'Its .Hint should also display bullet dots too
		#If LOGGING
		LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Set the Admin Key field .Hint (not .Text) to show bullets characters because Checked is True"$, Colors.Blue)
		#End If
		edtAdminKey.Hint = DEFAULT_BULLETS_ADMIN_KEY
		
	Else
		'The Hide Admin Key Checkbox is unchecked
		'Its .Hint cans now display the default Admin Key zeroes
		#If LOGGING
		LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Set the Admin Key field .Hint (not .Text) to show zeroes characters because Checked if False"$, Colors.Blue)
		#End If
		edtAdminKey.Hint = DEFAULT_ZEROES_ADMIN_KEY
		
	End If
	
	'Don't continue if the call comes from
	'the CheckedChange Hotfix function
	'
	'It tells us when it's the caller
	'by adding "[CHECKEDCHANGE_FROM_HOTFIX]"
	'to this CheckBox's Tag value
	'
	If chkHideAdminKey.Tag.As(String).Contains("[CHECKEDCHANGE_FROM_HOTFIX]") Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Now since the caller is the CheckedChange Hotfix function, we don't need to proceed further"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Just clearing the [CHECKEDCHANGE_FROM_HOTFIX] flag from this CheckBox's Tag"$, Colors.Blue)
		#End If
		chkHideAdminKey.Tag = chkHideAdminKey.Tag.As(String).Replace("[CHECKEDCHANGE_FROM_HOTFIX]", "")
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Sub return"$, Colors.Blue)
		#End If
		Return
		
	End If
	'
	'End of part that must always be done ----- ----- ----- ----- -----
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Verifying if the Admin Key was made unrevealable before and the requested .Checked state is False"$, Colors.Blue)
	#End If
	If Not(ViewState_chkHideAdminKey_Enabled) And Not(Checked) Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: We have a problem, looks like the Hide Admin Key checkbox was forcibly re-enabled using hacks"$, Colors.Red)
		#End If
		#If LOGGING
		LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: This might be a forensic Admin Key recovery attack"$, Colors.Red)
		#End If
		
		'Close any visible modal window before exit
		'Then simulate a KEYCODE_BACK Activity keypress
		#If LOGGING
		LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Exiting the App by simulating user natural exit (close any visible modal window then send a Back activity keypress)"$, Colors.Red)
		#End If
		btnHashMenu.Checked = False
		Activity_KeyPress(KeyCodes.KEYCODE_BACK)
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Sub return (this code shouldn't be reachable if the Activity exited correctly)"$, Colors.Red)
		#End If
		Return
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: All good, the caller isn't trying to reveal an unrevealable Admin key"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: The requested Checked value is ${Checked}"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Set ViewState of this checkbox checked state to ${Checked}"$, Colors.Blue)
	#End If
	ViewState_chkHideAdminKey_Checked = Checked
	
	'Allow preserving the selection state when toggling password modes
	#If LOGGING
	LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Saving information about the current selection state before toggling password modes"$, Colors.Blue)
	#End If
	Dim LastSelectionStart, LastSelectionLength As Int
	LastSelectionStart  = edtAdminKey.SelectionStart
	LastSelectionLength = edtAdminKey.SelectionLength
	
	If Checked Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Use the Security class to set the Admin Key password mode to PASSWORD_HIDDEN_PASSWORD"$, Colors.Blue)
		#End If
		Security.SetAdvancedPasswordMode(edtAdminKey, Constants.PASSWORD_HIDDEN_PASSWORD)
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Use the Security class to set the Admin Key password mode to PASSWORD_VISIBLE_PASSWORD"$, Colors.Blue)
		#End If
		Security.SetAdvancedPasswordMode(edtAdminKey, Constants.PASSWORD_VISIBLE_PASSWORD)
		
	End If
	
	'Allow preserving the selection state when toggling password modes
	#If LOGGING
	LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Restoring information about the previous selection state after toggling password modes"$, Colors.Blue)
	#End If
	edtAdminKey.SetSelection(LastSelectionStart, LastSelectionLength)
	
	'The Admin Key selection timer will already update the
	'Admin Key label text anyway within 100ms
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] chkHideAdminKey_CheckedChange: Sub return"$, Colors.Blue)
	#End If
End Sub

#End Region

#Region Hash Text menu button event handlers

Private Sub btnHashMenu_CheckedChange(Checked As Boolean)
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHashMenu_CheckedChange: Sub entry (Checked = ${Checked})"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHashMenu_CheckedChange: Set ViewState of this checkbox checked state to ${Checked}"$, Colors.Blue)
	#End If
	ViewState_btnHashMenu_Checked = Checked
	
	If Checked Then
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnHashMenu_CheckedChange: The Hash Text button is checked"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnHashMenu_CheckedChange: Show the text hashing options menu"$, Colors.Blue)
		#End If
		btnHashMenuBg.Visible = True
		btnSha256.Visible     = True
		btnSha512.Visible     = True
		
	Else
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnHashMenu_CheckedChange: The Hash Text button is unchecked"$, Colors.Blue)
		#End If
		
		#If LOGGING
		LogColor($"[Main-${LogContextId}] btnHashMenu_CheckedChange: Hide the text hashing options menu"$, Colors.Blue)
		#End If
		btnSha512.Visible     = False
		btnSha256.Visible     = False
		btnHashMenuBg.Visible = False
		
	End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHashMenu_CheckedChange: Calling FixHashMenuButtonTextColorIfNeeded(${Checked}) to fix the Hash Text button's text color if needed..."$, Colors.Blue)
	#End If
	FixHashMenuButtonTextColorIfNeeded(Checked)
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHashMenu_CheckedChange: Sub return"$, Colors.Blue)
	#End If
End Sub

Private Sub btnHashMenuBg_Click
	#If LOGGING
	Dim LogContextId As Int = Rnd(1000, 9999)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHashMenuBg_Click: Sub entry"$, Colors.Blue)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHashMenuBg_Click: The Hash Text menu shade background was clicked"$, Colors.Blue)
	#End If
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHashMenuBg_Click: Hide the text hashing options menu"$, Colors.Blue)
	#End If
	btnHashMenu.Checked = False
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] btnHashMenuBg_Click: Sub return"$, Colors.Blue)
	#End If
End Sub

#End Region

