	LogColor($"[Main-${LogContextId}] Activity_Start: Now we can proceed further"$, Colors.Black)
	#End If
	
	#If LOGGING
	LogColor($"[Main-${LogContextId}] Activity_Start: Updating this Activity's Lifecycle tracking for foreground rotation detection"$, Colors.Black)
	#End If
	ForegroundRotationDetection.ActivityLifecycle = ForegroundRotationDetection.ActivityLifecycle & ForegroundRotationDetection.Start
