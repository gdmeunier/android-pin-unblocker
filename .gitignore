#
# Basic4Android .gitignore template
#

# Auto-backups
AutoBackups/*

# Don't ignore pre-configured App icon
!Objects/res/drawable/icon.png

# APK generator
Objects/*

# APK files
*.apk

# Desktop.ini files
#  - Desktop.ini files in subfolders are
#    automatically ignored as well
#  - No need to write "**/desktop.ini"
desktop.ini

#
# Specific to Android PIN Unblocker
#

# Releases folder
Releases/*

# Recaf program folder
Recaf/*

# Don't ignore the MyApkTool EXE file only
!MyApkTool/MyApkTool.7z.001
!MyApkTool/MyApkTool.7z.002
!MyApkTool/MyApkTool.7z.003
!MyApkTool/MyApkTool.exe.sha256

# MyApkTool Pro program folder
MyApkTool/*

# Don't ignore the local acssmc library mirror
# Because you know, manufacturers love removing
# their old download links at a whim,
# and if we don't backup these files,
# they will become lost because nobody backed them up
!Obsolete/Libraries/*

# Some obsolete assets that are no longer used,
# but perhaps people might like having them preserved
!Obsolete/Files/*
!Obsolete/Icons/*
!Obsolete/Scratchpad/*

# Ignore the Obsolete folder
Obsolete/*


