import java.security.AlgorithmParameterGenerator;
import java.security.AlgorithmParameters;
import java.security.NoSuchAlgorithmException;
import java.security.InvalidKeyException;

//
// Adding builtin hashing functions to the App
//

import java.security.MessageDigest;
import java.math.BigInteger;

//
// Alternative to finishAndRemoveTask() for Android versions
// lower than Android 5.0 (Android API level < 21)
//

import android.content.Intent;

//
// Added improved logging for native Java code exceptions
//

import android.util.Log;

//
// For getting the App's package name (the getPackageName() function)
//
import android.content.Context;

//
// Disable the fullscreen keyboard on this Activity's EditTexts.
//
// Thanks to:
// https://stuff.mit.edu/afs/sipb/project/android/docs/reference/android/view/inputmethod/EditorInfo.html
//
import android.widget.EditText;
//import android.view.inputmethod; // This one refuses to work so I skip it.

//
// Securely overwrite EditText contents with
// dummy data when needed (for security reasons).
//
//import android.widget.EditText; // already imported for disabling the fullscreen keyboard.
import android.widget.TextView;

//
// Replace the Phone library with quick Java functions
//
//import android.content.Intent; // already imported for the finishAndRemoveTask workaround.
