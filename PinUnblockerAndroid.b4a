/* ************************************************ */

//
// Fixing Android's flawed monospace implementation for digits.
// Also known as 'enabling tabular numbers' in monospace fonts.
//
// Thanks to:
// https://stackoverflow.com/a/41143337
// https://developer.android.com/reference/android/widget/TextView.html#setFontFeatureSettings(java.lang.String)
// https://www.w3.org/TR/css-fonts-3/#font-feature-settings-prop
//
// https://dev.to/maximsaplin/androids-monospace-font-is-not-monospace-151j
// https://github.com/adobe-fonts/source-code-pro
//
public void fixMonospaceDigitsFont(EditText myEditText) {
	//
	// Check Android SDK version - Android API level 21+ (Android 5.0+)
	//
	if ( android.os.Build.VERSION.SDK_INT >= 21 )
	{
		myEditText.setFontFeatureSettings("tnum");
	}
}

//
// Set the fontFamily attribute for EditTexts with the
// desired monospace font-family / typeface because some
// Android phones don't prioritize typeface over font-family.
//
// Thanks to:
// https://stackoverflow.com/a/29109277
// https://developer.android.com/reference/android/graphics/Typeface#MONOSPACE
//
public void forceCorrectMonospaceFont(EditText myEditText) {
	//
	// Two functions exist with different parameters.
	//
	myEditText.setTypeface(Typeface.MONOSPACE);
	myEditText.setTypeface(Typeface.MONOSPACE, Typeface.NORMAL);
}

//
// Replace the Phone library with quick Java functions
//
public void openBrowserUrl(String browserUrl) {
	//
	// Thanks to:
	// https://stackoverflow.com/a/10532210
	// https://stackoverflow.com/a/10120624
	//
	if ( !browserUrl.startsWith("https://") && !browserUrl.startsWith("http://") )
	{
		browserUrl = "http://" + browserUrl;
	}
	
	/* Intent i = new Intent(Intent.ACTION_VIEW);
	   i.setData(Uri.parse(browserUrl));
	   startActivity(i);
	*/
	startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(browserUrl)));
}

