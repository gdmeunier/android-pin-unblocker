public void finishAndRemoveTaskForNewerAndroid() {
	
	finishAndRemoveTask();
	
	//
	// Close the App for real without any background process
	// remaining in the Android host process cache
	//
	// Thanks to:
	// https://stackoverflow.com/q/53494605
	// https://stackoverflow.com/a/53494692
	//
	System.exit(0); // return success
}

//
// Alternative to finishAndRemoveTask() for Android versions
// lower than Android 5.0 (Android API level < 21)
//
// Thanks to:
// https://stackoverflow.com/a/50745444
// https://stackoverflow.com/q/66962704
//
public void finishAndRemoveTaskForOlderAndroid() {
	//
	// Basic4Android's 'Main' module will be called 'main.class'
	// For the 'Scan' module it would've been called 'scan.class'
	//
	Intent clearIntent = new Intent(this, main.class);
	
	clearIntent.addFlags(
		Intent.FLAG_ACTIVITY_NEW_TASK             |
		Intent.FLAG_ACTIVITY_CLEAR_TASK           |
		Intent.FLAG_ACTIVITY_EXCLUDE_FROM_RECENTS
	);
	clearIntent.putExtra("ExitApplication", true);
	
	startActivity(clearIntent);
}

