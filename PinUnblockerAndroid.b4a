Build1=Default,net.generic.smartcardpuk
Build2=NO_FLAG_SECURE,net.generic.smartcardpuk,NO_FLAG_SECURE
File1=About.png
File2=MainLayout.bal
File3=ScanLayout.bal
FileGroup1=Default Group
FileGroup2=Default Group
FileGroup3=Default Group
Group=Default Group
Library1=core
Library2=javaobject
Library3=newqrcodereaderview
Library4=runtimepermissions
ManifestCode=~\n~'Application identity~\n~SetApplicationAttribute(android:icon, "@drawable/icon")~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~~\n~'Try improving compatibility of zxing QR code scanning~\n~'with older devices that might require hardware acceleration~\n~'due to the use of GPU for rendering the camera preview, etc.~\n~SetApplicationAttribute(android:hardwareAccelerated, "true")~\n~~\n~'Application theme~\n~'CreateResourceFromFile(Macro, Themes.DarkTheme)~\n~~\n~'Try supporting for Android 2.3+ now (API level 9+)~\n~SetApplicationAttribute(android:theme, "@style/Tweak")~\n~~\n~'~\n~' Tweaking the theme values to have the correct API levels.~\n~'~\n~' Thanks to:~\n~' - https://stackoverflow.com/a/9832255~\n~' - https://android.googlesource.com/platform/frameworks/base/+/HEAD/core/res/res/values/themes.xml~\n~'~\n~' XML attributes in res/values can actually have any filename,~\n~' it doesn't have to be named 'theme.xml' or anything actually.~\n~'~\n~' So I can customize the theme XML filename too.~\n~'~\n~' Thanks to:~\n~' - https://stackoverflow.com/a/68598815~\n~'~\n~CreateResource(values-v21, tweak.xml,<resources>~\n~	<style name="Tweak" parent="@android:style/Theme.Material">~\n~	</style>~\n~</resources>) ' aka. 'theme.xml'~\n~CreateResource(values-v11, tweak.xml,<resources>~\n~	<style name="Tweak" parent="@android:style/Theme.Holo">~\n~	</style>~\n~</resources>) ' aka. 'theme.xml'~\n~CreateResource(values,     tweak.xml,<resources>~\n~	<style name="Tweak" parent="@android:style/Theme">~\n~	</style>~\n~</resources>) ' aka. 'theme.xml'~\n~~\n~'~\n~' Disable the new Android 8.0+ Autofill service~\n~' for the entire project (additionally to disabling it in code).~\n~'~\n~' Thanks to:~\n~' - https://stackoverflow.com/a/46853690~\n~' - https://stackoverflow.com/a/18365454~\n~' - https://reactnative.dev/docs/textinput#importantforautofill-android~\n~' - https://android.googlesource.com/platform/frameworks/base/+/refs/heads/main/core/res/res/values/themes_device_defaults.xml~\n~' - https://blog.octo.com/android-themes-styles-a-real-architecture~\n~' - https://blog.octo.com/android-themes-and-styles-a-real-architecture~\n~' - https://medium.com/@debasishraut.dev/introduction-to-android-ui-design-with-xml-b777e09c8d10~\n~'~\n~CreateResource(values-v26, tweak.xml,<resources>~\n~	<style name="Tweak" parent="@android:style/Theme.DeviceDefault">~\n~		<item name="android:editTextStyle">@style/Tweak.EditText</item>~\n~	</style>~\n~</resources>) ' aka. 'theme.xml'~\n~CreateResource(values-v26, tweak_edittext.xml,<resources>~\n~	<style name="Tweak.EditText" parent="@android:style/Widget.EditText">~\n~		<item name="android:importantForAutofill">noExcludeDescendants</item>~\n~		<item name="android:allowUndo">false</item>~\n~	</style>~\n~</resources>) ' aka. 'styles.xml' | ^ hardening againt allowUndo attribute~\n~~\n~'~\n~' Disable the ability to use Undo & Redo functions on~\n~' the EditText fields to prevent recovery of a previous~\n~' text that was Hashed (for example).~\n~'~\n~' Hypothetical attack scenario:~\n~' An attacker plugs an USB keyboard over OTG to the phone,~\n~' focuses on the Admin Key field then presses CTRL+Z.~\n~'~\n~' This styling makes this impossible to do (hardening).~\n~'~\n~' This undo / redo functionality is also only available on~\n~' Android 6.0+ (API level 23+)~\n~'~\n~' Thanks to:~\n~' https://developer.android.com/reference/android/widget/TextView#attr_android:allowUndo~\n~' https://android.stackexchange.com/a/241708~\n~' https://stackoverflow.com/questions/79722988/intercept-api-35-system-undo-and-redo~\n~' https://android.googlesource.com/platform/frameworks/base/+/android-8.0.0_r1/core/res/res/values/attrs.xml~\n~'~\n~CreateResource(values-v23, tweak.xml,<resources>~\n~	<style name="Tweak" parent="@android:style/Theme.Material">~\n~		<item name="android:editTextStyle">@style/Tweak.EditText</item>~\n~	</style>~\n~</resources>) ' aka. 'theme.xml'~\n~CreateResource(values-v23, tweak_edittext.xml,<resources>~\n~	<style name="Tweak.EditText" parent="@android:style/Widget.EditText">~\n~		<item name="android:allowUndo">false</item>~\n~	</style>~\n~</resources>) ' aka. 'styles.xml' | ^ hardening againt allowUndo attribute~\n~~\n~'~\n~'Try supporting Android 2.3+ now (API level 9+)~\n~'~\n~'Update: Increase Target SDK version to 33 (was 32) in order to activate~\n~'        the new privacy hardening tweaks on newer Android versions.~\n~'~\n~AddManifestText(<uses-sdk android:minSdkVersion="9" android:targetSdkVersion="33"/>)~\n~~\n~'Support all screen sizes & densities~\n~AddManifestText(~\n~<supports-screens android:largeScreens="true" ~\n~	android:normalScreens="true" ~\n~	android:smallScreens="true" ~\n~	android:anyDensity="true"/>)~\n~~\n~'Require Camera runtime permission (Android 6.0+)~\n~'~\n~'Turns out I actually don't need to explicitly add this~\n~'in the manifest editor since the NewQRCodeReader library~\n~'automatically adds it anyway, and adding it explicitly~\n~'actually caused the App to have two duplicate~\n~'Camera permission lines in the App manifest.~\n~'~\n~'So I comment this to avoid having two duplicate Camera permissions.~\n~'~\n~'AddManifestText(~\n~'<uses-permission android:name="android.permission.CAMERA"/>)~\n~~\n~'Require Flashlight permission~\n~AddPermission(android.permission.FLASHLIGHT)~\n~~\n~'Use Camera feature but it's not required (required="false")~\n~'These uses-feature lines are actually required for the App~\n~'but it's the Android feature attribute "required" that we set to "false".~\n~AddManifestText(~\n~<uses-feature android:name="android.hardware.camera" android:required="false"/>~\n~<uses-feature android:name="android.hardware.camera.front" android:required="false"/>~\n~<uses-feature android:name="android.hardware.camera.any" android:required="false"/>)~\n~~\n~'Add Share To functionality for receiving the Admin Keys~\n~'~\n~'The first added Activity text doesn't need to have a line break~\n~'added before the text, because Basic4Android already adds the~\n~'first one itself when generating the App manifest.~\n~'~\n~AddActivityText(Main,<intent-filter>~\n~	<action android:name="android.intent.action.SEND"/>~\n~	<category android:name="android.intent.category.DEFAULT"/>~\n~	<data android:mimeType="text/plain"/>~\n~</intent-filter>)~\n~~\n~'Exclude the App from the Recent Apps list because otherwise~\n~'there's a risk of leaking the Admin keys inside~\n~'the Recent thumbnails (visible text)~\n~'~\n~'Finally not implemented in favor of FLAG_SECURE:~\n~'SetActivityAttribute(Main, "android:excludeFromRecents", "true")~\n~~\n~'Always detach the Main activity from any task affinity~\n~'~\n~'This way if another application launches this one then~\n~'it will not share the same Task manager affinity level with it~\n~'~\n~'Google summary:~\n~'~\n~'Security (Anti-Hijacking): It is a security best practice to prevent~\n~'Task Hijacking attacks. By clearing the affinity, you prevent~\n~'malicious apps from potentially launching their own activities into~\n~'your app's task stack.~\n~'~\n~'Task Isolation: When combined with intent flags like FLAG_ACTIVITY_NEW_TASK,~\n~'it forces the activity to start in a separate task environment rather than~\n~'grouping with other app activities.~\n~'~\n~SetActivityAttribute(Main, "android:taskAffinity", "")~\n~~\n~'Exclude the Scan Activity from the Recent Apps panel~\n~'Only the Main Activity should be visible in the Recent Apps~\n~SetActivityAttribute(Scan, "android:excludeFromRecents", "true")~\n~~\n~'Make the Scan Activity non-exported (private Activity)~\n~SetActivityAttribute(Scan, "android:exported", "false")~\n~~\n~'Prevent the App from running in background~\n~RemovePermission(android.permission.FOREGROUND_SERVICE)~\n~~\n~'~\n~'Open browser URL Intents for Android API level 30+ (Android 11+)~\n~'~\n~' Thanks to:~\n~' https://stackoverflow.com/a/10120624~\n~' https://developer.android.com/training/basics/intents/filters#AddIntentFilter~\n~'~\n~AddManifestText(~\n~<queries>~\n~    <intent>~\n~        <action android:name="android.intent.action.VIEW" />~\n~        <category android:name="android.intent.category.BROWSABLE" />~\n~        <data android:scheme="https" />~\n~        <data android:scheme="http" />~\n~    </intent>~\n~</queries>)~\n~~\n~
Module1=|relative|.\Scan
Module2=Shared
NumberOfFiles=3
NumberOfLibraries=4
NumberOfModules=2
Version=12.5
@EndOfDesignText@
#Region  Project Attributes 
	'Application identity
	#ApplicationLabel: Android PIN Unblocker
	#VersionCode: 45
	#VersionName: 3.20.0
	'
	' Update from 3.19.0:
	'
	' 3.20.0: - (+) Blocked the ability for Android to do autocomplete.
	'
	'         - (+) Blocked the ability for Android to auto-suggestions.
	'
	'         - (+) Blocked the ability for Android to autocorrect text.
	'
	'         - (+) Blocked the ability for Android to learn new words.
	'
	'         - (+) Blocked the ability to use Android 8.0 / API 26's builtin
	'               Autofill service so that it doesn't interact with this App.
	'
	'         - (x) Increase target SDK version to 33 (was 32) in order to activate
	'               the new privacy hardening tweaks on newer Android versions.
	'
	'         - (x) Modified the App manifest to refactor the theme resources
	'               declaration and the App theme's name, XML filenames.
	'
	'               This includes using proper / corrected API level values.
	'
	'         - (x) Compiling the App against the Android 17's android.jar file
	'               now that I need some constant values from it (version 37.0),
	'               when I introduced privacy hardening tweaks for EditTexts.
	'
	'               The App was previously compiled using version 33 of the
	'               Android SDK platform (android.jar file).
	'
	'               The App will stay compatible with Android 2.3+ anyway.
	'
	'         - (+) Disabled the ability to use Undo & Redo functions on
	'               the EditText fields To prevent recovery of a previous
	'               text that was Hashed (For example).
	'
	'         - (x) Finally corrected the annoying issue of the monospace font
	'               not applying correctly on some Android devices for the
	'               Admin Key EditText field, by re-creating it from scratch.
	'
	'         - (+) Added a fix for Android's flawed monospace implementation
	'               for monospace digits.
	'
	'               Also known As 'enabling tabular numbers' in monospace fonts.
	'
	'         - (+) Added a fix for Android's flawed monospace implementation
	'               for monospace font-family vs typeface selection.
	'
	'         - (+) Made the Admin Key field in the Main module register
	'               as a visible password field by default rather than
	'               registering as a normal text field (improves security).
	'
	'         - (+) Made the Admin Key field retain its cursor position and
	'               text selection when toggle the Hide Admin key checkbox,
	'               because this previously moved the cursor to the beginning
	'               of the EditText everytime PasswordMode visibility was toggled.
	'
	'         - (+) Made the Admin Key field get unfocused when clicking
	'               the Generate button to get a Response code,
	'               because it's an opportunity to make the Admin key
	'               cursor position Timer run less often.
	'
	'               It's now automatically focusing on the Response code field
	'               when you click on the Generate button.
	'
	'         - (+) Made the Hash buttons automatically focus on the Admin Key field
	'               to bring attention to the Hash result visually.
	'
	'         - (+) Added the ability to now know both the cursor position and
	'               the selection length when selecting text in the Admin Key field,
	'               rather than only knowing the selection length.
	'
	'               This is useful for people who trim Admin key hashes to only
	'               keep the first 48-chars without having to calculate
	'               the number of characters to trim (e.g. 128-48 = 80 chars to remove).
	'
	'         - (+) Added the ability to now know the number of characters after
	'               the last selected character when selecting Admin key characters
	'               starting at the first position (first character ie. index 0).
	'
	'               This is useful for people who only keep the last 48-chars
	'               of an Hash as their Admin key.
	'
	'         - (+) The App is now focusing by default on the Challenge code field
	'               when running it for the first time (first time = launching the app).
	'
	'               When pausing then resuming the App (switching to another App),
	'               the last focused element is left as-is (no focus change).
	'
	'         - (x) Corrected the package import not found in native Java code
	'               when importing the inputmethod's EditorInfo package,
	'               which means that the workaround constants are now
	'               commented out too and left in the code for
	'               historical reference only (now using proper builtin constants).
	'
	'         - (x) Improved Java native code package imports documentation.
	'
	'         - (x) Corrected the QR Scanner module's Activity background color
	'               not being set (Default) which caused a different
	'               background color to appear on older devices (e.g. CyanogenMod 7 ROMs).
	'
	'         - (-) De-duplicated the Main & QR scanner layouts' button text sizes
	'               which were always being set to the same size in all the various
	'               layout variant scripts anyway.
	'
	'         - (x) Slowed down the Admin Key cursor position Timer from 100ms
	'               to 200ms since it doesn't need to be very fast,
	'               and 200ms is perfect for our use-case since it's still
	'               instantaneous for the Human eye (like an eyeblink).
	'
	'         - (+) Added a Hotfix for the App not being able to properly exit
	'               on the first back button press in the Main module,
	'               after having successfully scanned a QR code.
	'
	'               The Hotfix is an uncommon trick but it does the job.
	'
	'         - (+) Updated app screenshots since the last App version release.
	'
	#SupportedOrientations:       unspecified
	#CanInstallToExternalStorage: False
	
	'Compile-time settings
	#BridgeLogger: False
	#MultiDex:     False
	
	'Ignore recommended target SDK warning (31)
	'Ignore function value returns warning (2)
	'Ignore this sub only for variable declarations warning (29)
	#IgnoreWarnings: 31,2,29
	
#End Region

#Region  Activity Attributes 
	#FullScreen:   False
	#IncludeTitle: True
#End Region

Sub Process_Globals
	'These variables can be accessed from all modules.
	'
	
	'For using and running Java functions
	Private NativeMain As JavaObject
	
	'Anti-leak protection for Admin keys in Recent thumbnails:
	'
	'Add missing KeyCodes constants from Basic4Android to
	'the project source code directly.
	'
	Public Const KEYCODE_LOCK        As Int = 324
	Public Const KEYCODE_RECENT_APPS As Int = 312
	
	'Add homepage URL constant for the new About menu item.
	'If you fork this App, you can change the URL to your own.
	Public Const APP_HOMEPAGE_URL As String = "https://github.com/gdmeunier/android-pin-unblocker"
	
	'Once an Admin key has already been shared to the App via Share To,
	'we should disclose if it has already been shared once.
	'
	'Use-case: Sharing invalid Admin key, generating a new proper one,
	'then you press the Home button.
	'
	'Now when you go back to the App, your Admin key is cleared because
	'Android re-shared the Admin key on Activity resume to the App.
	'
	'This fixes the mentioned behavior and is easy to implement.
	Private AdminKeyAlreadySharedOnce As Boolean = False
	
	'Allow only this App to send Share To containing challenge codes
	'so that when the user scans a QR code containing a challenge code,
	'they don't get it put back again by Android in the Challenge code field
	'whenever they switch to another app then go back to this one using
	'the Recent Apps panel.
	'
	'False by default, but it will be set to True by
	'the Scan module's qrReaderView_result_found function.
	'
	'After the Challenge QR code result is shared, then
	'this module's Activity_Resume function will disallow it again
	'by setting it back to False.
	Public SharingQRCodeChallengeIntentAllowed As Boolean = False
	
	'Added a flag to avoid hiding the default Admin key on the first
	'App launch (Activity create with FirstTime set to True).
	'
	'It will be set to True or False when launching the App inside
	'the Activity_Create function.
	Private DontHideAdminKeyBecauseFirstActivityLaunch As Boolean = False
	
	'Add secure overwriting of Admin keys in memory
	'when they're no longer used or needed.
	'
	' - ERASE_CHALLENGE_RESPONSE_STRING_VALUE cans contain up to 64 chars (AES-256).
	' - ERASE_ADMIN_KEY_STRING_VALUE cans contain up to 128 chars (SHA512).
	'
	'In java code, they will be called:
	'
	' * _erase_challenge_response_string_value
	' * _erase_admin_key_string_value
	'
	'These ones have to be before the Saved state variables,
	'otherwise these values wouldn't exist yet.
	'
	Public Const ERASE_CHALLENGE_RESPONSE_STRING_VALUE As String = "################################################################"
	Public Const ERASE_ADMIN_KEY_STRING_VALUE          As String = ERASE_CHALLENGE_RESPONSE_STRING_VALUE&ERASE_CHALLENGE_RESPONSE_STRING_VALUE
	
	'When the device screen orientation rotates while the App is running,
	'the App's Activity gets:
	' - Paused (UserClosed = False)
	' - Created
	' - Resumed
	'
	'So I need to make sure that the Admin Key field stays the same
	'even when you rotate the device screen's orientation.
	'
	'They now need an initial value because I don't use empty-string
	'as initial value anymore ("empty" is now when it has the erase value).
	'
	Private SavedAdminKeyBeforeConfigurationChange  As String = ERASE_ADMIN_KEY_STRING_VALUE
	
	'Also make sure the Challenge code field doesn't get
	'reset to empty value when e.g. the device rotates too.
	Private SavedChallengeBeforeConfigurationChange As String = ERASE_CHALLENGE_RESPONSE_STRING_VALUE
	
	'Also make sure the Response code field doesn't get
	'reset to empty value when e.g. the device rotates too.
	Private SavedResponseBeforeConfigurationChange  As String = ERASE_CHALLENGE_RESPONSE_STRING_VALUE
	
	'Save the response label text as it was instead of
	're-computing the response algorithm detection.
	'
	'This one needs an initial value because it will be used
	'at the start of the Application too.
	'
	Private SavedResponseLabelBeforeConfigurationChange As String = "Response:"
	
	'When the device rotates, a disabled hide Admin Key checkbox
	'becomes enabled again; so we have to check for whether
	'the 'Hide Admin Key' checkbox was disabled before,
	'and if yes we disable it again.
	'
	'Note: No need to restore the Admin Key field's PasswordMode
	'      because it's always set to PasswordMode on both the
	'      Activity pause & Activity resume events.
	'
	'By default in the first App run in memory, it's set to True
	'which means the checkbox is by default enabled (not disabled).
	'
	Private SavedHideAdminKeyStateBeforeConfigurationChange As Boolean = True
	
	' Update: These mentioned constants below aren't needed anymore
	'         because I managed to fix the package import issue.
	'
	'         This code stays here in commented form
	'         for historical reference purposes only.
	' ----------------------------------------------------------------
	' Add more constants to support disabling the fullscreen keyboard.
	'
	' In Java code, they will be called:
	'  * _ime_flag_no_extract_ui
	'  * _ime_flag_no_fullscreen
	'
	' Thanks to:
	' https://stuff.mit.edu/afs/sipb/project/android/docs/reference/android/view/inputmethod/EditorInfo.html
	'
	' These constants have been added because
	' the "android.view.inputmethod package" package
	' refuses to correctly get imported,
	' so I directly re-implemented the constants here.
	'
	'Public Const IME_FLAG_NO_EXTRACT_UI As Int = 0x10000000 'Added in API level 3+  (Android 1.5+)
	'Public Const IME_FLAG_NO_FULLSCREEN As Int = 0x02000000 'Added in API level 11+ (Android 3.0+)
	'
	
	'Must use a separate JavaObject for the Shared class
	Public NativeShared As JavaObject
	NativeShared.InitializeStatic(Application.PackageName&".shared")
	
	'Declare a constant containing the device's SDK version
	'
	'We do it using a NativeShared JavaObject because
	'we don't yet have access to the proper NativeMain object.
	'
	'It will only be initialized later on Activity_Create(FirstTime = True).
	'
	'So because we want to set this SDK_INT constant very early,
	'we have to create a totally separate JavaObject.
	'
	Public Const SDK_INT As Int = NativeShared.RunMethod("getAndroidSdkVersion", Null)
	
	'This flag stores the state of the Hide Admin Key checkbox
	'If it was enabled before e.g. a configuration change,
	'then it will be restored properly.
	'
	'Do note that this is a different kind of flag than the other ones.
	'
	'This flag is set by the chkHideAdminKey_CheckedChange function itself.
	'It also cannot re-enable or uncheck a checkbox that became disabled.
	'
	Private WasHideAdminKeyCheckboxCheckedFlag As Boolean = False
	
	' Add the ability to know the length of the text selection
	' for the Admin key field, when the user selects a range of text.
	'
	' This is done using a Timer that only works (ticks) when
	' the Admin key field is selected (has focus).
	'
	Private AdminKeyTextSelectionTimer As Timer
	
	'Default init value = False.
	'Always give this variable a default value directly during init.
	'
	Private WasAdminKeyFieldFocused As Boolean = False
	
	'
	' Backup & restore the cursor position & text selection when
	' toggling PasswordMode visibility.
	'
	' Here they need a default initial value
	'
	Private SavedAdminKeySelectionStartBeforeConfigurationChange  As Int = 0
	Private SavedAdminKeySelectionLengthBeforeConfigurationChange As Int = 0
	
	' Hotfix for the App not being able to properly exit
	' on the first back button press in the Main module,
	' after having successfully scanned a QR code.
	'
	Private HotfixForOldDevicesExitAppFlag As Boolean = False
	
End Sub

Sub Globals
	'These global variables will be redeclared each time the activity is created.
	'These variables can only be accessed from this module.
	
	'Tweak the padding of the Hash menu button background (btnHashMenuBg)
	Private lblChallenge   As Label
	
	Private inpChallenge   As EditText
	Private btnScanRequest As Button
	
	'Needed to show Admin Key length when counting chars
	Private lblAdminKey     As Label
	Private inpAdminKey     As EditText
	Private chkHideAdminKey As CheckBox
	
	'
	' Note: The lblResponseCode field in the Main module layout is now
	'       above the btnGenerateResponse, in order to allow
	'       btnGenerateResponse & other buttons to be on-top of it.
	'
	'       This is intentional, not a mistake.
	'       It actually properly allows arranging the Main module's
	'       160dpi/mdpi layout variant.
	'
	'Need to show which algorithm was detected when
	'generating a response code (there are many now)
	'
	Private lblResponse      As Label
	
	Private btnGenerate As Button
	
	Private inpResponse      As EditText
	Private btnShareResponse As Button
	
	'New builtin text hashing functions
	'
	'Note: Basic4Android only allows buttons to overlap a button
	'So you have to use a transparent button to create an overlay
	'
	Private btnHashMenuBg As Button
	Private btnHashMenu   As ToggleButton
	Private btnSha256     As Button
	Private btnSha512     As Button
	
End Sub

#If JAVA
//
// Must be before Activity_Create in order to work
//

//
// Add ability to hide the Title bar / Action bar
// on devices with a very low display scale
// such as 0.75 (120dpi/ldpi).
//
import android.app.Activity;  // getWindow(), requestWindowFeature() & getActionBar()
import android.view.Window;   // Window object & Window constants
import android.app.ActionBar; // ActionBar object

//
// Adding FLAG_SECURE support to this App to avoid
// leaking Admin keys in Recent Apps thumbnails.
//
import android.view.WindowManager;              // setFlags()
import android.view.WindowManager.LayoutParams; // LayoutParams constants

//
// Disable the new Android 8.0+ Autofill service.
//
// We don't want any autofill service from Android itself
// inside this App, if people need autofill then they
// need to use a third-party secure one such as KeePassDX.
//
// The builtin Android Autofill service should never be trusted.
//
// This function will also be used for the QR scanner module,
// so I put it inside the Shared class.
//
// Perhaps I might even move move Java native methods here
// in the Shared class, if the App oneday gets more Activities
// with EditTexts inside.
//
// Why I want to disable the Autofill service in the
// QR scanner module, you may ask, especially since
// it has no EditTexts?
//
// That's because I don't want the Android Autofill service
// to ever initialize in any way inside this App's process,
// and it could risk getting initialized when trying to
// scan QR codes even if there are no EditTexts inside.
//
// Thanks to:
// https://stackoverflow.com/questions/45731372/disabling-android-o-auto-fill-service-for-an-application
// https://reactnative.dev/docs/textinput#importantforautofill-android
//

//import android.app.Activity;       // getWindow()
//import android.view.Window;        // getDecorView()
import android.view.ViewStructure;   // setImportantForAutofill()
import android.view.View;            // View.IMPORTANT_FOR_AUTOFILL_NO_EXCLUDE_DESCENDANTS

#End If

Sub Activity_Create(FirstTime As Boolean)
	'
	' Hotfix for the App not being able to properly exit
	' on the first back button press in the Main module,
	' after having successfully scanned a QR code.
	'
	If HotfixForOldDevicesExitAppFlag == True Then
		For i = 0x00000001 To 0x7FFFFFFE
			'
			' So a Do While True / ExitApplication / Loop
			' won't work?
			'
			' Well so you bet this one method will work!
			'
			ExitApplication()	' Use ExitApplication here
								' to truly close the App.
		Next
	End If
	
	Activity.LoadLayout("MainLayout")
	Activity.Title = Application.LabelName
	
	'Method for API 11+ (Android 3.0+ with Action Bar buttons)
	If SDK_INT >= 11 Then
		'
		'Trying to make a better Activity menu with just one button
		'instead of a full menu (which is not necessary yet).
		'
		'This way people don't have to click two times to
		'see the App's About dialog ("True" = Add to Action Bar).
		'
		Activity.AddMenuItem3("About", "mnuAbout", LoadBitmap(File.DirAssets, "About.png"), True)
		
	'Method for API 9 - 10 (Android 2.3.0 - 2.3.7)
	Else
		'Add a menu item for getting more info about this App.
		Activity.AddMenuItem("About", "mnuAbout")
	End If
	
	If FirstTime Then
		'
		'I need to initialize the native Java object context
		'It's for generating the unblock code (native Java code)
		'
		NativeMain.InitializeContext
		
		'Adding the ability to block Android from capturing
		'screenshots of this App because otherwise they leak
		'the Admin keys in Recent Apps thumbnails.
		'
#If JAVA
		//
		// Add FLAG_SECURE which prevents Android from taking
		// Recent App thumbnail screenshots of this activity,
		// otherwise the Admin keys can leak in thumbnail files.
		//
		// Side-effect: can't screenshot the App, but fortunately
		// I already did the screenshots a while ago anyway.
		//
		public void _onCreate() {
			//
			// Alternative to finishAndRemoveTask() for Android versions
			// lower than Android 5.0 (Android API level < 21)
			//
			// Thanks to:
			// https://stackoverflow.com/a/50745444
			//
			// Added extra verification to check if the
			// ExitApplication flag is actually set to true.
			//
			// intent.getBooleanExtra("<ExtraKeyName>", <default value if not found>)
			//
			Intent intent = getIntent();
			if ( intent.hasExtra("ExitApplication") && intent.getBooleanExtra("ExitApplication", false) )
			{
				// Check if device is SDK 16 or higher (Android 4.1+)
				//
				if ( android.os.Build.VERSION.SDK_INT >= 16 )
				{
					// Finish immediately
					finishAffinity(); // this instead of finish();
				}
				else
				{
					// Finish immediately
					finish();
				}
				
				// Close the App for real without any background process
				// remaining in the Android host process cache
				//
				// Thanks to:
				// https://stackoverflow.com/q/53494605
				// https://stackoverflow.com/a/53494692
				//
				System.exit(0); // return success
				return;
			}
			
			//
			// Disable the new Android 8.0+ Autofill service (API level 26+)
			//
			// This function automatically verifies if we have the correct
			// Android API level before trying to do it.
			//
			// Provide it with the Activity context.
			//
			
			// Check Android SDK version - Android 8.0+ (API level 26+)
			if ( android.os.Build.VERSION.SDK_INT >= 26 )
			{
				this.getWindow().getDecorView().setImportantForAutofill(View.IMPORTANT_FOR_AUTOFILL_NO_EXCLUDE_DESCENDANTS);
			}
			
			//
			// Hide the Title bar / Action bar on very-low DPI devices
			//
			// Thanks to:
			// * https://stackoverflow.com/a/4141627
			//
			//   For providing info about how to provide
			//   the current context to a Java native function.
			//
			if ( shared.getDeviceScale(this) < 1.0 ) // less than 1.0 (160dpi/mdpi)
			{
				// The device is 120/ldpi so we need more space.
				// that means we will want to remove the
				// Titlebar / Action bar.
				requestWindowFeature(Window.FEATURE_NO_TITLE);
				
				// Action bar for API 11+ (Android 3.0+)
				if ( android.os.Build.VERSION.SDK_INT >= 11 )
				{
					ActionBar actionBar = getActionBar();
					
					if ( actionBar != null )
					{
						actionBar.hide();
					}
				}
			}
			
			// Check if device is SDK 11 or higher (Android 3.0+)
			//
			// "FLAG_SECURE is a WindowManager flag introduced in
			//  Android 3.0 (Honeycomb) to prevent screenshots,
			//  screen recording, and viewing on non-secure displays.
			//
			//  It is implemented in an Activity's onCreate method
			//  to secure sensitive data. While it works for API 11+,
			//  it is not available or functional on Android 2.3.6"
			//
			if ( android.os.Build.VERSION.SDK_INT >= 11 )
			{
				// Added the ability for users who compile the App themselves
				// to choose whether they want a build configuration without
				// the FLAG_SECURE attribute used for the App's Activities.
				//
				// All pre-compiled builds on Github have it by default
				// set to False which means that FLAG_SECURE is always
				// used in the App's Activities, for security reasons.
				//
				// Please only disable FLAG_SECURE if you know what you're doing
				// and the potential risks of Admin key leaks by Android itself
				// in recent thumbnails and by screen capture applications.
				//
				if ( !shared.IsFlagSecureDisabled() )
				{
					// Add FLAG_SECURE to this Window (Activity view)
					this.getWindow().setFlags(LayoutParams.FLAG_SECURE, LayoutParams.FLAG_SECURE);
				}
			}
		}
		
		//
		// Reminder To let this function stay available incase
		// I decide To use finish() instead of finishAffinity()
		// in the _onCreate() function's ExitApplication check.
		//
		// onDestroy() cans actually fire even when the Activity
		// isn't being destroyed for good:
		//
		// "Permanent Termination (Finishing):
		//  The user dismisses the activity (e.g., by pressing the Back button).
		//  The code explicitly calls finish().
		//
		//  Temporary Destruction (Configuration Changes):
		//  The device rotates (landscape/portrait).
		//  The user enters multi-window mode.
		//
		//  The system kills the activity instance to save space,
		//  with plans to recreate it later."
		//
		public void _onDestroy() {
			//
			// Close the App For real without any background process
			// remaining in the Android host process cache
			//
			// Thanks To:
			// https://stackoverflow.com/q/53494605
			// https://stackoverflow.com/a/53494692
			//
			// Added a check to verify if the Activity
			// is actually finishing for real.
			//
			// Thanks to:
			// https://stackoverflow.com/a/5227142
			// https://old.reddit.com/r/androiddev/comments/m26vub/activityisfinishing_vs/
			//
			if ( isFinishing() == true )
			{
				// Check if device is SDK 11 or higher (Android 3.0+)
				//
				// "The isChangingConfigurations() method was introduced
				//  in API level 11 (Android 3.0 Honeycomb).
				//
				//  It is used within an Activity to check if the
				//  current activity instance is being destroyed
				//  because of a configuration change (like a screen rotation),
				//  which means it will be immediately recreated."
				//
				if ( android.os.Build.VERSION.SDK_INT >= 11 )
				{
					if ( !isChangingConfigurations() )
					{
						System.exit(0); // Return success
					}
				}
				else
				{
					// On Android < 3.0 we just rely on isFinishing()
					System.exit(0); // Return success
				}
			}
		}
#End If
		'Add hotfix to avoid hiding the Admin key on App's first Activity launch
		DontHideAdminKeyBecauseFirstActivityLaunch = True
		
		'Updated: I prefer showing the default 48-zeroes Admin Key
		'on App's first Activity start (it gets hidden on Activity resume anyway)
		'
		SetAdminKeyPasswordMode(False, False)
		
		'For showing the length of the text selection
		'for the Admin key field when needed.
		'
		'On App launch it's always first set to disabled
		'then it's initialized, in this order so that
		'it doesn't tick immediately when initializing it.
		'
		AdminKeyTextSelectionTimer.Enabled = False
		
		'The event function will be named:
		' * "AdminKeyTextSelectionTimer" + "_Tick"
		'
		'So it will be AdminKeyTextSelectionTimer_Tick
		'
		AdminKeyTextSelectionTimer.Initialize("AdminKeyTextSelectionTimer", 200) '200ms
		
	Else
		'
		'Add hotfix to avoid hiding the Admin key on App's first Activity launch
		'set the global variable to False if it's not the first time that
		'the activity is launched
		'
		DontHideAdminKeyBecauseFirstActivityLaunch = False
		
	End If
	
	'
	'Hide the fullscreen keyboard in this Activity's EditTexts.
	'Must be done after NativeMe.InitializeContext
	'
	NativeMain.RunMethod("disableFullscreenKeyboard", Array(inpAdminKey))
	NativeMain.RunMethod("disableFullscreenKeyboard", Array(inpChallenge))
	NativeMain.RunMethod("disableFullscreenKeyboard", Array(inpResponse))
	
	'
	' Disable the Android annoyances that are:
	' - Autocomplete
	' - Autosuggestions
	' - Autocorrect
	' - Dictionary word learning
	'
	' Must be done after NativeMe.InitializeContext
	'
	' Even disable auto-correct too because it's annoying and
	' cans potentially cause the user To generate wrong hashes
	' If their original text gets auto-corrected by Android.
	'
	' This function automatically checks if the Android version
	' is high enough to have the personalized learning annoyance,
	' and makes it disabled it if it does have it.
	'
	NativeMain.RunMethod("disableTextFieldAnnoyances", Array(inpAdminKey))
	NativeMain.RunMethod("disableTextFieldAnnoyances", Array(inpChallenge))
	NativeMain.RunMethod("disableTextFieldAnnoyances", Array(inpResponse))
	
	'
	' Add a fix for Android's flawed monospace font system.
	'
	' Thanks to:
	' https://dev.to/maximsaplin/androids-monospace-font-is-not-monospace-151j
	'
	NativeMain.RunMethod("forceCorrectMonospaceFont", Array(inpAdminKey))
	
	'
	' Fixing Android's flawed monospace implementation for digits.
	' Also known As 'enabling tabular numbers' in monospace fonts.
	'
	NativeMain.RunMethod("fixMonospaceDigitsFont", Array(inpAdminKey))
	
	'Show the length of the Admin key
	DisplayAdminKeyLength
	
	'Tweak the padding of the Hash menu button background (btnHashMenuBg)
	'
	'We use the Challenge code label as alignment base because
	'it's the first and top-most element of this Activity's layout.
	'
	btnHashMenuBg.Padding = Array As Int( lblChallenge.Left, _ ' Left   = [0]
	                                      lblChallenge.Top,  _ ' Top    = [1]
	                                      lblChallenge.Left, _ ' Right  = [2]
	                                      lblChallenge.Top   _ ' Bottom = [3]
										)
	
	If SDK_INT < 14 Then
		
		'Fix the white-on-white text color of the Hash Text button when
		'running on legacy devices with the original Android 2.x-3.x theme.
		'
		btnHashMenu.TextColor = Colors.Black
		
	End If
	
	' Make sure that the PasswordMode is properly set
	' to have a 'visible password' mode if needed,
	' rather than a 'normal text' mode (privacy benefits).
	'
	' This if for having it done atleast once initially
	' when the App is started.
	'
	' I can do it here because on the first Activity_Create,
	' SetAdminKeyPasswordMode always runs atleast once in the end.
	'
	If	Not(SavedHideAdminKeyStateBeforeConfigurationChange) Or _
		WasHideAdminKeyCheckboxCheckedFlag                      _
	Then
		'
		' If Admin Key was unrevealable or the Hide checkbox was checked.
		'
		SetAdminKeyPasswordMode(True, False)
		
	Else
		'
		' If the Admin Key was not hidden or unrevealable (ie. not locked down)
		'
		SetAdminKeyPasswordMode(False, False)
		
	End If
	
	'
	'After completing the Activity_Create tasks,
	'if it's the first time it's run then
	'focus on the Challenge code field.
	'
	If FirstTime Then
		inpChallenge.RequestFocus
	End If
	
End Sub

Sub Activity_Pause (UserClosed As Boolean)
	'
	'New nifty feature to hide the Admin Key automatically when switching to another app
	'
	'Useful incase user accidentally exposes it when launching the App and it resumes
	'instead of relaunching from scratch (background task)
	'
	
	'
	'Save cursor position and selection length.
	'
	SaveAdminKeyCursorPosAndSel
	
	'Always hide the Admin Key field when switching to another app (if not empty).
	'However no need to hide it if the field was empty anyway.
	If inpAdminKey.Text <> "" Then
		
		' Lie about the change coming from the Hide Admin Key checkbox,
		' otherwise this function will recurse two times and lose the
		' original cursor position and selection length information
		' on App pause event.
		'
		' This is so that we don't fire the checkbox's CheckedChange event.
		'
		SetAdminKeyPasswordMode(True, True)
		
	End If
	
	'
	'When the device screen orientation rotates while the App is running,
	'the App's Activity gets:
	' - Paused (UserClosed = False)
	' - Created
	' - Resumed
	'
	'So I need to make sure that the Admin Key field stays the same
	'even when you rotate the device screen's orientation.
	'
	If Not(UserClosed) Then
		'
		'Save Admin Key so that I restore it after
		'the device configuration changed (e.g. screen rotation).
		'
		SavedAdminKeyBeforeConfigurationChange  = inpAdminKey.Text
		
		'Also make sure the Response code field doesn't get
		'reset to empty value when e.g. the device rotates too.
		SavedResponseBeforeConfigurationChange  = inpResponse.Text
		
		'Also make sure the Challenge code field doesn't get
		'reset to empty value when e.g. the device rotates too.
		SavedChallengeBeforeConfigurationChange = inpChallenge.Text
		
	Else
		'
		'Now trying to securely erase the values first before emptying them.
		'
		'If it's user-closed then no need to save the Admin Key,
		'just erase the SavedAdminKeyBeforeConfigurationChange variable.
		'
		SavedAdminKeyBeforeConfigurationChange  = ERASE_ADMIN_KEY_STRING_VALUE
		
		'Erasing the SavedChallengeBeforeConfigurationChange variable too.
		SavedChallengeBeforeConfigurationChange = ERASE_CHALLENGE_RESPONSE_STRING_VALUE
		
		'Erasing the SavedResponseBeforeConfigurationChange variable too.
		SavedResponseBeforeConfigurationChange  = ERASE_CHALLENGE_RESPONSE_STRING_VALUE
		
	End If
	
	'When the device rotates, a disabled hide Admin Key checkbox
	'becomes enabled again; so we have to check for whether
	'the 'Hide Admin Key' checkbox was disabled before,
	'and if yes we disable it again.
	'
	'Note: I want to do this one always, not just when UserClosed is false.
	'
	If SavedHideAdminKeyStateBeforeConfigurationChange == True Then
		'
		'If the state was Disabled, it stays disabled (only change if True).
		'This is incase some hacks are used to force-enable the App UI buttons.
		'
		SavedHideAdminKeyStateBeforeConfigurationChange = chkHideAdminKey.Enabled
		
	End If
	
	'Save the response label text as it was instead of
	're-computing the response algorithm detection.
	SavedResponseLabelBeforeConfigurationChange = lblResponse.Text
	
	'Disable the Admin key text selection update timer
	'always when the Activity is paused.
	'
	AdminKeyTextSelectionTimer.Enabled = False
	
End Sub

Sub Activity_Resume
	'
	' Hotfix for the App not being able to properly exit
	' on the first back button press in the Main module,
	' after having successfully scanned a QR code.
	'
	If HotfixForOldDevicesExitAppFlag == True Then
		For i = 0x00000001 To 0x7FFFFFFE
			'
			' So a Do While True / ExitApplication / Loop
			' won't work?
			'
			' Well so you bet this one method will work!
			'
			ExitApplication()	' Use ExitApplication here
								' to truly close the App.
		Next
	End If
	
	'When the device rotates, a disabled hide Admin Key checkbox
	'becomes enabled again; so we have to check for whether
	'the 'Hide Admin Key' checkbox was disabled before,
	'and if yes we disable it again.
	'
	'Note: I want to do this one very firstly before others.
	'
	If Not(SavedHideAdminKeyStateBeforeConfigurationChange) Then
		'
		'Special handling for the 'Hide Admin Key' checkbox:
		'
		
		'Restore the disabled Hide Admin Key checkbox state.
		LockAdminKeyOnPasswordMode
		
		'Restore the PasswordMode on the Admin Key input field
		'because it could otherwise potentially not get
		'restored automatically.
		'
		'Restores the checked Hide Admin Key checkbox state too.
		'
		'Lie about it coming from the Hide Admin Key checkbox
		'so that we don't recurse two times into firing the
		'same events, which would cause loss of saved
		'cursor position & selection length information.
		'
		'The Hide Admin Key checkbox state will be restored later.
		'
		SetAdminKeyPasswordMode(True, True)
		
		'
		'I don't reset the SavedHideAdminKeyStateBeforeConfigurationChange
		'variable (I keep its status as-is).
		'
	End If
	
	'
	'When the device screen orientation rotates while the App is running,
	'the App's Activity gets:
	' - Paused (UserClosed = False)
	' - Created
	' - Resumed
	'
	'So I need to make sure that the Admin Key field stays the same
	'even when you rotate the device screen's orientation.
	'
	'Note: It has to be done before checking for CHALLENGE_CODE or
	'      it will not allow restoring the Admin Key field when
	'      the user rotates the device after scanning a QR code.
	'
	'      That's because it has a Return statement that would
	'      prevent this code from being reached if I placed it
	'      after the CHALLENGE_CODE intent verification.
	'
	If SavedAdminKeyBeforeConfigurationChange <> ERASE_ADMIN_KEY_STRING_VALUE Then
		
		'Hide the Admin key field if the saved Admin key wasn't empty.
		'However no need to hide it if the field was empty anyway.
		'
		'It might also have been hidden anyway if the checkbox was
		'disabled by an unrevealable Hash menu function prior.
		'
		If SavedAdminKeyBeforeConfigurationChange <> "" Then
			
			'Lie about it coming from the Hide Admin Key checkbox
			'so that we don't recurse two times into firing the
			'same events, which would cause loss of saved
			'cursor position & selection length information.
			'
			'The Hide Admin Key checkbox state will be restored later.
			'
			SetAdminKeyPasswordMode(True, True)
			
		End If
		
		'Restore the Admin Key as it was before 
		'the device configuration changed (e.g. screen rotation).
		inpAdminKey.Text = SavedAdminKeyBeforeConfigurationChange
		
		'Now clear the SavedAdminKeyBeforeConfigurationChange variable.
		SavedAdminKeyBeforeConfigurationChange = ERASE_ADMIN_KEY_STRING_VALUE
		
	End If
	
	'Restore the previous Hide Admin Key checkbox checked value
	'only if the current security state allows it:
	'
	'Admin Key not empty / disabled checkbox = must not re-enable or uncheck.
	'
	If SavedHideAdminKeyStateBeforeConfigurationChange == True Then
		'
		'If the checkbox was checked.
		'
		'On first Activity launch it will always be False anyway,
		'so no need to check for DontHideAdminKeyBecauseFirstActivityLaunch.
		'
		If WasHideAdminKeyCheckboxCheckedFlag Then
			'
			'Hide the Admin key field even if empty because the user wanted to anyway.
			'
			'Lie about it coming from the Hide Admin Key checkbox
			'so that we don't recurse two times into firing the
			'same events, which would cause loss of saved
			'cursor position & selection length information.
			'
			'The Hide Admin Key checkbox state will be restored later.
			'
			SetAdminKeyPasswordMode(True, True)
			
		Else
			'
			'Verify that the Admin key is empty.
			'Must not reveal the Admin key field if not empty.
			'
			If inpAdminKey.Text == "" Then
				'
				'Lie about it coming from the Hide Admin Key checkbox
				'so that we don't recurse two times into firing the
				'same events, which would cause loss of saved
				'cursor position & selection length information.
				'
				'The Hide Admin Key checkbox state will be restored later.
				'
				SetAdminKeyPasswordMode(False, True)
				
			Else
				'
				'Verify that it's not the first Activity launch
				'
				'The method is to check DontHideAdminKeyBecauseFirstActivityLaunch
				'because we still have access to it before it gets set to False
				'at the end of Activity_Resume.
				'
				If Not(DontHideAdminKeyBecauseFirstActivityLaunch) Then
					'
					'The key wasn't empty so we're hiding it anyway,
					'even though the checkbox was unchecked.
					'
					'It's only exceptionally when running the App and
					'the Activity is at its first lifecycle start (FirstStart)
					'that we don't forcibly hide the Admin key on Activity resume.
					'
					'Lie about it coming from the Hide Admin Key checkbox
					'so that we don't recurse two times into firing the
					'same events, which would cause loss of saved
					'cursor position & selection length information.
					'
					'The Hide Admin Key checkbox state will be restored later.
					'
					SetAdminKeyPasswordMode(True, True)
					
				End If
			End If
		End If
	Else
		'
		'No need to harden it because it was already taken care of
		'by the first Activity_Resume code part.
		'
	End If
	
	'Also make sure the Response code field doesn't get
	'reset to empty value when e.g. the device rotates too.
	If SavedResponseBeforeConfigurationChange <> ERASE_CHALLENGE_RESPONSE_STRING_VALUE Then
		
		'Restore the Response code as it was before
		'the device configuration changed (e.g. screen rotation).
		inpResponse.Text = SavedResponseBeforeConfigurationChange
		
		'Now clear the SavedResponseBeforeConfigurationChange variable.
		SavedResponseBeforeConfigurationChange = ERASE_CHALLENGE_RESPONSE_STRING_VALUE
		
	End If
	
	'Also make sure the Challenge code field doesn't get
	'reset to empty value when e.g. the device rotates too.
	If SavedChallengeBeforeConfigurationChange <> ERASE_CHALLENGE_RESPONSE_STRING_VALUE Then
		
		'Restore the Challenge code as it was before
		'the device configuration changed (e.g. screen rotation).
		inpChallenge.Text = SavedChallengeBeforeConfigurationChange
		
		'Now clear the SavedChallengeBeforeConfigurationChange variable.
		SavedChallengeBeforeConfigurationChange = ERASE_CHALLENGE_RESPONSE_STRING_VALUE
		
	End If
	
	'Restore the response label text as it was instead of
	're-computing the response algorithm detection.
	'
	'I don't reset the SavedResponseLabelBeforeConfigurationChange
	'variable (I keep its status as-is).
	'
	lblResponse.Text = SavedResponseLabelBeforeConfigurationChange
	
	'Re-enable the Admin key text selection update timer
	'when the Activity is resumed, but only if
	'the Admin key field was focused at the time
	'the Activity was paused
	'
	If WasAdminKeyFieldFocused Then
		'
		'Just incase some Android ROMs somehow don't restore
		'the focus state, mine does but perhaps not all do.
		'
		inpAdminKey.RequestFocus
		'
		'Restore the cursor position & text selection
		'which works in all app pause/resume cases.
		'
		RestoreAdminKeyCursorPosAndSel
		
		AdminKeyTextSelectionTimer.Enabled = True
		
	Else
		'No need to explicitly disable the timer if
		'the Admin key field wasn't focused at the time
		'the Activity was paused, because it was already
		'paused always on Activity pause events.
		'
	End If
	
	'
	'Now we manually fire the Hide Admin Key checkbox's
	'CheckedChange event Sub after having restored the
	'correct saved cursor position and selection length info.
	'
	'Hotfix for cases where after successfully scanning a QR code
	'the Hide Admin Key checkbox didn't get visually re-checked
	'again even though the Admin Key was correctly hidden (non-empty).
	'
	chkHideAdminKey.Checked = WasHideAdminKeyCheckboxCheckedFlag
	
	'
	'Add ability to receive Admin Key with Android's Share To
	'
	Dim receivedIntent As Intent = Activity.GetStartingIntent
	
	'
	'Add support for receiving the scanned Challenge Code to Main layout
	'
	If  receivedIntent.Action == receivedIntent.ACTION_SEND            _
	And receivedIntent.HasExtra("android.intent.extra.CHALLENGE_CODE") _
	And SharingQRCodeChallengeIntentAllowed Then
		'
		'Allow only this App to send Share To containing challenge codes
		'so that when the user scans a QR code containing a challenge code,
		'they don't get it put back again by Android in the Challenge code field
		'whenever they switch to another app then go back to this one using
		'the Recent Apps panel.
		'
		'False by default, but it will be set to True by
		'the Scan module's qrReaderView_result_found function.
		'
		'After the Challenge QR code result is shared, then
		'this code will disables it again by setting it back to False.
		'
		SharingQRCodeChallengeIntentAllowed = False
		
		inpChallenge.Text = receivedIntent.GetExtra("android.intent.extra.CHALLENGE_CODE")
		Return
	End If
	
	'
	'When sharing an Admin key to the app, Admin keys are always
	'hidden by default anyway so no need for honoring the global
	'variable named DontHideAdminKeyBecauseFirstActivityLaunch,
	'even on the first Share To activity lanch.
	'
	If  receivedIntent.Action == receivedIntent.ACTION_SEND  _
	And receivedIntent.HasExtra("android.intent.extra.TEXT") _
	And Not(AdminKeyAlreadySharedOnce) Then
		
		'Hide the Admin Key by default
		SetAdminKeyPasswordMode(True, False)
		
		'Get the received Admin Key text and remove all invalid hex chars and newlines
		Dim receivedText As String = receivedIntent.GetExtra("android.intent.extra.TEXT")
		
		'
		'Admin Keys can be 64-digits, 48-digits or 32-digits (hex string)
		'
		' 64 = AES-256
		' 48 = 3DES (DES-EDE3)
		' 32 = AES-128 / 2DES (DES-EDE2)
		'
		' Thanks to:
		' https://www.b4x.com/android/forum/threads/mod-operator.19316/
		'
		If  receivedText <> "" And receivedText.Length >= 32 _
		And receivedText.Length Mod 2 == 0 _
		And Regex.IsMatch2("^[0-9a-f]+$", Regex.CASE_INSENSITIVE, receivedText) == True Then
			'
			'Here we're sure that we atleast have a valid AES-128 / 2DES Admin Key
			'
			
			'
			'I now let the user share a full hash without trimming it,
			'since some users actually use the last part of a SHA512 hash
			'as their Admin key instead of the first part.
			'
			
			'If receivedText.Length > 64 Then
			'	receivedText = receivedText.SubString2(0, 64)
			'End If
			
			'Set the Admin Key text with the received & sanitized data
			inpAdminKey.Text = receivedText
			
		Else
			'
			'If no valid Admin Key was received
			'
			
			'
			'Set the Admin Key text to empty string (not the default 48-zeroes ADmin Key)
			'
			'It must be emptied or the user might believe that it's the correct one behind the asterisks
			'If the user believes that it's his Admin Key, he might accidentally block his card
			'
			inpAdminKey.Text = ""
			
			'No need to set password-mode by default if the Admin Key is empty
			SetAdminKeyPasswordMode(False, False)
			
			'Explain error to the user in a toast (better than modifying textfield hints)
			ToastMessageShow("Shared Admin Key is invalid", False)
			
		End If
		
		'Clear the contents of the receivedText variable once it's
		'no longer needed for the next part of the App lifecycle.
		receivedText = ERASE_ADMIN_KEY_STRING_VALUE
		
		'Show the length of the Admin key
		DisplayAdminKeyLength
		
		'Now the Admin Key will no longer be unhideable if valid (not empty)
		'Useful to prevent accidentally leaking Admin Keys
		
		If inpAdminKey.Text <> "" Then
			
			LockAdminKeyOnPasswordMode
			
		Else
			'
			'If you Long-Click one of the Hash buttons then go back
			'to this app in the Recents panel, after having shared
			'an invalid Admin key first, then the 'Hide Admin Key'
			'checkbox will not be automatically re-enabled.
			'
			' So we have to do it here explicitly (fixes minor UI glitch).
			'
			chkHideAdminKey.Enabled = True
			
		End If
		
		'Once an Admin key has already been shared to the App via Share To,
		'we should disclose that it has already been shared once.
		'
		'Use-case: Sharing invalid Admin key, generating a new proper one,
		'then you press the Home button.
		'
		'Now when you go back to the App, your Admin key is cleared because
		'Android re-shared the Admin key on Activity resume to the App.
		'
		'This fixes the mentioned behavior and is easy to implement.
		AdminKeyAlreadySharedOnce = True
		
	Else
		'
		'Don't intercept non-Share To activity resumes, otherwise it wreaks havoc
		'on every Home button press followed by relaunching the App from the Recent Apps panel
		'
		
		'
		'One small exception is for hiding the Admin Key
		'
		
		'Hide the Admin Key when switching back to this App from another one
		'
		'With added Hotfix for letting the Admin key be shown at the first
		'App's Activity launch (Activity create with FirstTime flag set to True)
		If inpAdminKey.Text <> "" And Not(DontHideAdminKeyBecauseFirstActivityLaunch) Then
			
			SetAdminKeyPasswordMode(True, False)
			
		Else
			'Clear the global variable 'DontHideAdminKeyBecauseFirstActivityLaunch'
			'once it has already been used once by setting it to False,
			'so that it will no longer be used again (cannot be used more than once)
			DontHideAdminKeyBecauseFirstActivityLaunch = False
		End If
	End If
	
	'
	'Request running the garbage collector as soon as possible.
	'This way old values will be soon cleared from the App's RAM space.
	'
	'I do it at the end of this function so that if an Admin key was
	'shared to the App, then it will also benefit from having the
	'receivedText variable cleared by the Garbage Collector shortly after.
	'
	NativeMain.RunMethod("overwriteTriggerGarbageCollector", Null)
	
	'Always return a correct ActivityResult
	Activity.SetActivityResult(0, receivedIntent)
	
End Sub

Sub Activity_KeyPress(KeyCode As Int) As Boolean
	
	Select Case KeyCode
		Case KeyCodes.KEYCODE_BACK
			
			'Add special case for handling Back keypress while the Hash menu
			'is shown to avoid unexpected App exits
			If btnHashMenuBg.Visible == True Then
				btnHashMenuBg_Click
				
				'Returning True consumes the event (preventDefault)
				Return True
			End If
			
			'Immediately hide the Admin key if any was shown before
			'exiting the App, to avoid leaking the Admin key inside
			'the Recent Apps thumbnail.
			QuicklyHideAdminKey
			
			'
			'Now trying to securely erase the values first before emptying them.
			'
			'This function will already trigger the garbage collector.
			'No need to manually call it after running this function.
			'
			TryToSecureEraseSensitiveValuesFromRAM
			
			'Exit the application directly when back key is pressed
			'This prevents the app from running in the background
			'
			'ExitApplication() 'Closes the process so no background Activity
			
			'Try using a better method to exit the App rather than using
			'the Activity.Finish() or ExitApplication() functions.
			'
			
			'Disable the  showing the Admin key length selection timer
			'on Application exit.
			'
			AdminKeyTextSelectionTimer.Enabled = False
			
			'Method for API 21+ (Android 5.0+)
			If SDK_INT >= 21 Then
				NativeMain.RunMethod("finishAndRemoveTaskForNewerAndroid", Null)
				
			'Method for API 16 - 19 (Android 4.1 - 4.4)
			Else If SDK_INT >= 16 Then
				'NativeMe.RunMethod("finishAffinity", Null)
				
				'Trying a better method that replicates this function
				'for Android phones older than Android 5.0
				NativeMain.RunMethod("finishAndRemoveTaskForOlderAndroid", Null)
				
			'Method for API 11 - 15 (Android 3.0 - 4.0.3)
			Else If SDK_INT >= 11 Then
				
				'Trying a better method that replicates this function
				'for Android phones older than Android 5.0
				NativeMain.RunMethod("finishAndRemoveTaskForOlderAndroid", Null)
				
			'Method for API 9 - 10 (Android 2.3.0 - 2.3.7)
			Else
				'
				' Hotfix for the App not being able to properly exit
				' on the first back button press in the Main module,
				' after having successfully scanned a QR code.
				'
				HotfixForOldDevicesExitAppFlag = True
				
				For i = 0x00000001 To 0x7FFFFFFE
					'
					' So a Do While True / ExitApplication / Loop
					' won't work?
					'
					' Well so you bet this one method will work!
					'
					Exit	' Use Exit here because we want the App
							' to be able to try somehow re-running
							' its launch Activity again, then it's
							' exactly where we will terminate the App
							' for real using ExitApplication instead.
				Next
				
			End If
			
			'Consume the event (return True)
			Return True
			
		'Add special cases for quickly hiding the Admin key when
		'the user locks the phone or switches to another app,
		'as well as opening the Recent Apps panel / menu
		
		'Some constant values were missing so I added them
		'directly inside the App myself (missing from Basic4Android).
		'
		Case KeyCodes.KEYCODE_HOME, KEYCODE_LOCK, KEYCODE_RECENT_APPS
			
			'Immediately hide the Admin key if any was shown before
			'switching to other Apps, to avoid leaking the Admin key
			'inside the Recent Apps thumbnail.
			QuicklyHideAdminKey
			
			'Now we let Android do its job by not consuming
			'the event (return False)
			Return False
			
		' All other non-intercepted keys below
		Case Else
			Return False
	End Select
	
End Sub

'
'Helper code
'

Private Sub TryToSecureEraseSensitiveValuesFromRAM As Void
	'
	'Now trying to securely erase the values first before emptying them.
	'
	NativeMain.RunMethod("overwriteAdminKeyContent",            Array(inpAdminKey))
	SavedAdminKeyBeforeConfigurationChange  = ERASE_ADMIN_KEY_STRING_VALUE
	
	NativeMain.RunMethod("overwriteChallengeOrResponseContent", Array(inpResponse))
	SavedResponseBeforeConfigurationChange  = ERASE_CHALLENGE_RESPONSE_STRING_VALUE
	
	NativeMain.RunMethod("overwriteChallengeOrResponseContent", Array(inpChallenge))
	SavedChallengeBeforeConfigurationChange = ERASE_CHALLENGE_RESPONSE_STRING_VALUE
	
	'
	'Request running the garbage collector as soon as possible.
	'This way old values will be soon cleared from the App's RAM space.
	'
	NativeMain.RunMethod("overwriteTriggerGarbageCollector", Null)
	
	'
	'Follow-up with a normal erase of the EditText values
	'before the Main module's Activity gets re-created.
	'
	inpAdminKey.Text  = ""
	inpResponse.Text  = ""
	inpChallenge.Text = ""
	
End Sub

Private Sub QuicklyHideAdminKey() As Void
	'
	'Immediately hide the Admin key if any was shown before,
	'to avoid leaking the Admin key inside the Recent Apps thumbnails.
	'
	If inpAdminKey.Text <> "" Then
		
		SetAdminKeyPasswordMode(True, False)
		
	End If
	
End Sub

'
' New helper function to centrally to the current cursor
' position and selection backup when toggling
' PasswordMode visibility for the Admin Key field.
'
Private Sub SetAdminKeyPasswordMode(State As Boolean, FromCheckbox As Boolean) As Void
	'
	' Note: Don't do the cursor position & selection saving inside
	'       this function, because many internal parts of the App
	'       also call this function.
	'
	'       Always separately do the backup & restore of the cursor
	'       position & selection where appropriate.
	'
	
	'inpAdminKey.PasswordMode = State
	
	'
	' Make sure that the PasswordMode is properly set
	' to have a 'visible password' mode if needed,
	' rather than a 'normal text' mode (privacy benefits).
	'
	' So it's either hidden password or visible password,
	' but always atleast a password bitmask (not normal text).
	'
	' The last True value = MultiLine-enabled mode for it.
	'
	NativeMain.RunMethod("setEditTextPasswordModeHelper", Array(inpAdminKey, State))
	
	'
	' Because Android's EditText bitmask system is stubborn
	' I have to re-call these functions again on every
	' EditText field PasswordMode change.
	'
	NativeMain.RunMethod("forceCorrectMonospaceFont", Array(inpAdminKey))
	NativeMain.RunMethod("fixMonospaceDigitsFont", Array(inpAdminKey))
	
	' Don't do a redundant call to set the Admin Key checkbox
	' if the event (function call) comes from the checkbox already.
	'
	If Not(FromCheckbox) Then
		chkHideAdminKey.Checked = State
	End If
	
	'And we properly register the checkbox checked flag too.
	WasHideAdminKeyCheckboxCheckedFlag = State
	
End Sub

'
' Centrally handling the Admin Key lockdown too.
' Cans only be True value for PasswordMode here.
'
' This function doesn't automatically hide the Admin key,
' it only disables the Hide Admin Key checkbox.
'
' The Admin Key hiding is done separately right after
' calling this function.
'
Private Sub LockAdminKeyOnPasswordMode() As Void
	'
	'Hardening against potential force-enable UI control hacks.
	'
	SavedHideAdminKeyStateBeforeConfigurationChange = False
	chkHideAdminKey.Enabled = False
	
End Sub

'
' Backup the cursor position & text selection when
' toggling PasswordMode visibility.
'
Private Sub SaveAdminKeyCursorPosAndSel() As Void
	
	SavedAdminKeySelectionStartBeforeConfigurationChange  = inpAdminKey.SelectionStart
	SavedAdminKeySelectionLengthBeforeConfigurationChange = inpAdminKey.SelectionLength
	
End Sub

'
' Restore the cursor position & text selection when
' toggling PasswordMode visibility.
'
Private Sub RestoreAdminKeyCursorPosAndSel() As Void
	
	'
	' Separated for better readability
	'
	Dim SelectionStart, SelectionLength As Int
	SelectionStart	= SavedAdminKeySelectionStartBeforeConfigurationChange
	SelectionLength	= SavedAdminKeySelectionLengthBeforeConfigurationChange
	
	inpAdminKey.SetSelection(SelectionStart, SelectionLength)
	
End Sub

Private Sub DisplayAdminKeyLength() As Void
	'
	' Modified to also display the length of the
	' character selection when applicable.
	'
	Dim TextLength, SelectionLength, SelectionStart As Int
	
	TextLength		= inpAdminKey.Text.Length
	SelectionLength	= inpAdminKey.SelectionLength
	SelectionStart	= inpAdminKey.SelectionStart
	
	'
	'If the text length is zero, then logically it's
	'impossible anyway for the selection length to be
	'greater than zero, since there's no text to select.
	'
	
	'Because I added the ability to know the cursor position
	'for the Admin key field, I need to update the Admin key
	'label when the Admin key EditText loses focus.
	'
	'Do not remove this "And WasAdminKeyFieldFocused" part.
	'
	If	TextLength >= 1 And SelectionLength < 1 And WasAdminKeyFieldFocused And _
		SelectionStart > 0 And SelectionStart < TextLength Then
		'
		'Added a bonus to know at which character position we are
		'if the user doesn't select text and only points the cursor
		'to a specific part of the Admin key field's text.
		'
		
		'
		'Added a check to see if the cursor position is zero.
		'If it's zero then no need to show it anyway.
		'zero (0) = cursor before the first character.
		'
		
		'
		'Also added a check to see if the cursor position is
		'at the end of the text, in which case we don't need
		'to show the cursor position either.
		'
		'That's because it would be the same number as the
		'text length, so it would be redundant to show it
		'in this case.
		'
		
		lblAdminKey.Text = "Admin Key: ("&TextLength&" chars) - Pos: "&SelectionStart
		
	Else If	TextLength >= 1 And SelectionLength >= 1 And WasAdminKeyFieldFocused _
		And SelectionStart > 0 Then
		'
		'The user does need to know the cursor position too,
		'not just the selection length if they're selecting
		'texts in the middle of the Admin key string (for example).
		'
		lblAdminKey.Text = "Admin Key: ("&TextLength&" chars) - Pos: "&SelectionStart&" | Sel: "&SelectionLength
		
	Else If TextLength >= 1 And SelectionLength >= 1 And WasAdminKeyFieldFocused _
		And SelectionStart == 0 And SelectionLength < TextLength Then
		'
		'No need to show the cursor position if it's zero because
		'the user obviously knows this.
		'
		'The user also doesn't need to know the number of chars
		'after the selection end if they select all the text.
		'
		lblAdminKey.Text = "Admin Key: ("&TextLength&" chars) - Sel: "&SelectionLength&" | After: "&(TextLength-(SelectionStart+SelectionLength))
		
	Else If TextLength >= 1 And SelectionLength >= 1 And WasAdminKeyFieldFocused _
		And SelectionStart == 0 Then
		'
		'No need to show the cursor position if it's zero because
		'the user obviously knows this.
		'
		'The user also doesn't need to know the number of chars
		'after the selection end if they select all the text.
		'
		lblAdminKey.Text = "Admin Key: ("&TextLength&" chars) - Sel: "&SelectionLength
		
	Else If TextLength >= 1 Then
		'
		'When the Admin key field isn't focused, selection length
		'and the cursor position should not be shown.
		'
		lblAdminKey.Text = "Admin Key: ("&TextLength&" chars)"
		
	Else
		lblAdminKey.Text = "Admin Key:"
		
	End If
	
End Sub

'
'Inputs should already be provided sanitized here.
'
Private Sub DetectResponseCodeAlgorithmType(sanitizedAdminKey As String, sanitizedChallenge As String, sanitizedResponseCode As String) As Void
	
	'
	'Reset the Response Code label before generating a new Response Code
	'
	lblResponse.Text = "Response:"
	
	'
	'Add the ability to know which algorithm was detected
	'and used to generate the Response code by modifying
	'the 'Response:' label to contain the detected algorithm.
	'
	Dim detectedChallengeResponseAlgorithm As String = ""
	
	'Notice how we had a leading space because it will be appended
	'to the 'Response:' label later.
	'
	'I also verify the Response code length too as extra precaution.
	'
	If	sanitizedAdminKey.Length		== 48 And _
		sanitizedChallenge.Length		== 16 And _
		sanitizedResponseCode.Length	== 16 Then
		
		detectedChallengeResponseAlgorithm = " 3DES (DES-EDE3)"
		
	Else If	sanitizedAdminKey.Length		== 32 And _
			sanitizedChallenge.Length		== 16 And _
			sanitizedResponseCode.Length	== 16 Then
		
		detectedChallengeResponseAlgorithm = " 2DES (DES-EDE2)"
		
	Else If	sanitizedAdminKey.Length		== 32 And _
			sanitizedChallenge.Length		== 32 And _
			sanitizedResponseCode.Length	== 32 Then
		
		detectedChallengeResponseAlgorithm = " AES (AES-128)"
		
	Else If	sanitizedAdminKey.Length		== 64 And _
			sanitizedChallenge.Length		== 64 And _
			sanitizedResponseCode.Length	== 64 Then
		
		detectedChallengeResponseAlgorithm = " AES (AES-256)"
		
	End If
	
	lblResponse.Text = lblResponse.Text&detectedChallengeResponseAlgorithm
	
End Sub

'
' String Array  = ReturnValue(0) = (Boolean) isValidInput
'                 ReturnValue(1) = (String)  sanitizedChallenge (if valid input)
'                 ReturnValue(2) = (String)  sanitizedAdminKey  (if valid input)
'
Private Sub GetSanitizedUserInput(challengeCode As String, adminKey As String) As String()
	'
	' Not using RegEx here since I don't want users to send invalid chars in the first place
	' So I don't accept the input at all if there are invalid chars, instead of cleaning them
	'
	Dim sanitizedChallenge	As String = challengeCode.Replace(" ", "").Replace("-", "")
	Dim sanitizedAdminKey	As String = adminKey     .Replace(" ", "").Replace("-", "")
	
	' The Admin Key field supports line breaks, so we should also automatically trim them
	sanitizedAdminKey = sanitizedAdminKey.Replace(CRLF, "")
	
	' Allow 32 chars up to 64 chars for Admin Keys
	'
	' Some cards have AES-128 Admin Keys, e.g. Crescendo Key or Crescendo C2300
	' However some other HID Global cards have AES-256 Admin Keys (OTP devices)
	'
	' Finally some very old cards even have DES-EDE2 (2DES) Admin Keys,
	' such as the SAGEM ypsID S2 card (which you probably shouldn't use anymore).
	'
	' If using AES-128 Admin Keys then the challenge code will be 32 chars.
	' If using AES-256 Admin Keys then the challenge code will be 64 chars.
	'
	' This code will also detect empty strings too.
	'
	If Regex.IsMatch2("^[0-9a-f]{16,64}$", Regex.CASE_INSENSITIVE, sanitizedChallenge)	== False _
	Or Regex.IsMatch2("^[0-9a-f]{32,64}$", Regex.CASE_INSENSITIVE, sanitizedAdminKey)	== False Then
		'
		'In the case where the inputs were incorrect anyway.
		'
		Return Array As String(False, "", "")
		
	End If
	
	'If values are correct
	Return Array As String(True, sanitizedChallenge, sanitizedAdminKey)
	
End Sub

'
'UI event handlers
'

'New About menu item for this App's Activity.
Private Sub mnuAbout_Click
	'
	'Renamed the Positive button from 'Homepage' to 'Github Homepage'
	'This way the user clearly knows in advance that it's a
	'Github link that will open when he clicks on this button.
	'
	
	'Get better-adapted About icons according to
	' screen DPI & scale.
	Dim DeviceScale As Float = GetDeviceLayoutValues.Scale
	
	'About icon is not resized by default (256x256)
	Dim AboutIcon As Bitmap = Application.Icon
	
	'If the device scale is 0.75 (120dpi/ldpi) etc
	If DeviceScale < 1.0 Then
		AboutIcon = AboutIcon.Resize(36, 36, True) 'or 32x32
	'If the device scale is 1.0 (160dpi/mdpi) etc
	Else If DeviceScale < 1.5 Then
		AboutIcon = AboutIcon.Resize(48, 48, True)
	'If the device scale is 1.5 (240dpi/hdpi) etc
	Else If DeviceScale < 2.0 Then
		AboutIcon = AboutIcon.Resize(72, 72, True) 'or 64x64
	'If the device scale is 2.0 (320dpi/xhdpi) etc
	Else If DeviceScale < 3.0 Then
		AboutIcon = AboutIcon.Resize(96, 96, True)
	'If the device scale is 3.0 (480dpi/xxhdpi) etc
	Else If DeviceScale < 4.0 Then
		AboutIcon = AboutIcon.Resize(144, 144, True)
	'If the device scale is 4.0 (640dpi/xxxhdpi) etc
	Else If DeviceScale >= 4.0 Then
		AboutIcon = AboutIcon.Resize(192, 192, True)
	End If
	
	'
	'Positive button is named 'Github Homepage'
	'Cancel button is named 'Dismiss'
	'
	Msgbox2Async($"${Application.LabelName}
Version ${Application.VersionName}

This App generates unblock codes for cryptographic PKI smartcards such as Yubikey & IDPrime, eToken"$&".", "About", "Github Homepage", "Dismiss", "", AboutIcon, True)
	
	Wait For Msgbox_Result (Result As Int)
	
	If Result = DialogResponse.POSITIVE Then
		NativeMain.RunMethod("openBrowserUrl", Array(APP_HOMEPAGE_URL))
	End If
	
End Sub

Private Sub btnHashMenu_Click
	btnHashMenuBg.Visible = True
	
	btnSha256.Visible = True
	btnSha512.Visible = True
	
	If SDK_INT < 14 Then
		
		'Fix the hard to read black text color of the Hash Text button when
		'running on legacy devices with the original Android 2.x-3.x theme,
		'and the dark shade background modal is on-top of it.
		'
		btnHashMenu.TextColor = Colors.Red
		
	End If
	
End Sub

Private Sub btnHashMenuBg_Click
	btnSha512.Visible = False
	btnSha256.Visible = False
	
	btnHashMenu.Checked = False
	btnHashMenuBg.Visible = False
	
	If SDK_INT < 14 Then
		
		'Restore the black text color which is specific for older devices:
		'It should be restored to black when the Hash Text menu disappears.
		'
		'It fixes the white-on-white text color of the Hash Text button when
		'running on legacy devices with the original Android 2.x-3.x theme.
		'
		btnHashMenu.TextColor = Colors.Black
		
	End If
	
End Sub

'
'I wanted to add additional tricks to counter shoulder-surfing/snooping:
'
'If you long-click the desired hash type it will lock the Admin Key field
'to password-mode after generating the hash
'

Private Sub btnSha256_LongClick
	btnHash_LongClickStub("SHA-256", 64)
End Sub
Private Sub btnSha512_LongClick
	btnHash_LongClickStub("SHA-512", 128)
End Sub

Private Sub btnSha256_Click
	btnHash_ClickStub("SHA-256", 64)
End Sub
Private Sub btnSha512_Click
	btnHash_ClickStub("SHA-512", 128)
End Sub

Private Sub btnHash_LongClickStub(HashType As String, Length As Int) As Void
	'
	'Hardening against potential force-enable UI control hacks.
	'
	LockAdminKeyOnPasswordMode
	
	'
	'Don't save the cursor position and selection when hashing text,
	'this is intentional and not a bug because the text is going to be
	'completely changed with an hash of it.
	'
	
	SetAdminKeyPasswordMode(True, False)
	
	btnHash_ClickStub(HashType, Length)
	
End Sub

Private Sub btnHash_ClickStub(HashType As String, Length As Int) As Void
	'
	'Visually bring attention to the Admin key field
	'
	inpAdminKey.RequestFocus
	
	Dim Hash As String = NativeMain.RunMethod("TextToHash", Array(inpAdminKey.Text, HashType))
	
	'Verify if the returned hash has a correct format
	'It must be 64 hexadecimal characters.
	'
	'If not then it contains an exception message to display.
	'
	If Regex.IsMatch2("^[0-9a-f]{"&Length&"}$", Regex.CASE_INSENSITIVE, Hash) == True Then
		
		inpAdminKey.Text = Hash '.ToUpperCase() part not needed anymore
		
	Else
		'Don't clear the Admin key text input unlike the Response Code one
		'because it would be a bit harsh to do that, rather just show the
		'exception text in a Toast message.
		'
		ToastMessageShow(Hash, False)
	End If
	
	'
	'Request running the garbage collector as soon as possible.
	'This way old values will be soon cleared from the App's RAM space.
	'
	NativeMain.RunMethod("overwriteTriggerGarbageCollector", Null)
	
	btnHashMenuBg_Click
	
End Sub

Private Sub btnScanRequest_Click
	'
	' Verify if the device has a Camera first before proceeding further
	' Android API level 9+ (Android 2.3+)
	'
	
	'Must use a separate JavaObject for the Shared class
	If NativeShared.RunMethod("GetNumberOfDeviceCameras", Null) < 1 Then
		'
		' In the rare case where it doesn't have a Camera I don't
		' disable the QR code scanning button, because I want
		' the user to be able to see that it's an available functionality
		' and to know why they can't use it, rather than seeing a disabled
		' QR code scanning button and thinking that it may be an App bug.
		'
		ToastMessageShow("Camera required to scan QR codes", False)
		Return
	End If
	
	'
	' Fix Camera crashing on Android 6.0+ (crashing when running in emulators)
	' Ask for authorization to use the Camera at runtime
	'
	Dim runtimePerms As RuntimePermissions
	
	If runtimePerms.Check(runtimePerms.PERMISSION_CAMERA) <> True Then
		
		runtimePerms.CheckAndRequest(runtimePerms.PERMISSION_CAMERA)
		Wait For Activity_PermissionResult(PermissionIdentifier As String, HavePermission As Boolean)
		
		If HavePermission <> True Then
			ToastMessageShow("Permission required to scan QR codes", False)
			Return
		End If
		
	End If
	
	'Run the QR scanning activity
	StartActivity(Scan)
	
End Sub

'
'Always keep both "inpAdminKey_TextChanged" and "inpAdminKey_FocusChanged".
'
'Don't remove "inpAdminKey_TextChanged" from the code because
'it's always needed when the user types text or when
'an Hash button is pressed.
'
'Then it's "inpAdminKey_TextChanged" that gets called.
'
Private Sub inpAdminKey_TextChanged(Old As String, New As String)
	
	'Keep the Admin Key length display updated on text change
	DisplayAdminKeyLength
	
End Sub

Private Sub inpAdminKey_FocusChanged(HasFocus As Boolean)
	
	If HasFocus Then
		WasAdminKeyFieldFocused = True
		AdminKeyTextSelectionTimer.Enabled = True
	Else
		WasAdminKeyFieldFocused = False
		AdminKeyTextSelectionTimer.Enabled = False
		
		'Because I added the ability to know the cursor position
		'for the Admin key field, I need to update the Admin key
		'label when the Admin key EditText loses focus.
		'
		'Do not remove this part.
		'
		DisplayAdminKeyLength
		
	End If
	
End Sub

'For showing the length of the text selection
'for the Admin key field when needed.
'
Private Sub AdminKeyTextSelectionTimer_Tick
	
	'Show the length of the text selection for Admin key field.
	'
	'The DisplayAdminKeyLength function now also does this
	'additionally to showing the length of the text itself.
	'
	DisplayAdminKeyLength
	
End Sub

Private Sub chkHideAdminKey_CheckedChange(Checked As Boolean)
	'
	'Add an additional check against UI controls force-enable hacks.
	'
	' It's impossible that "Checked" cans ever be "False"
	' if the "SavedHideAdminKeyStateBeforeConfigurationChange" is "False".
	'
	If Not(SavedHideAdminKeyStateBeforeConfigurationChange) And Checked == False Then
		'
		'The user should never be able to reach this code.
		'
		'If this code part is reached, then activate some defenses
		'and exit the App because it's probably a Forensic attack.
		'
		
		'False = short duration Toast.
		ToastMessageShow("What are you trying to do?", False)
		
		'
		'Emergency exit.
		'
		btnHashMenuBg_Click
		Activity_KeyPress(KeyCodes.KEYCODE_BACK)
		
		Return
		
	End If
	
	'
	' Backup the cursor position & text selection when toggling
	' PasswordMode visibility.
	'
	SaveAdminKeyCursorPosAndSel
	
	SetAdminKeyPasswordMode(Checked, True)
	
	'
	' Restore the cursor position & text selection when toggling
	' PasswordMode visibility.
	'
	RestoreAdminKeyCursorPosAndSel
	
End Sub

Private Sub btnGenerate_Click
	'
	'Unfocus the Admin key field when the user clicks the Generate button.
	'
	'This helps makes the Admin key cursor position Timer run less often,
	'especially useful since after generating the Response codes,
	'the user might take some while to read & copy it on their computer.
	'
	'And for all these few seconds the Timer would've continued to run.
	'
	inpResponse.RequestFocus
	
	'
	'Reset the Response Code label before generating a new Response Code
	'
	'We need to do it here too since it's possible that there are
	'invalid inputs and therefore we won't reach the
	'DetectResponseCodeAlgorithmType function to fix the label.
	'
	lblResponse.Text = "Response:"
	
	'
	'Reset the Response Code field before generating a new Response Code
	'
	inpResponse.Text = ""
	
	Dim challengeCodeInput, adminKeyInput As String
	challengeCodeInput = inpChallenge.Text
	adminKeyInput      = inpAdminKey.Text
	
	'
	'Sanitizing inputs
	'
	If challengeCodeInput == "" Or adminKeyInput == "" Then
		
		inpResponse.Hint = "Some input(s) are empty"
		Return
	End If
	
	Dim sanitizedUserInput() As String = GetSanitizedUserInput(challengeCodeInput, adminKeyInput)
	
	'If we got a False then we know it was incorrect input anyway.
	If sanitizedUserInput(0) == False Then
		
		inpResponse.Hint = "Invalid input(s) format"
		Return
	End If
	
	Dim sanitizedChallenge, sanitizedAdminKey As String
	sanitizedChallenge = sanitizedUserInput(1)
	sanitizedAdminKey  = sanitizedUserInput(2)
	
	' Verify the exact allowed Challenge Code lengths (16 and 32 Hex digits)
	'
	If	sanitizedChallenge.Length <> 16 And _	'DES-EDE2 or DES-EDE3 (2DES / 3DES)
		sanitizedChallenge.Length <> 32 And _	'AES-128
		sanitizedChallenge.Length <> 64 Then	'AES-256
		
		inpResponse.Hint = "Wrong Challenge length"
		Return
	End If
	
	' Verify the exact allowed Admin Key lengths (32 and 48 Hex digits)
	'
	If	sanitizedAdminKey.Length <> 32 And _	'DES-EDE2 or AES-128
		sanitizedAdminKey.Length <> 48 And _	'DES-EDE3
		sanitizedAdminKey.Length <> 64 Then		'AES-256
		
		inpResponse.Hint = "Wrong Admin Key length"
		Return
	End If
	
	'
	' Disallow challenge Code length mismatches with their Admin Keys
	'
	
	'AES-128
	If	sanitizedChallenge.Length == 32 And _		'AES-128 challenge
		sanitizedAdminKey.Length  <> 32 Then		'AES-128 Admin Key
		
		inpResponse.Hint = "Code needs AES-128 Key"
		Return
		
	'DES-EDE3 / DES-EDE2
	Else If	sanitizedChallenge.Length == 16 And _	'DES-EDE2 or DES-EDE3 challenge
			sanitizedAdminKey.Length  <> 32 And _	'DES-EDE2 Admin Key (2DES)
			sanitizedAdminKey.Length  <> 48 Then	'DES-EDE3 Admin Key (3DES)
		
		inpResponse.Hint = "Code needs 2/3DES Key"
		Return
		
	'AES-256
	Else If	sanitizedChallenge.Length == 64 And _	'AES-256 challenge
			sanitizedAdminKey.Length  <> 64 Then	'AES-256 Admin Key
		
		inpResponse.Hint = "Code needs AES-256 Key"
		Return
		
	End If
	
	'Generate the Response Code using native Java code
	'
	'If there was any exception while generating the code,
	'then it will contain the exception text instead of
	'a valid hex string.
	'
	Dim responseCode As String = NativeMain.RunMethod("GenerateResponseCode", Array(sanitizedChallenge, sanitizedAdminKey))
	
	'Verify if the returned Response Code has a correct format
	'It cans currently be 16 to 64 characters (for AES-256)
	'
	If Regex.IsMatch2("^[0-9a-f]{16,64}$", Regex.CASE_INSENSITIVE, responseCode) == True Then
		
		'
		'Add the ability to know which algorithm was detected
		'and used to generate the Response code by modifying
		'the 'Response:' label to contain the detected algorithm.
		'
		'True = Already checked the input to be in the correct format
		'
		DetectResponseCodeAlgorithmType(sanitizedAdminKey, sanitizedChallenge, responseCode)
		
		'
		'Cans be tweaked to have separators if needed (4x4)
		'
		Select responseCode.Length
			
			Case 16
				inpResponse.Text =	Regex.Replace2("^([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})$", _
										Regex.CASE_INSENSITIVE, responseCode, "$1 $2 $3 $4")
			Case 32
				inpResponse.Text =	Regex.Replace2("^([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})$", _
										Regex.CASE_INSENSITIVE, responseCode, "$1 $2 $3 $4 $5 $6 $7 $8")
			Case 64
				'First part of the AES-256 response code
				'I match from the beginning without the end ('$' character)
				'I also add a trailing space to separate the two response code parts
				responseCode =		Regex.Replace2("^([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})", _
										Regex.CASE_INSENSITIVE, responseCode, "$1 $2 $3 $4 $5 $6 $7 $8 ")
				'Second part of the AES-256 response code
				'Here for the second part I also match it from the end
				responseCode =		Regex.Replace2("([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})([a-f0-9]{4})$", _
										Regex.CASE_INSENSITIVE, responseCode, "$1 $2 $3 $4 $5 $6 $7 $8")
				
				'Finally set the response code once it has been correctly formatted
				inpResponse.Text =	responseCode
				
			Case Else
				inpResponse.Text =	responseCode
				
		End Select
		
	Else
		'Display error texts as Hint instead of Text
		'This Response Code field has already been set to "" at
		'the start of this function so no need to redo it again.
		'
		inpResponse.Hint = responseCode
		
	End If
	
	'
	'Request running the garbage collector as soon as possible.
	'This way old values will be soon cleared from the App's RAM space.
	'
	NativeMain.RunMethod("overwriteTriggerGarbageCollector", Null)
	
End Sub

Private Sub btnShareResponse_Click
	
	Dim shareIntent As Intent
	shareIntent.Initialize(shareIntent.ACTION_SEND, "")
	
	shareIntent.SetType("text/plain")
	shareIntent.PutExtra("android.intent.extra.TEXT", inpResponse.Text)
	
	shareIntent.WrapAsIntentChooser("Share The Response Code")
	StartActivity(shareIntent)
	
End Sub

